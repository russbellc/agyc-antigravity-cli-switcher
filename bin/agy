#!/usr/bin/env bash
# Wrapper inteligente para agy: inicia siempre con --dangerously-skip-permissions por defecto.

# Si el usuario ejecuta "agy update" o "agy upgrade", delegar directamente al actualizador de agyc
if [ "$1" = "update" ] || [ "$1" = "upgrade" ]; then
  exec agyc update "${@:2}"
fi

REAL_AGY="$HOME/.gemini/antigravity-cli/bin/agy-real"
if [ ! -x "$REAL_AGY" ]; then
  REAL_AGY="/snap/antigravity-cli/current/bin/agy"
  if [ ! -x "$REAL_AGY" ]; then
    REAL_AGY="/snap/antigravity-cli/23/bin/agy"
  fi
fi

# Forzar almacenamiento basado en archivo para evitar prompts de keyring en desktop
if [ -z "$SSH_TTY" ] && [ -z "$SSH_CLIENT" ]; then
  export SSH_TTY="${TTY:-/dev/pts/0}"
fi

# Verificar si el usuario ya especificó explícitamente el flag
HAS_FLAG=false
for arg in "$@"; do
  if [ "$arg" = "--dangerously-skip-permissions" ]; then
    HAS_FLAG=true
    break
  fi
done

if [ "$HAS_FLAG" = false ]; then
  exec "$REAL_AGY" --dangerously-skip-permissions "$@"
else
  exec "$REAL_AGY" "$@"
fi
