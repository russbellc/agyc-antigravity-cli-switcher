#!/usr/bin/env bash
# Wrapper inteligente para agy: inicia siempre con --dangerously-skip-permissions por defecto.

# Si el usuario ejecuta "agy update" o "agy upgrade", delegar directamente al actualizador de agyc
if [ "$1" = "update" ] || [ "$1" = "upgrade" ]; then
  exec agyc update "${@:2}"
fi

# Resolver REAL_HOME dinámicamente (inmune a perfiles aislados ~/.agyc_homes/<alias>)
REAL_HOME="${AGYC_REAL_HOME:-${REAL_HOME:-$HOME}}"
if [[ "$REAL_HOME" == *"/.agyc_homes/"* ]]; then
  REAL_HOME="${REAL_HOME%%/.agyc_homes/*}"
elif [[ "$REAL_HOME" == *"/.agyc_homes" ]]; then
  REAL_HOME="${REAL_HOME%/.agyc_homes}"
fi
if [ -z "$REAL_HOME" ] || [ ! -d "$REAL_HOME" ]; then
  PW_HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"
  PW_HOME="${PW_HOME%%/.agyc_homes/*}"
  if [ -n "$PW_HOME" ] && [ -d "$PW_HOME" ]; then
    REAL_HOME="$PW_HOME"
  fi
fi

# Buscar únicamente binarios nativos reales (jamás ~/.local/bin/agy para evitar recursión infinita)
REAL_AGY=""
for cand in \
  "$REAL_HOME/.gemini/antigravity-cli/bin/agy-real" \
  "$HOME/.gemini/antigravity-cli/bin/agy-real" \
  "/snap/antigravity-cli/current/bin/agy"; do
  if [ -x "$cand" ] && [ ! -d "$cand" ]; then
    REAL_AGY="$cand"
    break
  fi
done

if [ -z "$REAL_AGY" ]; then
  for snap_cand in /snap/antigravity-cli/*/bin/agy; do
    if [ -x "$snap_cand" ] && [ ! -d "$snap_cand" ]; then
      REAL_AGY="$snap_cand"
      break
    fi
  done
fi

if [ -z "$REAL_AGY" ]; then
  echo "Error: No se encontró el motor nativo de Google Antigravity ('agy-real')." >&2
  echo "Rutas verificadas:" >&2
  echo "  - $REAL_HOME/.gemini/antigravity-cli/bin/agy-real" >&2
  echo "  - /snap/antigravity-cli/current/bin/agy" >&2
  echo "Ejecuta 'agyc update' para descargar e instalar el binario oficial." >&2
  exit 1
fi

# Forzar almacenamiento basado en archivo solo para el proceso agy (evita prompts de keyring en desktop)
if [ -z "$SSH_TTY" ] && [ -z "$SSH_CLIENT" ]; then
  export SSH_TTY="${TTY:-/dev/pts/0}"
fi

# Verificar si el usuario ya especificó explícitamente el flag
HAS_FLAG=false
for arg in "$@"; do
  if [ "$arg" = "--dangerously-skip-permissions" ]; then
    HAS_FLAG=true
    break
  fi
done

if [ "$HAS_FLAG" = false ]; then
  exec "$REAL_AGY" --dangerously-skip-permissions "$@"
else
  exec "$REAL_AGY" "$@"
fi
