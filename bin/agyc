def normalize_alias(alias: str | None) -> str | None:
    if not alias:
        return None
    m = re.match(r"^(?:agy|agi)(\d+)$", alias.strip())
    if m:
        return f"agy{int(m.group(1)):02d}"
    return alias.strip()


def validate_alias(alias: str | None) -> str:
    """Valida el alias contra path traversal y nombres reservados."""
    norm = normalize_alias(alias)
    if (
        not norm
        or ".." in norm
        or "/" in norm
        or "\\" in norm
        or not ALIAS_REGEX.match(norm)
    ):
        raise ValueError(
            f"Alias inválido '{alias}': debe cumplir ^[a-zA-Z0-9_-]{{1,32}}$ (sin '..' ni '/')."
        )
    if norm.lower() in RESERVED_ALIASES:
        raise ValueError(
            f"El alias '{norm}' está reservado por el sistema. Usa otro nombre (ej. agy01, work)."
        )
    return norm


