        if sys.stdout is not None and sys.stdout.isatty():
            import ctypes as _ctypes
            _k32 = _ctypes.windll.kernel32
            _h = _k32.GetStdHandle(-11)
            _m = _ctypes.c_uint32(0)
            if _k32.GetConsoleMode(_h, _ctypes.byref(_m)):
                _k32.SetConsoleMode(_h, _m.value | 0x0004)
    except Exception:
        pass

# Expresión regular para quitar secuencias de escape ANSI
ANSI_REGEX = re.compile(r"\x1b\[[0-9;]*m")

# Validación estricta anti-traversal para alias de cuentas
ALIAS_REGEX = re.compile(r"^[a-zA-Z0-9_-]{1,32}$")
