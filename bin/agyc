)


def strip_ansi(s: str) -> str:
    return ANSI_REGEX.sub("", str(s))


def visible_len(s: str) -> int:
    return len(strip_ansi(s))


def pad_visible(s: str, width: int, align: str = "left") -> str:
    vlen = visible_len(s)
    pad = max(0, width - vlen)
    if align == "right":
        return (" " * pad) + s
    elif align == "center":
        l_pad = pad // 2
        r_pad = pad - l_pad
        return (" " * l_pad) + s + (" " * r_pad)
    else:
        return s + (" " * pad)


def _strip_agyc_homes(path: str) -> str:
    p = (path or "").strip()
    if "/.agyc_homes/" in p:
        p = p.split("/.agyc_homes/")[0]
    elif p.endswith("/.agyc_homes"):
        p = p[: -len("/.agyc_homes")]
    return p.rstrip("/") or "/"


def resolve_real_home() -> str:
    """Resuelve el HOME real del usuario dinámicamente, inmune a sesiones con HOME aislado en ~/.agyc_homes/."""
    for env_key in ("AGYC_REAL_HOME", "REAL_HOME"):
        val = os.environ.get(env_key, "").strip()
        if val:
            cleaned = _strip_agyc_homes(val)
            if cleaned and os.path.isdir(cleaned):
                return cleaned
    expanded = os.path.expanduser("~")
    if expanded and expanded != "~":
        cleaned_exp = _strip_agyc_homes(expanded)
        if cleaned_exp and os.path.isdir(cleaned_exp):
            return cleaned_exp
    try:
        pw_dir = _strip_agyc_homes(pwd.getpwuid(os.getuid()).pw_dir)
        if pw_dir and os.path.isdir(pw_dir):
            return pw_dir
    except Exception:
        pass
    return "/tmp"


REAL_HOME = resolve_real_home()
