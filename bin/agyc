    return os.path.join(get_base_dir(), "antigravity-oauth-token")


def get_config_path() -> str:
    return os.path.join(get_accounts_dir(), "config.json")


def _atomic_write_json(path: str, payload: dict, mode: int | None = None, indent: int | None = 2):
    parent = os.path.dirname(os.path.abspath(path))
    if parent and not os.path.exists(parent):
        _ensure_private_dir(parent, 0o700)
    tmp = f"{path}.tmp.{os.getpid()}.{threading.get_ident()}"
    try:
        if mode is not None:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(payload, f, indent=indent, ensure_ascii=False)
            if not platform.IS_WINDOWS:
                os.chmod(tmp, mode)
        else:
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(payload, f, indent=indent, ensure_ascii=False)
        if not platform.IS_WINDOWS:
            os.replace(tmp, path)
        else:
            for attempt in range(4):
                try:
                    os.replace(tmp, path)
                    break
                except PermissionError:
                    if attempt == 3:
                        raise
                    time.sleep(0.005)
    except Exception:
        try:
            if os.path.exists(tmp):
                os.remove(tmp)
        except Exception:
            pass
        raise


def load_config() -> dict:
    p = get_config_path()
    if os.path.exists(p):
        try:
            with open(p, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {"default_account": None, "active_account": None}


def save_config(cfg: dict):
    _atomic_write_json(get_config_path(), cfg, mode=0o600, indent=2)


def load_account(alias: str) -> dict | None:
    try:
        safe_alias = validate_alias(alias)
    except ValueError:
        return None
    p = os.path.join(get_accounts_dir(), f"{safe_alias}.json")
    if os.path.exists(p):
        try:
            with open(p, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return None


def _sync_isolated_token_if_present(alias: str, token_data: dict | None):
    if not alias or not isinstance(token_data, dict) or not token_data:
        return
    try:
        safe_alias = validate_alias(alias)
    except ValueError:
        return
    iso_gemini = os.path.join(resolve_real_home(), ".agyc_homes", safe_alias, ".gemini", "antigravity-cli")
    if not os.path.isdir(iso_gemini):
        return
    token_dst = os.path.join(iso_gemini, "antigravity-oauth-token")
    if os.path.islink(token_dst):
        try:
            os.unlink(token_dst)
        except Exception:
            pass
    try:
        _atomic_write_json(token_dst, token_data, mode=0o600, indent=2)
    except Exception:
        pass


def save_account(alias: str, data: dict, sync_links: bool = True):
    safe_alias = validate_alias(alias)
    data["alias"] = safe_alias
    data["updated_at"] = datetime.now(timezone.utc).isoformat()
    if "created_at" not in data:
        data["created_at"] = data["updated_at"]
    p = os.path.join(get_accounts_dir(), f"{safe_alias}.json")
    _atomic_write_json(p, data, mode=0o600, indent=2)
    _sync_isolated_token_if_present(safe_alias, data.get("token_data"))
    if sync_links:
        sync_account_symlinks()


def write_quota_cache(alias: str, quota_dict: dict):
    """Guarda de forma atómica (0600) la caché privada de cuotas en ~/.cache/agyc/quota_cache_{alias}.json."""
    if not alias or not isinstance(quota_dict, dict):
        return
    try:
        safe_alias = validate_alias(alias)
    except ValueError:
        return
    cache_file = os.path.join(get_cache_dir(), f"quota_cache_{safe_alias}.json")
    payload = dict(quota_dict)
    payload["cached_at"] = time.time()
    try:
        _atomic_write_json(cache_file, payload, mode=0o600, indent=None)
    except Exception:
        pass


def read_quota_cache(alias: str, max_age: float = 60.0) -> dict | None:
    try:
        safe_alias = validate_alias(alias)
    except ValueError:
        return None
    primary = os.path.join(get_cache_dir(), f"quota_cache_{safe_alias}.json")
    legacy = f"/tmp/agyc_quota_cache_{safe_alias}.json"
    cache_file = primary if os.path.exists(primary) else (
        legacy if (not platform.IS_WINDOWS and os.path.exists(legacy)) else None
    )
    if not cache_file:
        return None
    try:
        with open(cache_file, "r", encoding="utf-8") as cf:
            cached = json.load(cf)
        if isinstance(cached, dict) and (time.time() - float(cached.get("cached_at", 0)) < max_age):
            return cached
    except Exception:
        pass
    return None


def list_account_aliases() -> list[str]:
    d = get_accounts_dir()
    aliases = []
    for f in sorted(os.listdir(d)):
        if f.endswith(".json") and f != "config.json":
            stem = f[:-5]
            if ALIAS_REGEX.match(stem) and stem.lower() not in RESERVED_ALIASES:
                aliases.append(stem)
    return aliases


def get_next_correlative_alias() -> str:
    """Calcula automáticamente el siguiente alias según orden correlativo (agy01, agy02, ...)."""
    aliases = list_account_aliases()
    nums = []
    for a in aliases:
        m = re.match(r"^agy(\d+)$", a)
        if m:
            nums.append(int(m.group(1)))
    if not nums:
        return "agy01"
    next_num = max(nums) + 1
    return f"agy{next_num:02d}"


def _safe_unlink_link(path: str) -> None:
    """Elimina de forma segura un symlink, NTFS junction o archivo sin tocar el destino."""
    if platform.is_dir_link(path) or os.path.islink(path):
        try:
            os.unlink(path)
            return
        except OSError:
            pass
        if os.path.isdir(path):
            try:
                os.rmdir(path)
                return
            except OSError:
                pass
    if os.path.isfile(path):
        os.unlink(path)


def _safe_rmtree(path: str) -> None:
    """Elimina un árbol de directorios sin descender jamás en symlinks ni NTFS junctions."""
    if not os.path.lexists(path) and not platform.is_dir_link(path):
        return
    if platform.is_dir_link(path) or os.path.islink(path):
        _safe_unlink_link(path)
        return
    if not os.path.isdir(path):
        os.unlink(path)
        return
    with os.scandir(path) as it:
        for entry in it:
            ep = entry.path
            if entry.is_symlink() or platform.is_dir_link(ep):
                _safe_unlink_link(ep)
            elif entry.is_dir(follow_symlinks=False):
                _safe_rmtree(ep)
            else:
                os.unlink(ep)
    os.rmdir(path)


def _same_link_target(a: str, b: str) -> bool:
    if platform.IS_WINDOWS:
        return os.path.normcase(os.path.abspath(a)) == os.path.normcase(os.path.abspath(b))
    return os.path.abspath(a) == os.path.abspath(b)


def _ensure_dir_link(src: str, dst: str, replace_existing_dir: bool = False) -> bool:
    """Crea o verifica un symlink (Linux) o NTFS Junction (Windows) `dst` -> `src`."""
    if not os.path.isdir(src):
        return False
    if _same_link_target(src, dst):
        return True
    if platform.is_dir_link(dst) or os.path.islink(dst):
        try:
            if _same_link_target(platform.read_dir_link(dst), src) and os.path.exists(dst):
                return True
        except OSError:
            pass
        try:
            _safe_unlink_link(dst)
        except OSError:
            return False
    elif os.path.isdir(dst):
        try:
            is_empty = not os.listdir(dst)
        except OSError:
            is_empty = False
        if replace_existing_dir or is_empty:
            try:
                _safe_rmtree(dst)
            except OSError:
                return False
        else:
            return False
    elif os.path.isfile(dst):
        try:
            os.unlink(dst)
        except OSError:
            return False
    try:
        _ensure_private_dir(os.path.dirname(os.path.abspath(dst)), 0o700)
        platform.create_dir_link(src, dst)
        return True
    except OSError:
        return False


def _ensure_file_link(src: str, dst: str) -> bool:
    """Crea un enlace de archivo (symlink POSIX o NTFS hardlink/copia en Windows)."""
    if not os.path.isfile(src):
        return False
    try:
        if os.path.exists(dst) and os.path.samefile(src, dst):
            return True
    except OSError:
        pass
    if os.path.islink(dst):
        try:
            os.unlink(dst)
        except OSError:
            return False
    if os.path.exists(dst):
        return True
    try:
        _ensure_private_dir(os.path.dirname(os.path.abspath(dst)), 0o700)
        platform.create_file_link(src, dst)
        return True
    except OSError:
        return False


def _find_repo_dir(real_home: str) -> str:
    self_repo = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    candidates = [
        self_repo,
        os.path.join(real_home, "proyectos", "agyc-antigravity-cli-switcher"),
        os.path.join(real_home, "proyectos", "agyc"),
    ]
    if not platform.IS_WINDOWS:
        candidates.append("/home/aidev/proyectos/agyc-antigravity-cli-switcher")
    for cand in candidates:
        if cand and (os.path.isdir(os.path.join(cand, ".git")) or os.path.isdir(os.path.join(cand, "bin"))):
            return cand
    return os.path.join(real_home, "proyectos", "agyc-antigravity-cli-switcher")


def _use_real_localappdata(real_home: str) -> str | None:
    la = os.environ.get("LOCALAPPDATA", "").strip()
    if not la or platform._has_agyc_homes_segment(la):
        return None
    rh_norm = os.path.normcase(os.path.abspath(real_home)).rstrip("\\/")
    la_norm = os.path.normcase(os.path.abspath(la))
    if la_norm.startswith(rh_norm + os.sep) or la_norm == rh_norm:
        return la
    for env_k in ("AGYC_REAL_HOME", "REAL_HOME"):
        ev = os.environ.get(env_k, "").strip()
        if ev:
            ev_norm = os.path.normcase(os.path.abspath(_strip_agyc_homes(ev))).rstrip("\\/")
            if ev_norm != rh_norm:
                return None
    up = os.environ.get("USERPROFILE", "").strip()
    if up:
        up_norm = os.path.normcase(os.path.abspath(up)).rstrip("\\/")
        if rh_norm == up_norm:
            for env_k in ("AGYC_REAL_HOME", "REAL_HOME"):
                ev = os.environ.get(env_k, "").strip()
                if ev and os.path.normcase(os.path.abspath(_strip_agyc_homes(ev))).rstrip("\\/") != up_norm:
                    return None
            return la
    return None


def _windows_bin_dirs(real_home: str | None = None) -> list[str]:
    rh = real_home or resolve_real_home()
    dirs: list[str] = []
    la = _use_real_localappdata(rh)
    if la:
        dirs.append(os.path.join(la, "agyc", "bin"))
    gemini_bin = os.path.join(rh, ".gemini", "antigravity-cli", "bin")
    if os.path.normcase(os.path.abspath(gemini_bin)) not in {os.path.normcase(os.path.abspath(d)) for d in dirs}:
        dirs.append(gemini_bin)
    base_bin = os.path.join(get_base_dir(), "bin")
    if os.path.normcase(os.path.abspath(base_bin)) not in {os.path.normcase(os.path.abspath(d)) for d in dirs}:
        dirs.append(base_bin)
    return dirs


def _write_cmd_file(path: str, content: str, force: bool = False) -> bool:
    norm_content = content.replace("\r\n", "\n").replace("\n", "\r\n")
    if not force and os.path.isfile(path):
        try:
            with open(path, "r", encoding="utf-8", errors="ignore") as f:
                if f.read().replace("\r\n", "\n") == content.replace("\r\n", "\n"):
                    return False
        except OSError:
            pass
    try:
        os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
        with open(path, "w", encoding="utf-8", newline="") as f:
            f.write(norm_content)
        return True
    except OSError:
        return False


def _default_agy_cmd_content() -> str:
    return (
        "@echo off\n"
        "setlocal\n"
        "if /i \"%~1\"==\"update\" goto :do_update\n"
        "if /i \"%~1\"==\"upgrade\" goto :do_update\n"
        "set \"REAL_AGY=\"\n"
        "if defined AGYC_REAL_HOME if exist \"%AGYC_REAL_HOME%\\.gemini\\antigravity-cli\\bin\\agy-real.exe\" set \"REAL_AGY=%AGYC_REAL_HOME%\\.gemini\\antigravity-cli\\bin\\agy-real.exe\"\n"
        "if not defined REAL_AGY if exist \"%USERPROFILE%\\.gemini\\antigravity-cli\\bin\\agy-real.exe\" set \"REAL_AGY=%USERPROFILE%\\.gemini\\antigravity-cli\\bin\\agy-real.exe\"\n"
        "if not defined REAL_AGY if exist \"%LOCALAPPDATA%\\agyc\\bin\\agy-real.exe\" set \"REAL_AGY=%LOCALAPPDATA%\\agyc\\bin\\agy-real.exe\"\n"
        "if not defined REAL_AGY if exist \"%LOCALAPPDATA%\\agy\\bin\\agy-real.exe\" set \"REAL_AGY=%LOCALAPPDATA%\\agy\\bin\\agy-real.exe\"\n"
        "if not defined REAL_AGY if exist \"%LOCALAPPDATA%\\agy\\bin\\agy.exe\" set \"REAL_AGY=%LOCALAPPDATA%\\agy\\bin\\agy.exe\"\n"
        "if not defined REAL_AGY (\n"
        "  echo Error: No se encontro el motor nativo de Google Antigravity ^('agy-real.exe' / 'agy.exe'^). 1>&2\n"
        "  echo Ejecuta 'agyc update' para descargar e instalar el binario oficial. 1>&2\n"
        "  exit /b 1\n"
        ")\n"
        "set \"HAS_FLAG=0\"\n"
        ":chk_flag\n"
        "if \"%~1\"==\"\" goto :run_agy\n"
        "if \"%~1\"==\"--dangerously-skip-permissions\" set \"HAS_FLAG=1\"\n"
        "shift\n"
        "goto :chk_flag\n"
        ":run_agy\n"
        "if not defined SSH_TTY if not defined SSH_CLIENT set \"SSH_TTY=/dev/pts/0\"\n"
        "if \"%HAS_FLAG%\"==\"0\" (\n"
        "  \"%REAL_AGY%\" --dangerously-skip-permissions %*\n"
        ") else (\n"
        "  \"%REAL_AGY%\" %*\n"
        ")\n"
        "exit /b %ERRORLEVEL%\n"
        ":do_update\n"
        "shift\n"
        "set \"UPD_ARGS=\"\n"
        ":collect_upd\n"
        "if \"%~1\"==\"\" goto :run_upd\n"
        "set \"UPD_ARGS=%UPD_ARGS% %1\"\n"
        "shift\n"
        "goto :collect_upd\n"
        ":run_upd\n"
        "if exist \"%~dp0agyc.cmd\" (\n"
        "  call \"%~dp0agyc.cmd\" update%UPD_ARGS%\n"
        ") else (\n"
        "  python \"%~dp0agyc\" update%UPD_ARGS%\n"
        ")\n"
        "exit /b %ERRORLEVEL%\n"
    )


def _is_msix_windows_python(path: str) -> bool:
    return "\\windowsapps\\" in (path or "").replace("/", "\\").lower()


def _resolve_windows_python_exe() -> str:
    cur = sys.executable or ""
    if cur and os.path.isfile(cur) and not _is_msix_windows_python(cur):
        return cur
    real_home = resolve_real_home()
    appdata = os.environ.get("APPDATA", "").strip() or os.path.join(real_home, "AppData", "Roaming")
    localappdata = _use_real_localappdata(real_home)
    patterns = [
        os.path.join(real_home, ".local", "bin", "python3.*.exe"),
        os.path.join(real_home, ".local", "bin", "python.exe"),
        os.path.join(appdata, "uv", "python", "cpython-*", "python.exe"),
        os.path.join(localappdata, "Programs", "Python", "Python*", "python.exe"),
        r"C:\Python*\python.exe",
        r"C:\Program Files\Python*\python.exe",
    ]
    import glob

    for pat in patterns:
        for cand in sorted(glob.glob(pat), reverse=True):
            if os.path.isfile(cand) and not _is_msix_windows_python(cand):
                return cand
    return cur or "python"


def _py_cmd_wrapper(script_name: str, extra_flags: str = "", invoked_as: str | None = None) -> str:
    py_exe = _resolve_windows_python_exe()
    lines = [
        "@echo off",
        "setlocal",
        'set "PYTHONIOENCODING=utf-8"',
    ]
    if invoked_as:
        lines.append(f'set "AGYC_INVOKED_AS={invoked_as}"')
    lines.extend([
        f'set "AGYC_PY={py_exe}"',
        'if not exist "%AGYC_PY%" set "AGYC_PY=python"',
        f'set "AGYC_SCRIPT=%USERPROFILE%\\.gemini\\antigravity-cli\\bin\\{script_name}"',
        f'if not exist "%AGYC_SCRIPT%" set "AGYC_SCRIPT=%~dp0{script_name}"',
        f'"%AGYC_PY%" {extra_flags}"%AGYC_SCRIPT%" %*'.replace("  ", " "),
        "exit /b %ERRORLEVEL%",
    ])
    return "\n".join(lines) + "\n"


def _find_real_agy_binary(real_home: str) -> str | None:
    if platform.IS_WINDOWS:
        la = os.environ.get("LOCALAPPDATA", "").strip()
        cands = [
            os.path.join(real_home, ".gemini", "antigravity-cli", "bin", "agy-real.exe"),
            os.path.join(la, "agyc", "bin", "agy-real.exe") if la else "",
            os.path.join(la, "agy", "bin", "agy-real.exe") if la else "",
            os.path.join(la, "agy", "bin", "agy.exe") if la else "",
        ]
        for c in cands:
            if c and os.path.isfile(c):
                return c
        own_dirs = {os.path.normcase(os.path.abspath(d)) for d in _windows_bin_dirs(real_home)}
        for exe_name in ("agy-real.exe", "agy.exe"):
            found = shutil.which(exe_name)
            if found and os.path.isfile(found) and found.lower().endswith(".exe"):
                parent_norm = os.path.normcase(os.path.abspath(os.path.dirname(found)))
                if parent_norm not in own_dirs or exe_name == "agy-real.exe":
                    return found
        return None

    candidates = [
        os.path.join(real_home, ".gemini", "antigravity-cli", "bin", "agy-real"),
        "/snap/antigravity-cli/current/bin/agy",
        "/snap/antigravity-cli/23/bin/agy",
    ]
    for c in candidates:
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    for snap_c in sorted(glob.glob("/snap/antigravity-cli/*/bin/agy"), reverse=True):
        if os.path.isfile(snap_c) and os.access(snap_c, os.X_OK):
            return snap_c
    return None


def sync_launchers(force: bool = False):
    """Genera launchers: symlinks en Linux y wrappers `.cmd` en Windows (sin `.ps1`)."""
    if platform.IS_WINDOWS:
        real_home = resolve_real_home()
        repo_bin = os.path.join(_find_repo_dir(real_home), "bin")
        self_bin = os.path.dirname(os.path.realpath(__file__))
        aliases = list_account_aliases()
        all_to_wrap = set(aliases)
        for i in range(1, 16):
            all_to_wrap.add(f"agy{i:02d}")
            all_to_wrap.add(f"agi{i:02d}")

        agy_cmd_src = os.path.join(repo_bin, "agy.cmd")
        if os.path.isfile(agy_cmd_src):
            try:
                with open(agy_cmd_src, "r", encoding="utf-8", errors="ignore") as f:
                    agy_cmd_txt = f.read()
            except OSError:
                agy_cmd_txt = _default_agy_cmd_content()
        else:
            agy_cmd_txt = _default_agy_cmd_content()

        for bdir in _windows_bin_dirs(real_home):
            try:
                os.makedirs(bdir, exist_ok=True)
            except OSError:
                continue
            for py_script in ("agyc", "agyc-statusline", "agyc-topbar"):
                dst_s = os.path.join(bdir, py_script)
                if force or not os.path.isfile(dst_s):
                    src_s = os.path.join(repo_bin, py_script)
                    if not os.path.isfile(src_s):
                        src_s = os.path.join(self_bin, py_script)
                    if os.path.isfile(src_s) and not _same_link_target(src_s, dst_s):
                        try:
                            shutil.copy2(src_s, dst_s)
                        except OSError:
                            pass

            _write_cmd_file(os.path.join(bdir, "agyc.cmd"), _py_cmd_wrapper("agyc"), force=force)
            _write_cmd_file(os.path.join(bdir, "agy.cmd"), agy_cmd_txt, force=force)
            _write_cmd_file(
                os.path.join(bdir, "agi.cmd"),
                '@echo off\nsetlocal\ncall "%~dp0agy.cmd" %*\nexit /b %ERRORLEVEL%\n',
                force=force,
            )
            _write_cmd_file(
                os.path.join(bdir, "agyc-statusline.cmd"),
                _py_cmd_wrapper("agyc-statusline", extra_flags="-S "),
                force=force,
            )
            _write_cmd_file(
                os.path.join(bdir, "agyc-titleline.cmd"),
                _py_cmd_wrapper("agyc-statusline", extra_flags="-S ", invoked_as="agyc-titleline"),
                force=force,
            )
            _write_cmd_file(
                os.path.join(bdir, "agyc-topbar.cmd"),
                _py_cmd_wrapper("agyc-topbar", extra_flags="-S "),
                force=force,
            )
            for al in sorted(all_to_wrap):
                _write_cmd_file(
                    os.path.join(bdir, f"{al}.cmd"),
                    _py_cmd_wrapper("agyc", invoked_as=al),
                    force=force,
                )

        ensure_statusline_configured()
        return

    bin_dir = get_bin_dir()
    agyc_path = os.path.join(bin_dir, "agyc")
    if not os.path.exists(agyc_path):
        return

    aliases = list_account_aliases()
    all_to_link = set(aliases)
    for i in range(1, 16):
        all_to_link.add(f"agy{i:02d}")
        all_to_link.add(f"agi{i:02d}")

    for a in all_to_link:
        target = os.path.join(bin_dir, a)
        if not os.path.exists(target):
            try:
                os.symlink(agyc_path, target)
            except Exception:
                pass

    agi_bin = os.path.join(bin_dir, "agi")
    agy_bin = os.path.join(bin_dir, "agy")
    if os.path.exists(agy_bin) and not os.path.exists(agi_bin):
        try:
            os.symlink(agy_bin, agi_bin)
        except Exception:
            pass

    ensure_statusline_configured()


def sync_account_symlinks(force: bool = False):
    """Sincroniza lanzadores (symlinks en Linux, wrappers `.cmd` en Windows) y hooks statusLine/title."""
    sync_launchers(force=force)


def ensure_statusline_configured():
    """Garantiza que agyc-statusline y agyc-titleline estén configurados y activos en settings.json."""
    real_home = resolve_real_home()
    bin_dir = get_bin_dir()
    script_bin_dir = os.path.dirname(os.path.abspath(__file__))
    statusline_bin = os.path.join(bin_dir, "agyc-statusline")
    if not os.path.exists(statusline_bin):
        cands = [
            os.path.join(script_bin_dir, "agyc-statusline"),
            os.path.join(real_home, "proyectos", "agyc-antigravity-cli-switcher", "bin", "agyc-statusline"),
        ]
        if platform.IS_WINDOWS:
            la = os.environ.get("LOCALAPPDATA", "").strip()
            if la:
                cands.append(os.path.join(la, "agyc", "bin", "agyc-statusline"))
        else:
            cands.extend([
                os.path.join(real_home, "snap", "antigravity-cli", "common", ".gemini", "antigravity-cli", "bin", "agyc-statusline"),
                os.path.join(real_home, ".local", "bin", "agyc-statusline"),
            ])
        for cand in cands:
            if os.path.exists(cand):
                try:
                    shutil.copy2(cand, statusline_bin)
                    if not platform.IS_WINDOWS:
                        os.chmod(statusline_bin, 0o755)
                    break
                except Exception:
                    pass

    if not platform.IS_WINDOWS:
        titleline_bin = os.path.join(bin_dir, "agyc-titleline")
        if os.path.exists(statusline_bin) and not os.path.exists(titleline_bin):
            try:
                if os.path.lexists(titleline_bin):
                    os.unlink(titleline_bin)
                os.symlink(statusline_bin, titleline_bin)
            except Exception:
                pass

    base_paths = [
        get_base_dir(),
        os.path.join(real_home, ".gemini", "antigravity-cli"),
    ]
    homes_base = os.path.join(real_home, ".agyc_homes")
    if os.path.exists(homes_base):
        if not platform.IS_WINDOWS:
            try:
                os.chmod(homes_base, 0o700)
            except Exception:
                pass
        try:
            for h in os.listdir(homes_base):
                iso_dir = os.path.join(homes_base, h)
                if not platform.IS_WINDOWS and os.path.isdir(iso_dir) and not os.path.islink(iso_dir):
                    try:
                        os.chmod(iso_dir, 0o700)
                    except Exception:
                        pass
                cand = os.path.join(iso_dir, ".gemini", "antigravity-cli")
                if os.path.exists(cand):
                    base_paths.append(cand)
        except Exception:
            pass

    sl_cmd = "agyc-statusline.cmd" if platform.IS_WINDOWS else "agyc-statusline"
    tl_cmd = "agyc-titleline.cmd" if platform.IS_WINDOWS else "agyc-titleline"
    desired_sl = {"type": "command", "command": sl_cmd, "enabled": True}
    desired_tl = {"type": "command", "command": tl_cmd, "enabled": True}
    valid_sl = ("agyc-statusline.cmd", "agyc-statusline") if platform.IS_WINDOWS else ("agyc-statusline",)
    valid_tl = ("agyc-titleline.cmd", "agyc-titleline") if platform.IS_WINDOWS else ("agyc-titleline",)

    seen_real_files = set()
    for bp in base_paths:
        sp = os.path.join(bp, "settings.json")
        if not os.path.exists(sp):
            continue
        real_sp = os.path.realpath(sp)
        if real_sp in seen_real_files:
            continue
        seen_real_files.add(real_sp)
        try:
            with open(real_sp, "r", encoding="utf-8") as f:
                s = json.load(f)
            if not isinstance(s, dict):
                continue
            cur_sl = s.get("statusLine", {})
            cur_tl = s.get("title", {})
            changed = False
            if (not isinstance(cur_sl, dict)) or (cur_sl.get("command") not in valid_sl) or not cur_sl.get("enabled") or cur_sl.get("type") != "command":
                s["statusLine"] = desired_sl
                changed = True
            if (not isinstance(cur_tl, dict)) or (cur_tl.get("command") not in valid_tl) or not cur_tl.get("enabled") or cur_tl.get("type") != "command":
                s["title"] = desired_tl
                changed = True
            if changed:
                _atomic_write_json(real_sp, s, mode=0o600, indent=2)
            elif not platform.IS_WINDOWS:
                try:
                    os.chmod(real_sp, 0o600)
                except Exception:
                    pass
        except Exception:
            pass


def parse_iso_datetime(dt_str: str) -> datetime:
    clean = dt_str.strip().replace("Z", "+00:00")
    if "." in clean:
        parts = clean.split(".")
        subparts = parts[1].split("+")
        if len(subparts) == 2:
            micros = subparts[0][:6].ljust(6, "0")
            clean = f"{parts[0]}.{micros}+{subparts[1]}"
        else:
            subparts = parts[1].split("-")
            if len(subparts) == 2:
                micros = subparts[0][:6].ljust(6, "0")
                clean = f"{parts[0]}.{micros}-{subparts[1]}"
    dt = datetime.fromisoformat(clean)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt


def normalize_window(frac: float | None, reset_str: str | None) -> tuple[float | None, str | None]:
    """
    Normaliza una ventana de cuota (5H o Semanal):
      - Si reset_str ya venció (delta <= 0), la cuota ya se recargó -> frac = 1.0, reset_str = None.
      - Si frac >= 0.9995, limpia reset_str = None (evita mostrar now+5h / now+7d sintético al 100%).
    """
    if reset_str:
        try:
            reset_dt = parse_iso_datetime(reset_str)
            delta = (reset_dt - datetime.now(timezone.utc)).total_seconds()
            if delta <= 0:
                frac = 1.0
                reset_str = None
        except Exception:
            reset_str = None

    if frac is not None:
        frac = max(0.0, min(1.0, float(frac)))
        if frac >= 0.9995:
            frac = 1.0
            reset_str = None

    return frac, reset_str


def pct_display(frac: float | None) -> int | None:
    """Porcentaje entero sin redondear al alza a 100% cuando ya hubo consumo (math.floor)."""
    if frac is None:
        return None
    f = max(0.0, min(1.0, float(frac)))
    if f >= 0.9995:
        return 100
    if f <= 0.0:
        return 0
    return int(math.floor(f * 100))


def format_countdown(reset_str: str | None) -> str:
    if not reset_str:
        return "N/A"
    try:
        reset_dt = parse_iso_datetime(reset_str)
        now_dt = datetime.now(timezone.utc)
        delta = (reset_dt - now_dt).total_seconds()
        if delta <= 0:
            return "Disponible"
        days = int(delta // 86400)
        hours = int((delta % 86400) // 3600)
        minutes = int((delta % 3600) // 60)
        if days > 0:
            return f"{days}d {hours}h"
        return f"{hours}h {minutes:02d}m"
    except Exception:
        return "N/A"


def format_window_status(frac: float | None, reset_str: str | None, mode: str = "list") -> str:
    """Formatea el estado textual de una ventana normalizada para cmd_list o cmd_quota."""
    frac, reset_str = normalize_window(frac, reset_str)
    if frac is None:
        return f"{C_DIM}N/A{C_RESET}"
    if frac >= 0.9995:
        if mode == "quota":
            return f"{C_DIM}Quota available{C_RESET}"
        return f"{C_DIM}Disponible{C_RESET}"
    if reset_str:
        cd = format_countdown(reset_str)
        if cd not in ("N/A", "Disponible"):
            if mode == "quota":
                return f"(Reinicio: {cd})"
            return f"({cd})"
    if frac <= 0.001:
        if mode == "quota":
            return f"{C_RED}(Quota exhausted){C_RESET}"
        return f"{C_RED}(Agotada){C_RESET}"
    return f"{C_DIM}(Activa){C_RESET}"


def make_linebar(fraction: float | None, length: int = 8) -> str:
    if fraction is None:
        return f"{C_DIM}[{'-' * length}]  N/A{C_RESET}"
    pct = max(0.0, min(1.0, float(fraction)))
    filled = int(round(pct * length))
    empty = length - filled
    pct_int = pct_display(pct)
    if pct >= 0.5:
        color = C_GREEN
    elif pct >= 0.2:
        color = C_YELLOW
    else:
        color = C_RED
    bar = "█" * filled + "░" * empty
    return f"{color}[{bar}] {pct_int:3d}%{C_RESET}"


def format_plan_badge(plan_type: str | None) -> str:
    pt = (plan_type or "FREE").upper()
    if pt == "ULTRA":
        return f"{C_BOLD}{C_MAGENTA}ULTRA{C_RESET}"
    if pt == "PRO":
        return f"{C_BOLD}{C_CYAN}PRO{C_RESET}"
    if pt == "ENT":
        return f"{C_BOLD}{C_BLUE}ENT{C_RESET}"
    return f"{C_DIM}FREE{C_RESET}"


def decode_jwt_payload(jwt_token: str) -> dict:
    try:
        parts = jwt_token.split(".")
        if len(parts) >= 2:
            payload = parts[1]
            payload += "=" * (-len(payload) % 4)
            return json.loads(base64.urlsafe_b64decode(payload).decode("utf-8"))
    except Exception:
        pass
    return {}


class TokenRevokedError(Exception):
    """Excepción lanzada cuando el token fue revocado o expiró (invalid_grant)."""
    pass


def _token_needs_refresh(token_data: dict | None, margin_seconds: int = 300) -> bool:
    if not isinstance(token_data, dict):
        return True
    token_obj = token_data.get("token", {})
    if not isinstance(token_obj, dict):
        return True
    expiry_str = token_obj.get("expiry")
    if not token_obj.get("access_token") or not expiry_str:
        return True
    try:
        exp_dt = parse_iso_datetime(expiry_str)
        return (exp_dt - datetime.now(timezone.utc)).total_seconds() < margin_seconds
    except Exception:
        return True


def _perform_oauth_refresh_request(token_data: dict) -> tuple[dict, bool]:
    token_obj = dict(token_data.get("token") or {})
    refresh_token = token_obj.get("refresh_token")
    if not refresh_token:
        return token_data, False

    payload = urllib.parse.urlencode({
        "client_id": GOOGLE_CLIENT_ID,
        "client_secret": GOOGLE_CLIENT_SECRET,
        "grant_type": "refresh_token",
        "refresh_token": refresh_token,
    }).encode("utf-8")

    req = urllib.request.Request(
        "https://oauth2.googleapis.com/token",
        data=payload,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    try:
        with urllib.request.urlopen(req, timeout=12) as resp:
            res = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        err_body = ""
        try:
            err_body = e.read().decode("utf-8", errors="replace")
        except Exception:
            pass
        if e.code in (400, 401) and "invalid_grant" in err_body:
            raise TokenRevokedError("Token revocado o expirado por Google (invalid_grant)")
        raise e

    new_td = dict(token_data)
    token_obj["access_token"] = res["access_token"]
    if "refresh_token" in res:
        token_obj["refresh_token"] = res["refresh_token"]
    expires_in = res.get("expires_in", 3600)
    token_obj["expiry"] = (datetime.now(timezone.utc) + timedelta(seconds=expires_in)).isoformat()
    if "id_token" in res:
        new_td["id_token"] = res["id_token"]

    new_td["token"] = token_obj
    return new_td, True


def refresh_token_if_needed(
    token_data: dict,
    force: bool = False,
    alias: str | None = None,
) -> tuple[dict, bool]:
    """
    Renueva el token OAuth solo cuando expira en <300s (o force=True).
    Cuando se indica alias, protege la operación con `platform.acquire_file_lock` sobre
    `<locks_dir>/{alias}.oauth.lock`, relee accounts/{alias}.json
    (double-checked locking) y sincroniza antigravity-oauth-token aislado antes de soltar el lock.
    """
    if not force and not _token_needs_refresh(token_data, margin_seconds=300):
        return token_data, False

    if not alias:
        return _perform_oauth_refresh_request(token_data)

    safe_alias = validate_alias(alias)
    lock_path = os.path.join(get_locks_dir(), f"{safe_alias}.oauth.lock")
    with platform.acquire_file_lock(lock_path, blocking=True):
        # Double-checked locking: releer accounts/{alias}.json por si otro panel ya renovó el token
        disk_acc = load_account(safe_alias)
        working_td = token_data
        if isinstance(disk_acc, dict) and isinstance(disk_acc.get("token_data"), dict) and disk_acc["token_data"]:
            working_td = disk_acc["token_data"]
            if not force and not _token_needs_refresh(working_td, margin_seconds=300):
                _sync_isolated_token_if_present(safe_alias, working_td)
                return working_td, False
            # Si dos procesos piden force=True simultáneamente y uno acaba de renovar (<30s), reutilizar
            if force and not _token_needs_refresh(working_td, margin_seconds=3570):
                _sync_isolated_token_if_present(safe_alias, working_td)
                return working_td, False

        try:
            new_td, did_refresh = _perform_oauth_refresh_request(working_td)
        except TokenRevokedError:
            latest_acc = load_account(safe_alias) or disk_acc
            if isinstance(latest_acc, dict):
                latest_acc["is_revoked"] = True
                save_account(safe_alias, latest_acc, sync_links=False)
            raise

        if did_refresh:
            latest_acc = load_account(safe_alias) or disk_acc
            if isinstance(latest_acc, dict):
                latest_acc["token_data"] = new_td
                latest_acc["is_revoked"] = False
                save_account(safe_alias, latest_acc, sync_links=False)
            else:
                _sync_isolated_token_if_present(safe_alias, new_td)
            return new_td, True

        return working_td, False


def _post_cloudcode_json(url: str, body: dict, access_token: str, timeout: int = 5) -> dict | None:
    req = urllib.request.Request(
        url,
        data=json.dumps(body).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {access_token}",
            "Content-Type": "application/json",
            "User-Agent": ANTIGRAVITY_UA,
        },
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))


def _classify_group_family(group_display: str, bucket_id: str = "") -> str:
    gl = (group_display or "").lower()
    bl = (bucket_id or "").lower()
    if any(k in gl for k in ("claude", "gpt", "3p")) or any(k in bl for k in ("3p", "claude", "gpt")):
        return "claude"
    if any(k in gl for k in ("gemini", "argon")) or any(k in bl for k in ("gemini", "argon")):
        return "gemini"
    return gl or bl or "other"


def _classify_bucket_window(bucket: dict) -> str:
    win = (bucket.get("window") or "").lower()
    bid = (bucket.get("bucketId") or "").lower()
    bname = (bucket.get("displayName") or "").lower()
    if "5h" in win or "5h" in bid or "five hour" in bname:
        return "5h"
    if "weekly" in win or "weekly" in bid or "weekly" in bname or "month" in bid:
        return "weekly"
    return win or bid or bname or "unknown"


def _extract_raw_bucket_fraction(bucket: dict) -> float | None:
    if bucket.get("disabled"):
        return 0.0
    if "remainingFraction" in bucket and bucket["remainingFraction"] is not None:
        return float(bucket["remainingFraction"])
    # En Proto3 JSON, remainingFraction == 0.0 puede omitirse mientras resetTime está presente
    if bucket.get("resetTime"):
        return 0.0
    return None


def fetch_quota_summary(access_token: str) -> dict | None:
    """
    Consulta Tiers y Cuotas oficiales de Antigravity 1.5.10 en CloudCode PA:
      a) loadCodeAssist -> paidTier / currentTier -> plan_type (ULTRA/PRO/ENT/FREE), supports_carbon, project_id.
      b) retrieveUserQuotaSummary en daily y prod -> fusión por (family, window) con min(remainingFraction).
      c) retrieveUserQuota en daily y prod -> fusión por modelId con min(remainingFraction).
    """
    if not access_token:
        return None

    # a) loadCodeAssist para detectar plan Pro / Ultra y cloudaicompanionProject
    #    Si cloudcode-pa no devuelve paidTier, consulta también daily-cloudcode-pa para nunca degradar PRO/ULTRA a FREE.
    lca_res: dict = {}
    lca_ok = False
    lca_payload = {
        "metadata": {
            "ideType": "ANTIGRAVITY",
            "platform": "WINDOWS_AMD64" if platform.IS_WINDOWS else "LINUX_AMD64",
            "pluginType": "GEMINI",
        }
    }

    def _lca_tier_rank(resp_obj: dict) -> int:
        t_obj = resp_obj.get("paidTier") or resp_obj.get("currentTier") or {}
        if not isinstance(t_obj, dict):
            return 0
        tid = (t_obj.get("id") or "").lower()
        tnm = (t_obj.get("name") or "").lower()
        if "ultra" in tid or "ultra" in tnm:
            return 3
        if "pro" in tid or "pro" in tnm:
            return 2
        if "enterprise" in tid or "standard" in tid:
            return 1
        return 0

    for host in ("cloudcode-pa.googleapis.com", "daily-cloudcode-pa.googleapis.com"):
        try:
            res = _post_cloudcode_json(
                f"https://{host}/v1internal:loadCodeAssist",
                lca_payload,
                access_token,
                timeout=5,
            )
            if isinstance(res, dict):
                lca_ok = True
                if not lca_res:
                    lca_res = dict(res)
                else:
                    if (res.get("paidTier") and not lca_res.get("paidTier")) or (
                        _lca_tier_rank(res) > _lca_tier_rank(lca_res)
                    ):
                        merged_lca = dict(res)
                        if not merged_lca.get("cloudaicompanionProject") and lca_res.get("cloudaicompanionProject"):
                            merged_lca["cloudaicompanionProject"] = lca_res["cloudaicompanionProject"]
                        lca_res = merged_lca
                    elif not lca_res.get("cloudaicompanionProject") and res.get("cloudaicompanionProject"):
                        lca_res["cloudaicompanionProject"] = res["cloudaicompanionProject"]

                if lca_res.get("paidTier"):
                    break
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                break
        except Exception:
            continue

    tier_obj = lca_res.get("paidTier") or lca_res.get("currentTier") or {}
    if not isinstance(tier_obj, dict):
        tier_obj = {}
    tier_id = (tier_obj.get("id") or "free-tier").lower()
    tier_name = tier_obj.get("name") or "Antigravity"
    tier_name_low = tier_name.lower()

    if "ultra" in tier_id or "ultra" in tier_name_low:
        plan_type = "ULTRA"
    elif "pro" in tier_id or "pro" in tier_name_low:
        plan_type = "PRO"
    elif "enterprise" in tier_id or "standard" in tier_id:
        plan_type = "ENT"
    else:
        plan_type = "FREE"

    supports_carbon = (plan_type == "ULTRA")
    raw_proj = lca_res.get("cloudaicompanionProject")
    if isinstance(raw_proj, dict):
        project_id = raw_proj.get("id")
    elif isinstance(raw_proj, str) and raw_proj.strip():
        project_id = raw_proj.strip()
    else:
        project_id = None

    quota_body = {"project": project_id} if project_id else {}

    # b) & c) Consultar en paralelo retrieveUserQuotaSummary y retrieveUserQuota en daily y prod
    tasks = {
        "sum_daily": "https://daily-cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary",
        "sum_prod": "https://cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary",
        "mod_daily": "https://daily-cloudcode-pa.googleapis.com/v1internal:retrieveUserQuota",
        "mod_prod": "https://cloudcode-pa.googleapis.com/v1internal:retrieveUserQuota",
    }
    raw_results: dict[str, dict | None] = {}

    def _run_call(item: tuple[str, str]) -> tuple[str, dict | None]:
        key, url = item
        try:
            return key, _post_cloudcode_json(url, quota_body, access_token, timeout=5)
        except Exception:
            return key, None

    with ThreadPoolExecutor(max_workers=4) as pool:
        for k, val in pool.map(_run_call, tasks.items()):
            raw_results[k] = val

    # Fusionar retrieveUserQuotaSummary de daily y prod por (family, window) con min(remainingFraction)
    fused_buckets: dict[tuple[str, str], dict] = {}
    group_meta: dict[str, dict] = {}
    top_description = ""

    for src_key in ("sum_daily", "sum_prod"):
        s_data = raw_results.get(src_key)
        if not isinstance(s_data, dict):
            continue
        if s_data.get("description") and not top_description:
            top_description = s_data["description"]
        for grp in s_data.get("groups", []):
            g_disp = grp.get("displayName", "")
            g_desc = grp.get("description", "")
            fam = _classify_group_family(g_disp)
            if fam not in group_meta:
                group_meta[fam] = {
                    "displayName": "Gemini Models" if fam == "gemini" else (g_disp or "Claude and GPT models"),
                    "description": g_desc if g_desc.lower().startswith("models within this group") else "",
                }
            elif g_desc and g_desc.lower().startswith("models within this group"):
                cur_d = group_meta[fam].get("description", "")
                if not cur_d or ("carbon" in g_desc.lower() and "carbon" not in cur_d.lower()) or (
                    "gemini 4" in g_desc.lower() and "gemini 4" not in cur_d.lower()
                ) or len(g_desc) > len(cur_d):
                    group_meta[fam]["description"] = g_desc

            for b in grp.get("buckets", []):
                b_fam = _classify_group_family(g_disp, b.get("bucketId", ""))
                win = _classify_bucket_window(b)
                raw_frac = _extract_raw_bucket_fraction(b)
                norm_frac, norm_rst = normalize_window(raw_frac, b.get("resetTime"))
                cand = {
                    "bucketId": b.get("bucketId", f"{b_fam}-{win}"),
                    "displayName": b.get("displayName", ""),
                    "window": win,
                    "remainingFraction": norm_frac,
                    "resetTime": norm_rst,
                    "description": b.get("description", "") if (norm_frac is not None and norm_frac < 0.9995) else "",
                    "disabled": bool(b.get("disabled", False)) and (norm_frac is None or norm_frac <= 0.001),
                }
                key = (b_fam, win)
                if key not in fused_buckets:
                    fused_buckets[key] = cand
                else:
                    prev = fused_buckets[key]
                    p_frac = prev.get("remainingFraction")
                    c_frac = cand.get("remainingFraction")
                    if c_frac is not None and (p_frac is None or c_frac < p_frac):
                        cand["disabled"] = bool(prev.get("disabled") or cand.get("disabled"))
                        fused_buckets[key] = cand
                    elif c_frac is not None and p_frac is not None and abs(c_frac - p_frac) < 1e-9:
                        if not prev.get("resetTime") and cand.get("resetTime"):
                            prev["resetTime"] = cand["resetTime"]
                        if not prev.get("description") and cand.get("description"):
                            prev["description"] = cand["description"]
                        prev["disabled"] = bool(prev.get("disabled") or cand.get("disabled"))

    fused_groups = []
    for fam in ("gemini", "claude"):
        fam_buckets = []
        for win in ("5h", "weekly"):
            if (fam, win) in fused_buckets:
                fam_buckets.append(fused_buckets[(fam, win)])
        for (bfam, bwin), bval in fused_buckets.items():
            if bfam == fam and bwin not in ("5h", "weekly"):
                fam_buckets.append(bval)
        if fam_buckets:
            meta = group_meta.get(fam, {})
            default_name = "Gemini Models" if fam == "gemini" else "Claude and GPT models"
            fused_groups.append({
                "displayName": meta.get("displayName") or default_name,
                "description": meta.get("description", ""),
                "buckets": fam_buckets,
            })

    # Fusionar retrieveUserQuota de daily y prod por modelId con min(remainingFraction)
    fused_models: dict[str, dict] = {}
    for src_key in ("mod_daily", "mod_prod"):
        m_data = raw_results.get(src_key)
        if not isinstance(m_data, dict):
            continue
        for mb in m_data.get("buckets", []):
            mid = mb.get("modelId")
            if not mid:
                continue
            raw_frac = _extract_raw_bucket_fraction(mb)
            raw_rst = mb.get("resetTime")
            # Conservar resetTime original cuando frac==1.0 solo para clasificar horizonte 5h vs weekly,
            # pero si ya expiró (delta <= 0) sí se recarga a 1.0 sin reset vencido.
            norm_rst = raw_rst
            norm_frac = raw_frac
            if raw_rst:
                try:
                    if (parse_iso_datetime(raw_rst) - datetime.now(timezone.utc)).total_seconds() <= 0:
                        norm_frac = 1.0
                        norm_rst = None
                except Exception:
                    norm_rst = None
            if norm_frac is not None:
                norm_frac = max(0.0, min(1.0, float(norm_frac)))

            cand_m = dict(mb)
            cand_m["remainingFraction"] = norm_frac
            cand_m["resetTime"] = norm_rst

            if mid not in fused_models:
                fused_models[mid] = cand_m
            else:
                prev_m = fused_models[mid]
                pf = prev_m.get("remainingFraction")
                cf = cand_m.get("remainingFraction")
                if cf is not None and (pf is None or cf < pf):
                    fused_models[mid] = cand_m
                elif cf is not None and pf is not None and abs(cf - pf) < 1e-9:
                    if not prev_m.get("resetTime") and cand_m.get("resetTime"):
                        prev_m["resetTime"] = cand_m["resetTime"]

    if not fused_groups and not fused_models and not lca_ok:
        return None

    return {
        "groups": fused_groups,
        "description": top_description,
        "_models_quota": {"buckets": list(fused_models.values())},
        "_tier": {
            "plan_type": plan_type,
            "tier_id": tier_id,
            "tier_name": tier_name,
            "supports_carbon": supports_carbon,
            "project_id": project_id,
            "tier_fetched": lca_ok,
        },
    }


def _apply_min_window(
    cur_frac: float | None,
    cur_rst: str | None,
    cand_frac: float | None,
    cand_rst: str | None,
) -> tuple[float | None, str | None]:
    cand_frac, cand_rst = normalize_window(cand_frac, cand_rst)
    if cand_frac is None:
        return cur_frac, cur_rst
    if cur_frac is None or cand_frac < cur_frac:
        return cand_frac, cand_rst
    if abs(cand_frac - cur_frac) < 1e-9 and not cur_rst and cand_rst:
        return cur_frac, cand_rst
    return cur_frac, cur_rst


def extract_quota_metrics(quota_json: dict | None, models_json: dict | None = None) -> dict:
    """
    Extrae métricas unificadas en los 2 grupos oficiales (Gemini y Claude & GPT) + metadatos de plan:
      - Grupo Gemini: gemini_5h_fraction, gemini_5h_reset, gemini_weekly_fraction, gemini_weekly_reset, gemini_disabled
      - Grupo Claude & GPT: claude_5h_fraction, claude_5h_reset, claude_weekly_fraction, claude_weekly_reset, claude_disabled
      - Plan: plan_type, tier_id, tier_name, supports_carbon, fetched_at
    """
    tier = (quota_json.get("_tier") if isinstance(quota_json, dict) else None) or {}
    plan_type = tier.get("plan_type") or "FREE"
    tier_id = tier.get("tier_id") or "free-tier"
    tier_name = tier.get("tier_name") or "Antigravity"
    supports_carbon = bool(tier.get("supports_carbon", plan_type == "ULTRA"))

    metrics = {
        "gemini_5h_fraction": None,
        "gemini_5h_reset": None,
        "gemini_weekly_fraction": None,
        "gemini_weekly_reset": None,
        "gemini_disabled": False,
        "claude_5h_fraction": None,
        "claude_5h_reset": None,
        "claude_weekly_fraction": None,
        "claude_weekly_reset": None,
        "claude_disabled": False,
        "plan_type": plan_type,
        "tier_id": tier_id,
        "tier_name": tier_name,
        "supports_carbon": supports_carbon,
        "fetched_at": datetime.now(timezone.utc).isoformat(),
    }
    if not isinstance(quota_json, dict):
        return metrics

    if not models_json:
        models_json = quota_json.get("_models_quota")

    # 1. Procesar buckets de retrieveUserQuotaSummary (ya fusionados entre daily y prod)
    for grp in quota_json.get("groups", []):
        g_disp = grp.get("displayName", "")
        for b in grp.get("buckets", []):
            fam = _classify_group_family(g_disp, b.get("bucketId", ""))
            if fam not in ("gemini", "claude"):
                continue
            win = _classify_bucket_window(b)
            if win not in ("5h", "weekly"):
                continue
            raw_frac = _extract_raw_bucket_fraction(b)
            frac, rst = normalize_window(raw_frac, b.get("resetTime"))
            dis = bool(b.get("disabled", False)) and (frac is None or frac <= 0.001)

            fk = f"{fam}_{win}_fraction"
            rk = f"{fam}_{win}_reset"
            metrics[fk], metrics[rk] = _apply_min_window(metrics[fk], metrics[rk], frac, rst)
            if dis or (win == "weekly" and frac is not None and frac <= 0.001):
                metrics[f"{fam}_disabled"] = True

    # 2. Cruzar con retrieveUserQuota por modelId separando estrictamente horizonte 5h vs weekly
    now_dt = datetime.now(timezone.utc)
    if isinstance(models_json, dict) and "buckets" in models_json:
        for b in models_json.get("buckets", []):
            mid = (b.get("modelId") or "").lower()
            if not mid:
                continue
            if mid.startswith("gemini-") or mid.startswith("orchestrator"):
                fam = "gemini"
            elif mid.startswith("claude-") or mid.startswith("gpt-"):
                fam = "claude"
            else:
                continue

            raw_frac = _extract_raw_bucket_fraction(b)
            raw_rst = b.get("resetTime")
            if raw_frac is None:
                continue

            # Clasificar horizonte temporal ANTES de que normalize_window limpie resetTime sintético al 100%
            horizon = "5h"
            if raw_rst:
                try:
                    r_dt = parse_iso_datetime(raw_rst)
                    delta_sec = (r_dt - now_dt).total_seconds()
                    if 0 < delta_sec <= (5 * 3600 + 300):
                        horizon = "5h"
                    elif delta_sec > (5 * 3600 + 300):
                        horizon = "weekly"
                except Exception:
                    horizon = "5h"

            frac, rst = normalize_window(raw_frac, raw_rst)
            fk = f"{fam}_{horizon}_fraction"
            rk = f"{fam}_{horizon}_reset"
            metrics[fk], metrics[rk] = _apply_min_window(metrics[fk], metrics[rk], frac, rst)
            if horizon == "weekly" and frac is not None and frac <= 0.001:
                metrics[f"{fam}_disabled"] = True

    # 3. Normalización final y reglas de consistencia por familia
    for fam in ("gemini", "claude"):
        f5, r5 = normalize_window(metrics[f"{fam}_5h_fraction"], metrics[f"{fam}_5h_reset"])
        fw, rw = normalize_window(metrics[f"{fam}_weekly_fraction"], metrics[f"{fam}_weekly_reset"])
        dis = bool(metrics[f"{fam}_disabled"])

        if fw is None and not dis:
            fw, rw = 1.0, None
        if f5 is None and not dis:
            f5, r5 = 1.0, None

        if (fw is not None and fw <= 0.001) or (dis and (fw is None or fw <= 0.001)):
            dis = True
            f5 = 0.0
        else:
            dis = False

        metrics[f"{fam}_5h_fraction"] = f5
        metrics[f"{fam}_5h_reset"] = r5
        metrics[f"{fam}_weekly_fraction"] = fw
        metrics[f"{fam}_weekly_reset"] = rw
        metrics[f"{fam}_disabled"] = dis

    return metrics


def _merge_tier_fallback_if_unfetched(new_q: dict, old_q: dict | None, q_raw: dict | None) -> dict:
    """Solo si loadCodeAssist falló por red, conserva el plan previamente conocido sin tocar cuotas/resets."""
    tier_fetched = bool(((q_raw or {}).get("_tier") or {}).get("tier_fetched"))
    if not tier_fetched and isinstance(old_q, dict) and old_q.get("plan_type"):
        new_q["plan_type"] = old_q["plan_type"]
        new_q["tier_id"] = old_q.get("tier_id", new_q.get("tier_id"))
        new_q["tier_name"] = old_q.get("tier_name", new_q.get("tier_name"))
        new_q["supports_carbon"] = bool(old_q.get("supports_carbon", new_q["plan_type"] == "ULTRA"))
    return new_q


def _sanitize_cached_or_stored_quota(q: dict, fallback_plan_source: dict | None = None) -> dict:
    """Limpia y normaliza cualquier estructura de cuota leída de caché o disco (elimina resets vencidos)."""
    out = dict(q or {})
    if not out.get("plan_type") and isinstance(fallback_plan_source, dict) and fallback_plan_source.get("plan_type"):
        out["plan_type"] = fallback_plan_source.get("plan_type")
        out["tier_id"] = fallback_plan_source.get("tier_id", "free-tier")
        out["tier_name"] = fallback_plan_source.get("tier_name", "Antigravity")
        out["supports_carbon"] = bool(fallback_plan_source.get("supports_carbon", out["plan_type"] == "ULTRA"))

    for fam in ("gemini", "claude"):
        f5, r5 = normalize_window(out.get(f"{fam}_5h_fraction"), out.get(f"{fam}_5h_reset"))
        fw, rw = normalize_window(out.get(f"{fam}_weekly_fraction"), out.get(f"{fam}_weekly_reset"))
        dis = bool(out.get(f"{fam}_disabled", False))
        if fw is None and not dis:
            fw, rw = 1.0, None
        if f5 is None and not dis:
            f5, r5 = 1.0, None
        if (fw is not None and fw <= 0.001) or (dis and (fw is None or fw <= 0.001)):
            dis = True
            f5 = 0.0
        else:
            dis = False
        out[f"{fam}_5h_fraction"] = f5
        out[f"{fam}_5h_reset"] = r5
        out[f"{fam}_weekly_fraction"] = fw
        out[f"{fam}_weekly_reset"] = rw
        out[f"{fam}_disabled"] = dis

    # Limpiar llaves obsoletas de v1.4 si existían
    out.pop("argon_weekly_fraction", None)
    out.pop("argon_weekly_reset", None)
    out.pop("has_gemini4", None)
    return out


def fetch_user_profile(access_token: str) -> dict:
    try:
        req = urllib.request.Request(
            "https://www.googleapis.com/oauth2/v2/userinfo",
            headers={"Authorization": f"Bearer {access_token}"},
        )
        with urllib.request.urlopen(req, timeout=8) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception:
        return {}


def ensure_auto_migration():
    aliases = list_account_aliases()
    if aliases:
        return
    token_path = get_active_token_path()
    if not os.path.exists(token_path):
        return
    try:
        with open(token_path, "r", encoding="utf-8") as f:
            token_data = json.load(f)

        token_data, _ = refresh_token_if_needed(token_data)
        access_token = token_data.get("token", {}).get("access_token")
        profile = fetch_user_profile(access_token) if access_token else {}
        email = profile.get("email")
        if not email and "id_token" in token_data:
            claims = decode_jwt_payload(token_data["id_token"])
            email = claims.get("email")

        quota = extract_quota_metrics(fetch_quota_summary(access_token)) if access_token else {}

        acc_data = {
            "alias": "agy01",
            "email": email or "desconocido@google.com",
            "name": profile.get("name") or "Usuario Antigravity",
            "picture": profile.get("picture"),
            "token_data": token_data,
            "quota": quota,
        }
        save_account("agy01", acc_data)
        if quota:
            write_quota_cache("agy01", quota)
        cfg = load_config()
        cfg["active_account"] = "agy01"
        cfg["default_account"] = "agy01"
        save_config(cfg)
    except Exception:
        pass


def switch_active_account(alias: str, silent: bool = False) -> dict:
    """Cambia la sesión activa global de agy al alias indicado, renueva el token y sincroniza caché."""
    alias = validate_alias(alias)
    data = load_account(alias)
    if not data:
        raise ValueError(f"La cuenta '{alias}' no existe.")

    token_data = data.get("token_data", {})
    try:
        token_data, refreshed = refresh_token_if_needed(token_data, alias=alias)
        data["token_data"] = token_data
        if refreshed:
            data["is_revoked"] = False
            save_account(alias, data)
    except TokenRevokedError as e:
        data["is_revoked"] = True
        save_account(alias, data)
        raise e
    except Exception as e:
        if not silent:
            print(f"{C_YELLOW}Aviso al renovar token:{C_RESET} {e}")

    active_path = get_active_token_path()
    _atomic_write_json(active_path, token_data, mode=0o600, indent=2)

    real_home = resolve_real_home()
    for sec_dir in [
        os.path.join(real_home, ".gemini", "antigravity-cli"),
        os.path.join(real_home, "snap", "antigravity-cli", "common", ".gemini", "antigravity-cli"),
    ]:
        sec_path = os.path.join(sec_dir, "antigravity-oauth-token")
        if os.path.abspath(sec_path) != os.path.abspath(active_path) and os.path.exists(sec_dir):
            try:
                _atomic_write_json(sec_path, token_data, mode=0o600, indent=2)
            except Exception:
                pass

    cfg = load_config()
    cfg["active_account"] = alias
    save_config(cfg)

    access_token = token_data.get("token", {}).get("access_token")
    if access_token:
        try:
            q_raw = fetch_quota_summary(access_token)
            if q_raw:
                old_q = data.get("quota", {})
                new_q = _merge_tier_fallback_if_unfetched(extract_quota_metrics(q_raw), old_q, q_raw)
                data["quota"] = new_q
                data.pop("has_gemini4", None)
                save_account(alias, data)
                write_quota_cache(alias, new_q)
        except Exception:
            pass

    return data


def launch_real_agy(extra_args: list[str], alias: str | None = None):
    """Ejecuta el binario oficial de agy con --dangerously-skip-permissions por defecto."""
    real_home = resolve_real_home()
    real_agy = _find_real_agy_binary(real_home)

    if not real_agy:
        if platform.IS_WINDOWS:
            hint_path = os.path.join(os.environ.get("LOCALAPPDATA", ""), "agy", "bin", "agy.exe")
        else:
            hint_path = os.path.join(real_home, ".gemini", "antigravity-cli", "bin", "agy-real")
        print(
            f"{C_RED}Error:{C_RESET} No se encontró el binario nativo 'agy-real' en {hint_path}.",
            file=sys.stderr,
        )
        print(f"Ejecuta {C_CYAN}agyc update{C_RESET} para descargar e instalar el motor oficial.", file=sys.stderr)
        sys.exit(1)

    env = os.environ.copy()
    env["AGYC_REAL_HOME"] = real_home
    isolated_home: str | None = None
    if alias:
        isolated_home = prepare_isolated_home(alias)
        env["HOME"] = isolated_home
        if platform.IS_WINDOWS:
            env["USERPROFILE"] = isolated_home
            env["AGYC_ACCOUNT"] = alias

    cmd_args = [real_agy]
    if "--dangerously-skip-permissions" not in extra_args:
        cmd_args.append("--dangerously-skip-permissions")
    cmd_args.extend(extra_args)

    if not env.get("SSH_TTY") and not env.get("SSH_CLIENT"):
        env["SSH_TTY"] = "/dev/pts/0"

    if platform.IS_WINDOWS:
        run_dir = platform.get_run_dir(real_home)
        pid_file: str | None = None
        proc = subprocess.Popen(cmd_args, env=env)
        try:
            pid_file = os.path.join(run_dir, f"{proc.pid}.json")
            _atomic_write_json(
                pid_file,
                {
                    "pid": proc.pid,
                    "alias": alias or "",
                    "home": isolated_home or real_home,
                    "herdr_pane_id": env.get("HERDR_PANE_ID") or "",
                    "started_at": time.time(),
                },
                mode=0o600,
                indent=None,
            )
        except Exception:
            pass
        rc = 1
        try:
            while True:
                try:
                    rc = proc.wait()
                    break
                except KeyboardInterrupt:
                    if proc.poll() is not None:
                        rc = proc.returncode if proc.returncode is not None else 130
                        break
        finally:
            if pid_file and os.path.exists(pid_file):
                try:
                    os.unlink(pid_file)
                except OSError:
                    pass
        sys.exit(rc)

    os.execve(real_agy, cmd_args, env)


def prepare_isolated_home(alias: str) -> str:
    """
    Crea y prepara el HOME aislado para el alias dado en ~/.agyc_homes/<alias>/.
    - Enlaza dotfiles/directorios esenciales (junctions NTFS en Windows, symlinks en Linux).
    - Escribe directamente acc["token_data"] de forma atómica en isolated_gemini/antigravity-oauth-token.
    - Enlaza carpetas compartidas (`accounts`, `conversations`, `brain`, `projects`, `annotations`,
      `skills`, `builtin`, `mcp`, `bin`, `lib`) y archivos (`history.jsonl`, etc.).
    """
    alias = validate_alias(alias)
    real_home = resolve_real_home()
    homes_base = _ensure_private_dir(os.path.join(real_home, ".agyc_homes"), 0o700)
    isolated_home = _ensure_private_dir(os.path.join(homes_base, alias), 0o700)
    isolated_gemini = _ensure_private_dir(os.path.join(isolated_home, ".gemini", "antigravity-cli"), 0o700)

    shared_base = get_base_dir()

    # ── Enlazar dotfiles/carpetas esenciales del usuario ──
    for rel_file in (".gitconfig", ".git-credentials"):
        _ensure_file_link(os.path.join(real_home, rel_file), os.path.join(isolated_home, rel_file))

    for rel_dir in (".ssh", ".npm", os.path.join(".config", "gh"), os.path.join(".config", "herdr")):
        _ensure_dir_link(os.path.join(real_home, rel_dir), os.path.join(isolated_home, rel_dir))

    if platform.IS_WINDOWS:
        # Enlazar %APPDATA%\herdr si existe hacia <isolated_home>\AppData\Roaming\herdr
        real_appdata = os.environ.get("APPDATA", "").strip()
        if real_appdata and not platform._has_agyc_homes_segment(real_appdata):
            src_herdr = os.path.join(real_appdata, "herdr")
        else:
            src_herdr = os.path.join(real_home, "AppData", "Roaming", "herdr")
        if os.path.isdir(src_herdr):
            dst_herdr = os.path.join(isolated_home, "AppData", "Roaming", "herdr")
            _ensure_dir_link(src_herdr, dst_herdr)

    # ── Enlazar .gemini/config para compartir servidores MCP globales ──
    user_gemini_config = os.path.join(real_home, ".gemini", "config")
    iso_gemini_config = os.path.join(isolated_home, ".gemini", "config")
    if os.path.isdir(user_gemini_config):
        _ensure_dir_link(user_gemini_config, iso_gemini_config)
    elif os.path.isfile(user_gemini_config):
        _ensure_file_link(user_gemini_config, iso_gemini_config)

    # ── Token aislado: escribir acc["token_data"] del alias de forma atómica (0600) ──
    acc = load_account(alias)
    token_dst = os.path.join(isolated_gemini, "antigravity-oauth-token")
    if acc and isinstance(acc.get("token_data"), dict) and acc["token_data"]:
        if os.path.islink(token_dst):
            try:
                os.unlink(token_dst)
            except Exception:
                pass
        try:
            _atomic_write_json(token_dst, acc["token_data"], mode=0o600, indent=2)
        except Exception:
            pass

    # ── Enlazar bin y lib compartidos ──
    # Nota: en perfil aislado sólo copiamos/enlazamos bin si tiene contenido propio, evitando
    # que `sync_launchers` cree binarios/wrappers antes de tiempo.
    user_gemini_bin = os.path.join(shared_base, "bin")
    if not os.path.exists(user_gemini_bin):
        user_gemini_bin = os.path.join(real_home, ".gemini", "antigravity-cli", "bin")
    iso_gemini_bin = os.path.join(isolated_gemini, "bin")
    if os.path.isdir(user_gemini_bin):
        _ensure_dir_link(user_gemini_bin, iso_gemini_bin, replace_existing_dir=True)

    user_gemini_lib = os.path.join(shared_base, "lib")
    if not os.path.exists(user_gemini_lib):
        user_gemini_lib = os.path.join(real_home, ".gemini", "antigravity-cli", "lib")
    iso_gemini_lib = os.path.join(isolated_gemini, "lib")
    if os.path.isdir(user_gemini_lib):
        _ensure_dir_link(user_gemini_lib, iso_gemini_lib, replace_existing_dir=True)

    # ── settings.json por perfil (0600): preserva el modelo elegido en cada cuenta (PRO vs ULTRA) ──
    iso_settings = os.path.join(isolated_gemini, "settings.json")
    shared_settings = os.path.join(shared_base, "settings.json")
    try:
        base_s = {}
        if os.path.isfile(iso_settings) and not os.path.islink(iso_settings):
            with open(iso_settings, "r", encoding="utf-8") as f:
                base_s = json.load(f)
        elif os.path.exists(shared_settings):
            with open(shared_settings, "r", encoding="utf-8") as f:
                base_s = json.load(f)
        if not isinstance(base_s, dict):
            base_s = {}
        if os.path.islink(iso_settings):
            os.unlink(iso_settings)
        # Si la cuenta es explícitamente PRO/FREE y heredó un modelo Carbon exclusivo de ULTRA, ajustar fallback seguro
        p_type = (acc.get("plan_type") or (acc.get("quota") or {}).get("plan_type") or "").upper() if acc else ""
        cur_mod = str(base_s.get("model") or "")
        if p_type in ("PRO", "FREE") and "carbon" in cur_mod.lower():
            base_s["model"] = "Gemini 4 Argon (High)"
        sl_cmd = "agyc-statusline.cmd" if platform.IS_WINDOWS else "agyc-statusline"
        tl_cmd = "agyc-titleline.cmd" if platform.IS_WINDOWS else "agyc-titleline"
        base_s["statusLine"] = {"type": "command", "command": sl_cmd, "enabled": True}
        base_s["title"] = {"type": "command", "command": tl_cmd, "enabled": True}
        _atomic_write_json(iso_settings, base_s, mode=0o600, indent=2)
    except Exception:
        pass

    # Garantizar que shared_base/mcp exista para que el enlace siempre apunte a un directorio válido
    os.makedirs(os.path.join(shared_base, "mcp"), exist_ok=True)

    # ── Recursos compartidos para unificar conversaciones, memoria, skills, builtin y mcp ──
    shared_dirs = (
        "accounts",
        "projects",
        "brain",
        "conversations",
        "annotations",
        "skills",
        "builtin",
        "mcp",
    )
    force_link_dirs = {"builtin", "mcp"}
    shared_files = (
        "conversation_summaries.db",
        "conversation_summaries.db-wal",
        "conversation_summaries.db-shm",
        "history.jsonl",
        "installation_id",
        "jetbox_summaries_proto.pb",
        "jetski_state.pbtxt",
    )

    if not _same_link_target(isolated_gemini, shared_base):
        for item in shared_dirs:
            _ensure_dir_link(
                os.path.join(shared_base, item),
                os.path.join(isolated_gemini, item),
                replace_existing_dir=(item in force_link_dirs),
            )
        for item in shared_files:
            _ensure_file_link(
                os.path.join(shared_base, item),
                os.path.join(isolated_gemini, item),
            )

    return isolated_home


def _load_or_refresh_account_for_list(alias: str, force_refresh: bool) -> dict | None:
    data = load_account(alias)
    if not data:
        return None

    old_q = data.get("quota", {}) if isinstance(data.get("quota"), dict) else {}

    # Usar caché viva < 60s si no se pidió -r y ya contiene plan_type conocido
    if not force_refresh and not data.get("is_revoked"):
        cached = read_quota_cache(alias, max_age=60.0)
        if cached is not None:
            known_plan = cached.get("plan_type") or old_q.get("plan_type")
            if known_plan:
                data["quota"] = _sanitize_cached_or_stored_quota(cached, fallback_plan_source=old_q)
                return data

    token_data = data.get("token_data", {})
    try:
        token_data, refreshed = refresh_token_if_needed(token_data, force=force_refresh, alias=alias)
        data["token_data"] = token_data
        data["is_revoked"] = False
        access_token = token_data.get("token", {}).get("access_token")
        if access_token:
            q_raw = fetch_quota_summary(access_token)
            if q_raw:
                new_q = _merge_tier_fallback_if_unfetched(extract_quota_metrics(q_raw), old_q, q_raw)
                data["quota"] = new_q
                data.pop("has_gemini4", None)
                save_account(alias, data, sync_links=False)
                write_quota_cache(alias, new_q)
            else:
                data["quota"] = _sanitize_cached_or_stored_quota(old_q)
                if refreshed:
                    save_account(alias, data, sync_links=False)
        elif refreshed:
            save_account(alias, data, sync_links=False)
    except TokenRevokedError:
        data["is_revoked"] = True
        save_account(alias, data, sync_links=False)
    except Exception:
        data["quota"] = _sanitize_cached_or_stored_quota(old_q)

    return data


def _extract_agy_alias_fast(text: str | None) -> str | None:
    if not text:
        return None
    m = re.search(r"(?<![a-zA-Z0-9_])(?:agy|agi)(\d{1,3})(?![a-zA-Z0-9_])", text, re.IGNORECASE)
    if m:
        return f"agy{int(m.group(1)):02d}"
    return None


def _query_herdr_panes_fast(real_home: str, timeout: float = 0.06) -> tuple[list[dict], float | None, str]:
    sock_path = platform.default_herdr_socket_path(real_home)
    t0 = time.monotonic()
    resp = platform.query_herdr_ipc(
        sock_path,
        {"id": "1", "method": "pane.list", "params": {}},
        timeout=timeout,
    )
    if not isinstance(resp, dict):
        return [], None, sock_path
    panes = (resp.get("result") or {}).get("panes") or []
    elapsed_ms = (time.monotonic() - t0) * 1000.0
    return (panes if isinstance(panes, list) else []), elapsed_ms, sock_path


def _short_pane_label(pane_id: str) -> str:
    pid_str = str(pane_id or "").strip()
    if ":" in pid_str:
        return pid_str.split(":")[-1]
    return pid_str


def _builtin_scan_active_herdr_panes(real_home: str | None = None) -> dict[str, list[dict]]:
    """
    Delega el escaneo de procesos vivos a `platform.scan_agy_processes()` y cruza con `pane.list` de Herdr
    para mapear alias -> [{'pane_id': 'w3:p2', 'short_pane': 'p2', 'pid': ...}, ...].
    """
    rh = _strip_agyc_homes(real_home) if real_home else resolve_real_home()

    default_active = None
    cfg_cands = [os.path.join(rh, ".gemini", "antigravity-cli", "accounts", "config.json")]
    if not platform.IS_WINDOWS:
        cfg_cands.append(
            os.path.join(rh, "snap", "antigravity-cli", "common", ".gemini", "antigravity-cli", "accounts", "config.json")
        )
    for cp in cfg_cands:
        if os.path.exists(cp):
            try:
                with open(cp, "r", encoding="utf-8") as f:
                    act = json.load(f).get("active_account")
                    if act:
                        default_active = normalize_alias(str(act))
                        break
            except Exception:
                pass

    herdr_panes, h_lat_ms, _ = _query_herdr_panes_fast(rh, timeout=0.06)
    herdr_online = h_lat_ms is not None
    live_pane_map: dict[str, dict] = {}
    for hp in herdr_panes:
        if isinstance(hp, dict) and hp.get("pane_id"):
            live_pane_map[str(hp["pane_id"])] = hp

    run_dir = platform.get_run_dir(rh) if platform.IS_WINDOWS else None
    procs = platform.scan_agy_processes(run_dir=run_dir)
    pane_best_proc: dict[str, tuple[tuple[int, int, int, int], str | None, int]] = {}
    for proc in procs:
        pane_id = str(proc.get("herdr_pane_id") or "").strip()
        if not pane_id:
            continue
        if herdr_online and pane_id not in live_pane_map:
            continue
        raw_alias = proc.get("alias")
        alias_env = normalize_alias(str(raw_alias)) if isinstance(raw_alias, str) and raw_alias.strip() else None
        pid = int(proc.get("pid") or 0)
        is_running = 1 if proc.get("is_running", True) else 0
        has_alias = 1 if alias_env else 0
        is_real = 1 if "agy-real" in str(proc.get("exe_name") or "").lower() else 0
        rank = (is_running, has_alias, is_real, pid)
        prev = pane_best_proc.get(pane_id)
        if prev is None or rank > prev[0]:
            pane_best_proc[pane_id] = (rank, alias_env, pid)

    result: dict[str, list[dict]] = {}
    for pane_id, (_, alias_env, pid) in pane_best_proc.items():
        hp = live_pane_map.get(pane_id, {})
        resolved_alias = alias_env
        if not resolved_alias and hp:
            for k in ("display_agent", "terminal_title_stripped", "terminal_title", "label"):
                v = hp.get(k)
                if isinstance(v, str) and v:
                    cand = _extract_agy_alias_fast(v)
                    if cand:
                        resolved_alias = cand
                        break
        if not resolved_alias:
            resolved_alias = default_active
        if not resolved_alias:
            continue

        entry = {
            "pane_id": pane_id,
            "short_pane": _short_pane_label(pane_id),
            "pid": pid,
            "tab_id": hp.get("tab_id"),
            "label": hp.get("label"),
            "focused": bool(hp.get("focused", False)),
        }
        result.setdefault(resolved_alias, []).append(entry)

    def _pane_sort_key(p: dict) -> tuple[int, int, str]:
        sp = str(p.get("short_pane") or "")
        m = re.match(r"^p(\d+)$", sp)
        return (0 if p.get("focused") else 1, int(m.group(1)) if m else 999999, sp)

    for al in result:
        result[al].sort(key=_pane_sort_key)

    return result


def _normalize_panes_map(raw_map: dict | None) -> dict[str, list[dict]]:
    if not isinstance(raw_map, dict):
        return {}
    out: dict[str, list[dict]] = {}
    for raw_alias, plist in raw_map.items():
        al = normalize_alias(str(raw_alias)) or str(raw_alias)
        if not isinstance(plist, list):
            continue
        norm_list: list[dict] = []
        for item in plist:
            if isinstance(item, str) and item.strip():
                pid_s = item.strip()
                norm_list.append({"pane_id": pid_s, "short_pane": _short_pane_label(pid_s)})
            elif isinstance(item, dict):
                pid_s = str(item.get("pane_id") or item.get("id") or item.get("short_pane") or "").strip()
                if not pid_s:
                    continue
                sp = str(item.get("short_pane") or item.get("short_id") or _short_pane_label(pid_s)).strip()
                copied = dict(item)
                copied["pane_id"] = pid_s
                copied["short_pane"] = sp
                norm_list.append(copied)
        if norm_list:
            out[al] = norm_list
    return out


def scan_active_herdr_panes(real_home: str | None = None) -> dict[str, list[dict]]:
    rh = real_home or resolve_real_home()
    core_fn = getattr(_agyc_core, "scan_active_herdr_panes", None) if _agyc_core else None
    if callable(core_fn):
        try:
            sig = inspect.signature(core_fn)
            params = list(sig.parameters.values())
            if not params:
                raw = core_fn()
            else:
                raw = core_fn(rh)
            return _normalize_panes_map(raw)
        except Exception:
            pass
    return _builtin_scan_active_herdr_panes(rh)


def _builtin_sanitize_account_for_json(
    acc: dict,
    active: str | None = None,
    default: str | None = None,
    active_panes: list[str] | None = None,
) -> dict:
    al = acc.get("alias", "")
    q_norm = _sanitize_cached_or_stored_quota(acc.get("quota", {}))
    clean_quota = {k: q_norm[k] for k in SAFE_QUOTA_KEYS if k in q_norm}
    plan_type = clean_quota.get("plan_type") or acc.get("plan_type") or "FREE"
    tier_id = clean_quota.get("tier_id") or acc.get("tier_id") or "free-tier"
    tier_name = clean_quota.get("tier_name") or acc.get("tier_name") or "Antigravity"
    supports_carbon = bool(
        clean_quota.get("supports_carbon", acc.get("supports_carbon", plan_type == "ULTRA"))
    )
    return {
        "alias": al,
        "email": acc.get("email", ""),
        "name": acc.get("name", ""),
        "plan_type": plan_type,
        "tier_id": tier_id,
        "tier_name": tier_name,
        "supports_carbon": supports_carbon,
        "is_active": bool(al == active),
        "is_default": bool(al == default),
        "is_revoked": bool(acc.get("is_revoked", False)),
        "locked": bool(acc.get("locked", False)),
        "lock_reason": acc.get("lock_reason") or "",
        "note": acc.get("note") or "",
        "active_panes": list(active_panes or []),
        "quota": clean_quota,
        "updated_at": acc.get("updated_at"),
    }


def sanitize_account_for_json(
    acc: dict,
    active: str | None = None,
    default: str | None = None,
    active_panes: list[str] | None = None,
) -> dict:
    base_safe = _builtin_sanitize_account_for_json(
        acc,
        active=active,
        default=default,
        active_panes=active_panes,
    )
    core_fn = getattr(_agyc_core, "sanitize_account_for_json", None) if _agyc_core else None
    if callable(core_fn):
        try:
            acc_prepared = dict(acc)
            acc_prepared["quota"] = base_safe["quota"]
            al_str = str(acc.get("alias") or "")
            res = core_fn(
                al_str,
                acc_prepared,
                active_account=active,
                default_account=default,
                active_panes=list(active_panes or []),
            )
            if isinstance(res, dict):
                merged = dict(base_safe)
                merged.update(res)
                merged["active_panes"] = list(active_panes or [])
                merged["note"] = acc.get("note") or ""
                merged["lock_reason"] = acc.get("lock_reason") or ""
                merged["locked"] = bool(acc.get("locked", False))
                for forbidden in ("token_data", "token", "access_token", "refresh_token", "id_token", "client_secret"):
                    merged.pop(forbidden, None)
                if isinstance(merged.get("quota"), dict):
                    merged["quota"] = {k: merged["quota"][k] for k in SAFE_QUOTA_KEYS if k in merged["quota"]}
                return merged
        except Exception:
            pass
    return base_safe


def _format_state_row2(is_locked: bool, short_panes: list[str], inner_width: int) -> str:
    """Formatea la segunda fila de ESTADO (<= inner_width chars visibles, sin desbordar jamás)."""
    if is_locked and short_panes:
        if len(short_panes) == 1:
            raw = truncate_visible(f"🔒 en {short_panes[0]}", inner_width)
        else:
            raw = truncate_visible(f"🔒 {len(short_panes)}p:{','.join(short_panes)}", inner_width)
        return f"{C_BOLD}{C_YELLOW}{raw}{C_RESET}"
    if is_locked:
        raw = truncate_visible("🔒 RESERVADA", inner_width)
        return f"{C_BOLD}{C_YELLOW}{raw}{C_RESET}"
    if short_panes:
        if len(short_panes) == 1:
            raw = truncate_visible(f"▶ en {short_panes[0]}", inner_width)
            return f"{C_BOLD}{C_GREEN}{raw}{C_RESET}"
        raw = truncate_visible(f"▶ {len(short_panes)}p:{','.join(short_panes)}", inner_width)
        return f"{C_BOLD}{C_CYAN}{raw}{C_RESET}"
    return ""


def _format_note_row2(acc: dict, inner_width: int) -> str:
    """Formatea la nota o motivo de bloqueo en la segunda fila de CUENTA / EMAIL (<= inner_width chars)."""
    is_locked = bool(acc.get("locked", False))
    raw_text = (
        (acc.get("lock_reason") or acc.get("note") or "")
        if is_locked
        else (acc.get("note") or "")
    )
    clean_text = " ".join(str(raw_text).split()).strip()
    if not clean_text:
        return ""
    disp = truncate_visible(f"↳ {clean_text}", inner_width)
    if is_locked:
        return f"{C_YELLOW}{disp}{C_RESET}"
    return f"{C_DIM}{C_CYAN}{disp}{C_RESET}"


def cmd_list(args):
    ensure_auto_migration()
    sync_account_symlinks()
    real_home = resolve_real_home()
    aliases = list_account_aliases()
    cfg = load_config()
    active = cfg.get("active_account")
    default = cfg.get("default_account")
    active_panes_map = scan_active_herdr_panes(real_home)

    if not aliases:
        if getattr(args, "json", False):
            print(json.dumps({"active_account": active, "default_account": default, "accounts": []}, indent=2))
            return
        print(f"\n{C_YELLOW}No hay cuentas registradas actualmente.{C_RESET}")
        print(f"Usa {C_CYAN}agyc add{C_RESET} para registrar automáticamente tu primera cuenta (agy01).")
        print(f"O usa {C_CYAN}agyc capture{C_RESET} para importar la sesión abierta actualmente.\n")
        return

    force_ref = bool(getattr(args, "refresh", False))
    accounts = []
    with ThreadPoolExecutor(max_workers=6) as pool:
        results = list(pool.map(lambda a: _load_or_refresh_account_for_list(a, force_ref), aliases))
    for item in results:
        if item:
            accounts.append(item)

    if getattr(args, "json", False):
        sanitized_accounts = []
        for acc in accounts:
            al = acc.get("alias", "")
            pane_ids = [p["pane_id"] for p in active_panes_map.get(al, []) if p.get("pane_id")]
            sanitized_accounts.append(
                sanitize_account_for_json(
                    acc,
                    active=active,
                    default=default,
                    active_panes=pane_ids,
                )
            )
        out = {
            "active_account": active,
            "default_account": default,
            "accounts": sanitized_accounts,
        }
        print(json.dumps(out, indent=2))
        return

    print()
    header_title = f"{C_BOLD}{C_WHITE}PANEL DE CUENTAS DE GOOGLE ANTIGRAVITY (PRO / ULTRA — AGYC v1.6){C_RESET}"
    print(header_title)
    print(f"{C_DIM}Consumo unificado en vivo: Gemini (Carbon/Argon/Hydrogen/Flash) y Claude & GPT (5H y Semanal).{C_RESET}\n")

    # Ancho exacto: 10 + 26 + 9 + 13 + 33 + 33 + 7 bordes = 131 caracteres
    col_alias = 10
    col_email = 26
    col_plan = 9
    col_state = 13
    col_gemini = 33
    col_claude = 33

    border_top = f"┌{'─' * col_alias}┬{'─' * col_email}┬{'─' * col_plan}┬{'─' * col_state}┬{'─' * col_gemini}┬{'─' * col_claude}┐"
    border_mid = f"├{'─' * col_alias}┼{'─' * col_email}┼{'─' * col_plan}┼{'─' * col_state}┼{'─' * col_gemini}┼{'─' * col_claude}┤"
    border_bot = f"└{'─' * col_alias}┴{'─' * col_email}┴{'─' * col_plan}┴{'─' * col_state}┴{'─' * col_gemini}┴{'─' * col_claude}┘"

    print(border_top)
    hdr = (
        f"│ {pad_visible(C_BOLD + 'ALIAS' + C_RESET, col_alias - 2)} "
        f"│ {pad_visible(C_BOLD + 'CUENTA / EMAIL' + C_RESET, col_email - 2)} "
        f"│ {pad_visible(C_BOLD + 'PLAN' + C_RESET, col_plan - 2)} "
        f"│ {pad_visible(C_BOLD + 'ESTADO' + C_RESET, col_state - 2)} "
        f"│ {pad_visible(C_BOLD + 'GEMINI (5H / SEMANAL)' + C_RESET, col_gemini - 2)} "
        f"│ {pad_visible(C_BOLD + 'CLAUDE & GPT (5H / SEMANAL)' + C_RESET, col_claude - 2)} │"
    )
    print(hdr)
    print(border_mid)

    for i, acc in enumerate(accounts):
        alias = acc.get("alias", "")
        email = acc.get("email", "")
        if len(email) > col_email - 2:
            email_disp = email[: col_email - 5] + "..."
        else:
            email_disp = email

        is_active = (alias == active)
        is_default = (alias == default)
        is_revoked = bool(acc.get("is_revoked", False))
        is_locked = bool(acc.get("locked", False))
        q = _sanitize_cached_or_stored_quota(acc.get("quota", {}))
        plan_disp = format_plan_badge(q.get("plan_type"))

        panes_for_acc = active_panes_map.get(alias, [])
        short_panes = [str(p["short_pane"]) for p in panes_for_acc if p.get("short_pane")]
        state_row2_str = _format_state_row2(is_locked, short_panes, col_state - 2)
        email_row2_str = _format_note_row2(acc, col_email - 2)

        if is_revoked:
            state_str = f"{C_BOLD}{C_RED}EXPIRADA{C_RESET}"
            alias_disp = f"  {C_RED}{alias}{C_RESET}"
            g_line1 = f"{C_RED}Token revocado por Google{C_RESET}"
            g_line2 = f"{C_YELLOW}Ejecuta: agyc renew {alias}{C_RESET}"
            c_line1 = f"{C_RED}Token revocado por Google{C_RESET}"
            c_line2 = f"{C_DIM}Re-vincular para activar{C_RESET}"
        else:
            if is_active and is_default:
                state_str = f"{C_BG_GREEN}*ACTIVA+DEF{C_RESET}"
                alias_disp = f"{C_BOLD}{C_GREEN}* {alias}{C_RESET}"
            elif is_active:
                state_str = f"{C_GREEN}* ACTIVA{C_RESET}"
                alias_disp = f"{C_BOLD}{C_GREEN}* {alias}{C_RESET}"
            elif is_locked:
                state_str = f"{C_YELLOW}  RESERVADA{C_RESET}"
                alias_disp = f"  {alias}"
            elif is_default:
                state_str = f"{C_CYAN}  DEFAULT{C_RESET}"
                alias_disp = f"  {alias}"
            else:
                state_str = f"{C_DIM}  LISTA{C_RESET}"
                alias_disp = f"  {alias}"

            g5h, g5h_rst = normalize_window(q.get("gemini_5h_fraction"), q.get("gemini_5h_reset"))
            gweek, gweek_rst = normalize_window(q.get("gemini_weekly_fraction"), q.get("gemini_weekly_reset"))
            g_dis = bool(q.get("gemini_disabled", False))

            c5h, c5h_rst = normalize_window(q.get("claude_5h_fraction"), q.get("claude_5h_reset"))
            cweek, cweek_rst = normalize_window(q.get("claude_weekly_fraction"), q.get("claude_weekly_reset"))
            c_dis = bool(q.get("claude_disabled", False))

            g_weekly_empty = (gweek is not None and gweek <= 0.001) or g_dis
            if g_weekly_empty:
                g_line1 = f"5H:  {make_linebar(0.0, length=8)} {C_RED}(Sem: 0%){C_RESET}"
            else:
                g_line1 = f"5H:  {make_linebar(g5h, length=8)} {format_window_status(g5h, g5h_rst, 'list')}"
            g_line2 = f"Sem: {make_linebar(gweek, length=8)} {format_window_status(gweek, gweek_rst, 'list')}"

            c_weekly_empty = (cweek is not None and cweek <= 0.001) or c_dis
            if c_weekly_empty:
                c_line1 = f"5H:  {make_linebar(0.0, length=8)} {C_RED}(Sem: 0%){C_RESET}"
            else:
                c_line1 = f"5H:  {make_linebar(c5h, length=8)} {format_window_status(c5h, c5h_rst, 'list')}"
            c_line2 = f"Sem: {make_linebar(cweek, length=8)} {format_window_status(cweek, cweek_rst, 'list')}"

        row1 = (
            f"│ {pad_visible(alias_disp, col_alias - 2)} "
            f"│ {pad_visible(email_disp, col_email - 2)} "
            f"│ {pad_visible(plan_disp, col_plan - 2)} "
            f"│ {pad_visible(state_str, col_state - 2)} "
            f"│ {pad_visible(g_line1, col_gemini - 2)} "
            f"│ {pad_visible(c_line1, col_claude - 2)} │"
        )
        row2 = (
            f"│ {pad_visible('', col_alias - 2)} "
            f"│ {pad_visible(email_row2_str, col_email - 2)} "
            f"│ {pad_visible('', col_plan - 2)} "
            f"│ {pad_visible(state_row2_str, col_state - 2)} "
            f"│ {pad_visible(g_line2, col_gemini - 2)} "
            f"│ {pad_visible(c_line2, col_claude - 2)} │"
        )
        print(row1)
        print(row2)
        if i < len(accounts) - 1:
            print(border_mid)

    print(border_bot)
    print(f"\n{C_BOLD}Atajos rápidos para desarrollo a tiempo completo:{C_RESET}")
    print(f"  • Entrar directo a cuenta: {C_GREEN}agy01{C_RESET} | {C_GREEN}agy02{C_RESET} | {C_GREEN}agy10{C_RESET} (HOME aislado + --dangerously-skip-permissions)")
    print(f"  • Cambiar sin iniciar:     {C_CYAN}agyc agy02{C_RESET}                  (o 'agyc switch agy02')")
    print(f"  • Rotación inteligente:    {C_CYAN}agyc auto [gemini|claude|carbon] [--allow-ultra]{C_RESET} (Reserva ULTRA + Burn-First)")
    print(f"  • Etiquetar / reservar:    {C_CYAN}agyc note agy05 \"Texto\"{C_RESET} | {C_CYAN}agyc lock agy10 \"Motivo\"{C_RESET}")
    print(f"  • Reporte y diagnóstico:   {C_CYAN}agyc quota [alias]{C_RESET} | {C_CYAN}agyc doctor [--fix]{C_RESET}")
    print(f"  • Agregar / actualizar:    {C_CYAN}agyc add [alias]{C_RESET} | {C_CYAN}agyc update{C_RESET} | {C_CYAN}agyc wipe{C_RESET}\n")


def cmd_switch(args):
    try:
        alias = validate_alias(args.alias)
    except ValueError as e:
        print(f"{C_RED}Error:{C_RESET} {e}")
        sys.exit(1)
    data = load_account(alias)
    if not data:
        print(f"{C_RED}Error:{C_RESET} La cuenta '{alias}' no existe.")
        print(f"Cuentas disponibles: {', '.join(list_account_aliases())}")
        sys.exit(1)

    print(f"{C_CYAN}Cambiando a cuenta '{alias}' ({data.get('email')})...{C_RESET}")
    try:
        data = switch_active_account(alias)
    except TokenRevokedError:
        print(f"\n{C_BOLD}{C_RED}Error: El token de Google para '{alias}' ({data.get('email')}) expiró o fue revocado (invalid_grant).{C_RESET}")
        print("Para proteger tu entorno y evitar el fallback silencioso a otra cuenta, se detuvo el cambio.")
        print(f"\n{C_BOLD}Solución:{C_RESET} Re-vincula únicamente esta cuenta ejecutando:")
        print(f"  {C_GREEN}agyc renew {alias}{C_RESET}\n")
        sys.exit(1)

    q = _sanitize_cached_or_stored_quota(data.get("quota", {}))
    plan_badge = format_plan_badge(q.get("plan_type"))
    tier_name = q.get("tier_name") or "Antigravity"

    g5h, g5h_rst = normalize_window(q.get("gemini_5h_fraction"), q.get("gemini_5h_reset"))
    gweek, gweek_rst = normalize_window(q.get("gemini_weekly_fraction"), q.get("gemini_weekly_reset"))
    g_dis = bool(q.get("gemini_disabled", False))

    c5h, c5h_rst = normalize_window(q.get("claude_5h_fraction"), q.get("claude_5h_reset"))
    cweek, cweek_rst = normalize_window(q.get("claude_weekly_fraction"), q.get("claude_weekly_reset"))
    c_dis = bool(q.get("claude_disabled", False))

    print(f"\n{C_BOLD}{C_GREEN}✓ Cuenta activa cambiada a: {alias} ({data.get('email')}){C_RESET} [{plan_badge} — {tier_name}]")
    if (gweek is not None and gweek <= 0.001) or g_dis:
        print(f"  Gemini 5H:        {make_linebar(0.0, length=12)} {C_RED}(Semanal agotada){C_RESET}")
    else:
        print(f"  Gemini 5H:        {make_linebar(g5h, length=12)} {format_window_status(g5h, g5h_rst, 'list')}")
    print(f"  Gemini Semanal:   {make_linebar(gweek, length=12)} {format_window_status(gweek, gweek_rst, 'list')}")

    if (cweek is not None and cweek <= 0.001) or c_dis:
        print(f"  Claude & GPT 5H:  {make_linebar(0.0, length=12)} {C_RED}(Semanal agotada){C_RESET}")
    else:
        print(f"  Claude & GPT 5H:  {make_linebar(c5h, length=12)} {format_window_status(c5h, c5h_rst, 'list')}")
    print(f"  Claude & GPT Sem: {make_linebar(cweek, length=12)} {format_window_status(cweek, cweek_rst, 'list')}")
    print(f"{C_DIM}A partir de ahora, 'agy' o '{alias}' utilizarán esta sesión con --dangerously-skip-permissions.{C_RESET}\n")


def cmd_default(args):
    try:
        alias = validate_alias(args.alias)
    except ValueError as e:
        print(f"{C_RED}Error:{C_RESET} {e}")
        sys.exit(1)
    data = load_account(alias)
    if not data:
        print(f"{C_RED}Error:{C_RESET} La cuenta '{alias}' no existe.")
        print(f"Cuentas disponibles: {', '.join(list_account_aliases())}")
        sys.exit(1)

    cfg = load_config()
    cfg["default_account"] = alias
    save_config(cfg)

    switch_active_account(alias, silent=True)

    print(f"{C_BOLD}{C_CYAN}★ Cuenta '{alias}' configurada como PREDEFINIDA (Default).{C_RESET}")
    print(f"Al ejecutar 'agy' en la terminal, iniciará siempre con {data.get('email')} y --dangerously-skip-permissions.\n")


class OAuthCallbackHandler(http.server.BaseHTTPRequestHandler):
    auth_code = None
    error = None
    expected_state = None

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/favicon.ico":
            self.send_response(204)
            self.end_headers()
            return

        params = urllib.parse.parse_qs(parsed.query)
        received_state = params.get("state", [None])[0]

        if "error" in params:
            raw_err = str(params["error"][0])
            OAuthCallbackHandler.error = raw_err
            safe_err = html.escape(raw_err, quote=True)
            self.send_response(400)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(f"Error de autenticación: {safe_err}".encode("utf-8"))
        elif "code" in params:
            if OAuthCallbackHandler.expected_state and received_state != OAuthCallbackHandler.expected_state:
                msg = "Estado OAuth inválido (posible CSRF o sesión caduca)."
                OAuthCallbackHandler.error = msg
                self.send_response(400)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                self.wfile.write(f"Error de seguridad: {html.escape(msg, quote=True)}".encode("utf-8"))
                return

            OAuthCallbackHandler.auth_code = params["code"][0]
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            page_html = """
            <!DOCTYPE html>
            <html lang="es">
            <head>
                <meta charset="utf-8">
                <meta name="viewport" content="width=device-width, initial-scale=1">
                <title>Antigravity Auth Completada</title>
                <style>
                    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: #0f172a; color: #f8fafc; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
                    .card { background: #1e293b; padding: 40px; border-radius: 16px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5); text-align: center; max-width: 440px; border: 1px solid #334155; }
                    h1 { color: #4ade80; margin-top: 0; font-size: 24px; }
                    p { color: #94a3b8; line-height: 1.5; margin: 12px 0; }
                    .badge { display: inline-block; background: #064e3b; color: #6ee7b7; padding: 4px 12px; border-radius: 9999px; font-size: 13px; font-weight: 600; margin-bottom: 16px; }
                </style>
            </head>
            <body>
                <div class="card">
                    <div class="badge">Google Antigravity (Pro / Ultra)</div>
                    <h1>¡Autenticación Exitosa!</h1>
                    <p>Tu cuenta ha sido vinculada correctamente para Google Antigravity (agyc v1.6).</p>
                    <p style="color: #64748b; font-size: 14px;">Ya puedes cerrar esta ventana y regresar a tu terminal.</p>
                </div>
            </body>
            </html>
            """
            self.wfile.write(page_html.encode("utf-8"))
        else:
            self.send_response(404)
            self.end_headers()

    def log_message(self, format, *args):
        pass


def _find_alias_by_email(email: str | None) -> str | None:
    if not email:
        return None
    target_em = email.strip().lower()
    for al in list_account_aliases():
        acc = load_account(al)
        if acc and (acc.get("email") or "").strip().lower() == target_em:
            return al
    return None


def cmd_add(args):
    raw_alias = getattr(args, "alias", None)
    subcmd = (getattr(args, "subcommand", "add") or "add").lower()
    is_renew_cmd = subcmd in ("renew", "reauth")
    force = bool(getattr(args, "force", False))

    if raw_alias:
        try:
            alias = validate_alias(raw_alias)
        except ValueError as e:
            print(f"{C_RED}Error:{C_RESET} {e}")
            sys.exit(1)
    else:
        if is_renew_cmd:
            cfg = load_config()
            alias = cfg.get("active_account") or get_next_correlative_alias()
            alias = validate_alias(alias)
        else:
            alias = get_next_correlative_alias()
            print(f"{C_BOLD}{C_GREEN}▶ Asignando automáticamente alias correlativo: {alias}{C_RESET}")

    existing = load_account(alias)
    if existing and not is_renew_cmd and not force:
        print(f"{C_YELLOW}Aviso:{C_RESET} Ya existe una cuenta con el alias '{alias}' ({existing.get('email')}).")
        if sys.stdin.isatty():
            ans = input("¿Deseas sobrescribirla/renovarla? (s/N): ").strip().lower()
            if ans not in ("s", "si", "y", "yes"):
                print("Operación cancelada.")
                return
        else:
            print(f"{C_RED}Error:{C_RESET} Usa --force para sobrescribir '{alias}' en modo no interactivo.")
            sys.exit(1)
    elif existing and is_renew_cmd:
        print(f"{C_CYAN}▶ Renovando credenciales OAuth para '{alias}' ({existing.get('email')})...{C_RESET}")

    server = None
    selected_port = None
    for port in OAUTH_PORTS:
        try:
            server = http.server.HTTPServer(("127.0.0.1", port), OAuthCallbackHandler)
            selected_port = port
            break
        except OSError:
            continue

    if not server:
        print(f"{C_RED}Error:{C_RESET} No se pudo abrir ninguno de los puertos OAuth {OAUTH_PORTS}.")
        sys.exit(1)

    oauth_state = secrets.token_urlsafe(24)
    redirect_uri = f"http://localhost:{selected_port}/oauth-callback"
    auth_params = {
        "client_id": GOOGLE_CLIENT_ID,
        "redirect_uri": redirect_uri,
        "response_type": "code",
        "scope": " ".join(GOOGLE_SCOPES),
        "access_type": "offline",
        "prompt": "select_account consent",
        "state": oauth_state,
    }
    if existing and existing.get("email") and "@" in str(existing.get("email")):
        auth_params["login_hint"] = str(existing["email"]).strip()

    auth_url = f"https://accounts.google.com/o/oauth2/v2/auth?{urllib.parse.urlencode(auth_params)}"

    print()
    print(f"{C_BOLD}{C_CYAN}══════════════════════════════════════════════════════════════════════════{C_RESET}")
    print(f"{C_BOLD} VINCULAR CUENTA DE GOOGLE ANTIGRAVITY: {C_GREEN}{alias}{C_RESET}")
    if existing and existing.get("email"):
        print(f" Cuenta esperada: {C_YELLOW}{existing.get('email')}{C_RESET}")
    print(f"{C_BOLD}{C_CYAN}══════════════════════════════════════════════════════════════════════════{C_RESET}")
    print("1. Abre el enlace en tu navegador para autorizar la cuenta:")
    print(f"\n   {C_CYAN}{C_BOLD}{auth_url}{C_RESET}\n")
    print("2. Selecciona la cuenta de Google AI Pro / Ultra que deseas registrar.")
    print(f"3. Esperando respuesta automática en {C_GREEN}{redirect_uri}{C_RESET}...")
    print(f"{C_DIM}--------------------------------------------------------------------------{C_RESET}")
    print(f"{C_DIM}Si estás en una terminal remota/SSH sin navegador:")
    print(f"Copia la URL final redireccionada (o el código ?code=...) y pégala aquí:{C_RESET}")
    print(f"{C_BOLD}{C_CYAN}══════════════════════════════════════════════════════════════════════════{C_RESET}\n")

    OAuthCallbackHandler.auth_code = None
    OAuthCallbackHandler.error = None
    OAuthCallbackHandler.expected_state = oauth_state

    server_thread = threading.Thread(target=server.serve_forever, daemon=True)
    server_thread.start()

    try:
        import webbrowser
        webbrowser.open(auth_url)
    except Exception:
        pass

    def _parse_manual_oauth_input(raw_val: str) -> str | None:
        if "code=" in raw_val:
            parsed = urllib.parse.urlparse(raw_val)
            p_qs = urllib.parse.parse_qs(parsed.query)
            if "state" in p_qs and p_qs["state"][0] != oauth_state:
                print(f"\n{C_RED}Error de seguridad:{C_RESET} El parámetro state de la URL no coincide.")
                try:
                    server.shutdown()
                    server.server_close()
                except Exception:
                    pass
                sys.exit(1)
            return p_qs.get("code", [raw_val])[0]
        return raw_val

    auth_code = None
    start_t = time.time()
    is_tty = sys.stdin.isatty()
    win_buf: list[str] = []

    while time.time() - start_t < 180:
        if OAuthCallbackHandler.auth_code:
            auth_code = OAuthCallbackHandler.auth_code
            break
        if OAuthCallbackHandler.error:
            print(f"\n{C_RED}Error de Google:{C_RESET} {OAuthCallbackHandler.error}")
            try:
                server.shutdown()
                server.server_close()
            except Exception:
                pass
            sys.exit(1)

        if is_tty:
            if platform.IS_WINDOWS:
                try:
                    import msvcrt
                    raw_val = None
                    while msvcrt.kbhit():
                        ch = msvcrt.getwch()
                        if ch in ("\r", "\n"):
                            sys.stdout.write("\n")
                            sys.stdout.flush()
                            raw_val = "".join(win_buf).strip()
                            win_buf.clear()
                            break
                        if ch == "\x03":
                            raise KeyboardInterrupt
                        if ch == "\x08":
                            if win_buf:
                                win_buf.pop()
                                sys.stdout.write("\b \b")
                                sys.stdout.flush()
                        elif ch in ("\x00", "\xe0"):
                            if msvcrt.kbhit():
                                msvcrt.getwch()
                        else:
                            win_buf.append(ch)
                            sys.stdout.write(ch)
                            sys.stdout.flush()
                    if raw_val:
                        auth_code = _parse_manual_oauth_input(raw_val)
                        break
                    time.sleep(0.1)
                except KeyboardInterrupt:
                    raise
                except Exception:
                    time.sleep(0.5)
            else:
                import select as _select
                try:
                    rlist, _, _ = _select.select([sys.stdin], [], [], 0.5)
                    if rlist:
                        raw_val = sys.stdin.readline().strip()
                        if raw_val:
                            auth_code = _parse_manual_oauth_input(raw_val)
                            break
                except Exception:
                    time.sleep(0.5)
        else:
            time.sleep(0.5)

    try:
        server.shutdown()
        server.server_close()
    except Exception:
        pass

    if not auth_code:
        print(f"\n{C_RED}Tiempo agotado o autorización cancelada.{C_RESET}")
        sys.exit(1)

    print(f"\n{C_CYAN}Intercambiando código por credenciales seguras con Google...{C_RESET}")
    token_payload = urllib.parse.urlencode({
        "client_id": GOOGLE_CLIENT_ID,
        "client_secret": GOOGLE_CLIENT_SECRET,
        "code": auth_code,
        "grant_type": "authorization_code",
        "redirect_uri": redirect_uri,
    }).encode("utf-8")

    try:
        req = urllib.request.Request(
            "https://oauth2.googleapis.com/token",
            data=token_payload,
            headers={"Content-Type": "application/x-www-form-urlencoded"},
        )
        with urllib.request.urlopen(req, timeout=12) as resp:
            token_res = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8", errors="replace")
        print(f"{C_RED}Error al obtener token de Google ({e.code}):{C_RESET} {err_body}")
        sys.exit(1)

    expires_in = token_res.get("expires_in", 3600)
    expiry = (datetime.now(timezone.utc) + timedelta(seconds=expires_in)).isoformat()
    token_data = {
        "token": {
            "access_token": token_res.get("access_token"),
            "token_type": token_res.get("token_type", "Bearer"),
            "refresh_token": token_res.get("refresh_token"),
            "expiry": expiry,
        },
        "auth_method": "consumer",
        "id_token": token_res.get("id_token"),
    }

    access_token = token_res.get("access_token")
    profile = fetch_user_profile(access_token)
    email = profile.get("email")
    if not email and "id_token" in token_res:
        claims = decode_jwt_payload(token_res["id_token"])
        email = claims.get("email")

    # ── Protección contra cruce de cuentas en renew y duplicados en alta nueva ──
    old_email = (existing.get("email") or "").strip().lower() if existing else ""
    new_email = (email or "").strip().lower()
    placeholders = {"", "desconocido@google.com", "cuenta@google.com", f"{alias.lower()}@google.com"}

    if existing and old_email not in placeholders and new_email and new_email != old_email:
        if not force:
            print(
                f"\n{C_BOLD}{C_RED}✗ Error de seguridad: El correo autenticado ('{email}') NO coincide "
                f"con la cuenta registrada en '{alias}' ('{existing.get('email')}').{C_RESET}"
            )
            print("Se abortó la operación para evitar sobrescribir otra cuenta por error.")
            print(f"  • Para renovar '{alias}', vuelve a ejecutar {C_GREEN}agyc renew {alias}{C_RESET} y elige {existing.get('email')}.")
            print(f"  • Si deseas reemplazar '{alias}' intencionalmente, usa: {C_YELLOW}agyc {subcmd} {alias} --force{C_RESET}\n")
            sys.exit(1)
        else:
            print(f"{C_YELLOW}⚠ Aviso (--force): Reemplazando '{existing.get('email')}' por '{email}' en '{alias}'.{C_RESET}")

    if not existing and new_email:
        dup_alias = _find_alias_by_email(new_email)
        if dup_alias and dup_alias != alias:
            print(f"\n{C_YELLOW}⚠ Aviso:{C_RESET} El correo '{email}' ya se encuentra registrado bajo el alias '{dup_alias}'.")
            if force or not sys.stdin.isatty():
                print(f"{C_CYAN}→ Actualizando credenciales sobre el alias existente '{dup_alias}' (evitando duplicado).{C_RESET}")
                alias = dup_alias
                existing = load_account(dup_alias)
            else:
                try:
                    dup_ans = input(
                        f"¿Actualizar el alias existente '{dup_alias}' en lugar de crear un duplicado '{alias}'? (S/n): "
                    ).strip().lower()
                except (EOFError, KeyboardInterrupt):
                    print("\nOperación cancelada.")
                    return
                if dup_ans in ("", "s", "si", "y", "yes"):
                    alias = dup_alias
                    existing = load_account(dup_alias)
                else:
                    try:
                        confirm_dup = input(f"¿Guardar de todos modos como cuenta duplicada en '{alias}'? (s/N): ").strip().lower()
                    except (EOFError, KeyboardInterrupt):
                        confirm_dup = "n"
                    if confirm_dup not in ("s", "si", "y", "yes"):
                        print("Operación cancelada.")
                        return

    print(f"{C_CYAN}Consultando plan y cuotas para {email}...{C_RESET}")
    quota = extract_quota_metrics(fetch_quota_summary(access_token))

    # Conservar refresh_token previo si Google no emitió uno nuevo en reauth parcial, así como metadatos locked/note
    if existing and not token_data["token"].get("refresh_token") and new_email == old_email:
        prev_rt = ((existing.get("token_data") or {}).get("token") or {}).get("refresh_token")
        if prev_rt:
            token_data["token"]["refresh_token"] = prev_rt

    acc_data = {
        "alias": alias,
        "email": email or f"{alias}@google.com",
        "name": profile.get("name") or (existing.get("name") if existing else None) or "Usuario Antigravity",
        "picture": profile.get("picture") or (existing.get("picture") if existing else None),
        "token_data": token_data,
        "quota": quota,
        "is_revoked": False,
        "locked": bool(existing.get("locked", False)) if existing else False,
        "lock_reason": (existing.get("lock_reason") or "") if existing else "",
        "note": (existing.get("note") or "") if existing else "",
    }
    if existing and existing.get("created_at"):
        acc_data["created_at"] = existing["created_at"]

    save_account(alias, acc_data)
    write_quota_cache(alias, quota)
    prepare_isolated_home(alias)

    plan_badge = format_plan_badge(quota.get("plan_type"))
    print(f"\n{C_BOLD}{C_GREEN}✓ Cuenta '{alias}' ({acc_data['email']}) vinculada con éxito!{C_RESET} [{plan_badge}]")
    print(f"  Gemini 5H:        {make_linebar(quota.get('gemini_5h_fraction'), length=12)}")
    print(f"  Gemini Semanal:   {make_linebar(quota.get('gemini_weekly_fraction'), length=12)}")
    print(f"  Claude & GPT 5H:  {make_linebar(quota.get('claude_5h_fraction'), length=12)}")
    print(f"  Claude & GPT Sem: {make_linebar(quota.get('claude_weekly_fraction'), length=12)}")
    print(f"\n{C_BOLD}Atajo listo:{C_RESET} Ya puedes entrar a esta cuenta directamente ejecutando {C_GREEN}{alias}{C_RESET} en tu terminal.\n")

    cfg = load_config()
    current_active = cfg.get("active_account")
    if not current_active:
        cfg["active_account"] = alias
        cfg["default_account"] = alias
        save_config(cfg)
        switch_active_account(alias, silent=True)
        print(f"{C_BOLD}{C_GREEN}★ Cuenta '{alias}' configurada automáticamente como activa y predeterminada.{C_RESET}\n")
    elif current_active == alias:
        switch_active_account(alias, silent=True)
    elif sys.stdin.isatty():
        try:
            ans = input(f"¿Deseas cambiar la sesión activa global a '{alias}' ahora? (s/N): ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            ans = "n"
        if ans in ("s", "si", "y", "yes"):
            switch_active_account(alias)
        else:
            print(f"{C_DIM}La sesión activa se mantiene en '{current_active}'. Puedes cambiar en cualquier momento con: agyc {alias}{C_RESET}\n")


def cmd_capture(args):
    raw_alias = getattr(args, "alias", None)
    if raw_alias:
        try:
            alias = validate_alias(raw_alias)
        except ValueError as e:
            print(f"{C_RED}Error:{C_RESET} {e}")
            sys.exit(1)
    else:
        alias = get_next_correlative_alias()

    token_path = get_active_token_path()
    if not os.path.exists(token_path):
        print(f"{C_RED}Error:{C_RESET} No se encontró sesión activa en {token_path}")
        sys.exit(1)

    try:
        with open(token_path, "r", encoding="utf-8") as f:
            token_data = json.load(f)

        token_data, _ = refresh_token_if_needed(token_data)
        access_token = token_data.get("token", {}).get("access_token")
        profile = fetch_user_profile(access_token) if access_token else {}
        email = profile.get("email")
        if not email and "id_token" in token_data:
            claims = decode_jwt_payload(token_data["id_token"])
            email = claims.get("email")

        dup_alias = _find_alias_by_email(email)
        if dup_alias and not raw_alias:
            alias = dup_alias

        existing = load_account(alias)
        quota = extract_quota_metrics(fetch_quota_summary(access_token)) if access_token else {}

        acc_data = {
            "alias": alias,
            "email": email or "cuenta@google.com",
            "name": profile.get("name") or "Usuario Antigravity",
            "picture": profile.get("picture"),
            "token_data": token_data,
            "quota": quota,
            "is_revoked": False,
            "locked": bool(existing.get("locked", False)) if existing else False,
            "lock_reason": (existing.get("lock_reason") or "") if existing else "",
            "note": (existing.get("note") or "") if existing else "",
        }
        save_account(alias, acc_data)
        if quota:
            write_quota_cache(alias, quota)
        prepare_isolated_home(alias)
        cfg = load_config()
        cfg["active_account"] = alias
        if not cfg.get("default_account"):
            cfg["default_account"] = alias
        save_config(cfg)

        print(f"\n{C_BOLD}{C_GREEN}✓ Sesión actual guardada como alias '{alias}' ({acc_data['email']}) [{format_plan_badge(quota.get('plan_type'))}]{C_RESET}\n")
    except Exception as e:
        print(f"{C_RED}Error al capturar sesión:{C_RESET} {e}")


def cmd_remove(args):
    try:
        alias = validate_alias(args.alias)
    except ValueError as e:
        print(f"{C_RED}Error:{C_RESET} {e}")
        sys.exit(1)
    data = load_account(alias)
    if not data:
        print(f"{C_RED}Error:{C_RESET} La cuenta '{alias}' no existe.")
        sys.exit(1)

    p = os.path.join(get_accounts_dir(), f"{alias}.json")
    if os.path.exists(p):
        os.remove(p)

    # Limpiar HOME aislado de este alias (~/.agyc_homes/{alias}) sin seguir junctions/symlinks
    iso_home = os.path.join(resolve_real_home(), ".agyc_homes", alias)
    if (os.path.exists(iso_home) or platform.is_dir_link(iso_home)) and not os.path.islink(iso_home) and not platform.is_dir_link(iso_home):
        try:
            _safe_rmtree(iso_home)
        except Exception:
            pass

    if platform.IS_WINDOWS and not re.match(r"^(?:agy|agi)(?:0[1-9]|1[0-5])$", alias, re.IGNORECASE):
        for bdir in _windows_bin_dirs():
            cmd_p = os.path.join(bdir, f"{alias}.cmd")
            if os.path.isfile(cmd_p):
                try:
                    os.unlink(cmd_p)
                except OSError:
                    pass

    # Limpiar caché privada y caché legacy (/tmp en Linux) del alias
    priv_cache = get_cache_dir()
    cache_patterns = (
        glob.glob(os.path.join(priv_cache, f"quota_cache_{alias}.json*"))
        + glob.glob(os.path.join(priv_cache, f"*{alias}*.lock"))
        + glob.glob(os.path.join(priv_cache, "locks", f"{alias}.*lock*"))
    )
    if not platform.IS_WINDOWS:
        cache_patterns += (
            glob.glob(f"/tmp/agyc_quota_cache_{alias}.json*")
            + glob.glob(f"/tmp/agyc_quota_refreshing_{alias}.lock")
        )
    for tmp_p in cache_patterns:
        try:
            os.remove(tmp_p)
        except Exception:
            pass

    cfg = load_config()
    if alias == cfg.get("active_account"):
        remaining = list_account_aliases()
        cfg["active_account"] = remaining[0] if remaining else None
        if cfg["active_account"]:
            switch_active_account(cfg["active_account"], silent=True)
        else:
            token_path = get_active_token_path()
            for tp in [token_path] + glob.glob(f"{token_path}.tmp*"):
                if os.path.exists(tp):
                    try:
                        os.remove(tp)
                    except Exception:
                        pass
    if alias == cfg.get("default_account"):
        remaining = list_account_aliases()
        cfg["default_account"] = remaining[0] if remaining else None
    save_config(cfg)
    sync_account_symlinks()

    print(f"{C_GREEN}✓ Cuenta '{alias}', su caché y su HOME aislado eliminados correctamente.{C_RESET}")


def cmd_wipe(args):
    """Limpia de forma segura y completa todas las credenciales, tokens aislados y caché."""
    force = getattr(args, "force", False)
    real_home = resolve_real_home()
    aliases = list_account_aliases()
    base_dir = get_base_dir()
    accounts_dir = get_accounts_dir()
    token_path = get_active_token_path()
    cache_dir = os.path.join(base_dir, "cache")
    priv_cache_dir = get_cache_dir()
    config_path = get_config_path()
    homes_base = os.path.join(real_home, ".agyc_homes")

    print()
    print(f"{C_BOLD}{C_RED}══════════════════════════════════════════════════════════════════════════{C_RESET}")
    print(f"{C_BOLD}{C_RED} ADVERTENCIA: VACIADO TOTAL DE CREDENCIALES Y CACHÉ (WIPE){C_RESET}")
    print(f"{C_BOLD}{C_RED}══════════════════════════════════════════════════════════════════════════{C_RESET}")
    print("Esta acción eliminará de forma irreversible:")
    print(f"  • {len(aliases)} cuenta(s) registrada(s) en {accounts_dir}")
    print(f"  • Configuración de cuentas ({config_path})")
    print(f"  • Token activo y tokens aislados en {homes_base}/*/.gemini/antigravity-cli/")
    print(f"  • Caché privada ({priv_cache_dir}), /tmp/agyc_quota_cache_*.json y caché de sesión")
    print(f"{C_DIM}--------------------------------------------------------------------------{C_RESET}")
    print("Esto garantiza un reinicio limpio desde cero para registrar agy01, agy02, etc.")
    print("sin residuos ni caídas silenciosas (fallback) a credenciales anteriores.\n")

    if not force:
        try:
            confirm = input(f"¿Estás seguro de continuar? Escribe {C_BOLD}'wipe'{C_RESET} o {C_BOLD}'si'{C_RESET} para confirmar: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("\nOperación cancelada.")
            return
        if confirm not in ("wipe", "si", "s", "yes", "y"):
            print("Operación cancelada.")
            return

    deleted_count = 0

    # 1. Eliminar archivos de cuentas
    if os.path.exists(accounts_dir):
        for f in os.listdir(accounts_dir):
            if f.endswith(".json") or ".tmp" in f:
                fp = os.path.join(accounts_dir, f)
                try:
                    os.remove(fp)
                    deleted_count += 1
                except Exception as e:
                    print(f"  {C_YELLOW}Aviso:{C_RESET} No se pudo eliminar {fp}: {e}")

    # 2. Restablecer config.json vacío (0600)
    save_config({"default_account": None, "active_account": None})

    # 3. Eliminar antigravity-oauth-token global, snap y sus .tmp
    token_candidates = [
        token_path,
        os.path.join(real_home, ".gemini", "antigravity-cli", "antigravity-oauth-token"),
    ]
    if not platform.IS_WINDOWS:
        token_candidates.append(
            os.path.join(real_home, "snap", "antigravity-cli", "common", ".gemini", "antigravity-cli", "antigravity-oauth-token")
        )
    for base_tp in set(token_candidates):
        for p in [base_tp] + glob.glob(f"{base_tp}.tmp*"):
            if os.path.lexists(p):
                try:
                    os.remove(p)
                    deleted_count += 1
                except Exception as e:
                    print(f"  {C_YELLOW}Aviso:{C_RESET} No se pudo eliminar {p}: {e}")

    # 4. Eliminar tokens en ~/.agyc_homes/*/.gemini/antigravity-cli/antigravity-oauth-token
    if os.path.isdir(homes_base):
        try:
            for h in os.listdir(homes_base):
                iso_gem = os.path.join(homes_base, h, ".gemini", "antigravity-cli")
                if os.path.isdir(iso_gem):
                    for fn in os.listdir(iso_gem):
                        if fn.startswith("antigravity-oauth-token"):
                            tp = os.path.join(iso_gem, fn)
                            try:
                                os.remove(tp)
                                deleted_count += 1
                            except Exception:
                                pass
        except Exception:
            pass

    # 5. Limpiar cachés de cuotas, locks y run dir
    wipe_cache_patterns = (
        glob.glob(os.path.join(priv_cache_dir, "quota_cache_*.json*"))
        + glob.glob(os.path.join(priv_cache_dir, "*.lock"))
        + glob.glob(os.path.join(priv_cache_dir, "locks", "*.lock*"))
    )
    if not platform.IS_WINDOWS:
        wipe_cache_patterns += (
            glob.glob("/tmp/agyc_quota_cache_*.json*")
            + glob.glob("/tmp/agyc_quota_refreshing_*.lock")
        )
    for cp in wipe_cache_patterns:
        try:
            os.remove(cp)
            deleted_count += 1
        except Exception:
            pass

    # 6. Limpiar caché de sesión
    cache_files_to_clean = [
        "default_project_id.txt",
        "last_conversations.json",
        "conversation_metadata.json",
    ]
    if os.path.exists(cache_dir):
        for cfile in cache_files_to_clean:
            cp = os.path.join(cache_dir, cfile)
            if os.path.exists(cp):
                try:
                    os.remove(cp)
                    deleted_count += 1
                except Exception:
                    pass

    # 7. Sincronizar symlinks
    sync_account_symlinks()

    print(f"\n{C_BOLD}{C_GREEN}✓ Vaciado completado con éxito ({deleted_count} elementos purgados).{C_RESET}")
    print("  • Entorno 100% limpio sin tokens residuales ni cachés caducas.")
    print(f"  • Listo para registrar cuentas correlativas con: {C_CYAN}agyc add{C_RESET} (iniciará con agy01).\n")


def cmd_quota(args):
    raw_alias = getattr(args, "alias", None)
    cfg = load_config()
    if raw_alias:
        try:
            target_alias = validate_alias(raw_alias)
        except ValueError as e:
            print(f"{C_RED}Error:{C_RESET} {e}")
            sys.exit(1)
    else:
        target_alias = cfg.get("active_account")
        if not target_alias:
            aliases = list_account_aliases()
            if aliases:
                target_alias = aliases[0]
            else:
                print(f"{C_YELLOW}No hay cuentas registradas.{C_RESET}")
                return

    data = load_account(target_alias)
    if not data:
        print(f"{C_RED}Error:{C_RESET} Cuenta '{target_alias}' no encontrada.")
        return

    token_data = data.get("token_data", {})
    try:
        token_data, refreshed = refresh_token_if_needed(token_data, alias=target_alias)
        data["token_data"] = token_data
        if refreshed:
            data["is_revoked"] = False
    except TokenRevokedError:
        data["is_revoked"] = True
        save_account(target_alias, data)
        print(f"\n{C_BOLD}{C_RED}✗ Token revocado o expirado para '{target_alias}' ({data.get('email')}).{C_RESET}")
        print(f"Re-vincula la cuenta ejecutando: {C_GREEN}agyc renew {target_alias}{C_RESET}\n")
        return
    except Exception as e:
        print(f"{C_YELLOW}Aviso al verificar token de '{target_alias}':{C_RESET} {e}")

    access_token = token_data.get("token", {}).get("access_token")
    q_raw = fetch_quota_summary(access_token) if access_token else None

    print(f"\n{C_BOLD}{C_WHITE}REPORTE COMPLETO DE CUOTAS: {C_GREEN}{target_alias}{C_RESET} ({data.get('email')})")
    print(f"{C_DIM}{'=' * 74}{C_RESET}")

    if not q_raw:
        print(f"{C_YELLOW}No se pudo obtener información en tiempo real de Google CloudCode PA.{C_RESET}\n")
        return

    old_q = data.get("quota", {}) if isinstance(data.get("quota"), dict) else {}
    metrics = _merge_tier_fallback_if_unfetched(extract_quota_metrics(q_raw), old_q, q_raw)
    data["quota"] = metrics
    data["is_revoked"] = False
    data.pop("has_gemini4", None)
    save_account(target_alias, data)
    write_quota_cache(target_alias, metrics)

    plan_type = metrics.get("plan_type", "FREE")
    tier_name = metrics.get("tier_name") or "Antigravity"
    tier_id = metrics.get("tier_id") or "free-tier"
    supports_carbon = bool(metrics.get("supports_carbon", plan_type == "ULTRA"))

    print(f"  {C_BOLD}Plan / Suscripción:{C_RESET}  {tier_name} [{format_plan_badge(plan_type)}] {C_DIM}({tier_id}){C_RESET}")
    if supports_carbon:
        print(f"  {C_BOLD}Gemini 4 Carbon:{C_RESET}     {C_GREEN}✓ Habilitado{C_RESET} {C_DIM}(Exclusivo Google AI Ultra — grupo unificado Gemini){C_RESET}")
    else:
        print(f"  {C_BOLD}Gemini 4 Carbon:{C_RESET}     {C_DIM}✗ No disponible en plan {plan_type} (Requiere Google AI Ultra){C_RESET}")

    # Extraer descripciones detalladas por grupo/bucket si vinieron del backend
    grp_desc_map: dict[str, str] = {}
    bucket_desc_map: dict[tuple[str, str], str] = {}
    for grp in q_raw.get("groups", []):
        fam = _classify_group_family(grp.get("displayName", ""))
        if grp.get("description"):
            grp_desc_map[fam] = grp["description"]
        for b in grp.get("buckets", []):
            win = _classify_bucket_window(b)
            if b.get("description"):
                bucket_desc_map[(fam, win)] = b["description"]

    gem_desc = grp_desc_map.get("gemini") or (
        "Models within this group: Gemini 4 Carbon, Gemini 4 Argon, Gemini 4 Hydrogen, Gemini Flash"
        if supports_carbon
        else "Models within this group: Gemini 4 Argon, Gemini 4 Hydrogen, Gemini 3.8/2.5 Flash & Pro"
    )
    claude_desc = grp_desc_map.get("claude") or (
        "Models within this group: Claude Sonnet 4.6, Claude Opus 4.6, GPT-OSS 120B"
    )

    sections = [
        ("gemini", "Gemini Models", gem_desc),
        ("claude", "Claude & GPT Models", claude_desc),
    ]

    for fam, title, desc in sections:
        print(f"\n{C_BOLD}{C_CYAN}▶ {title}{C_RESET}")
        print(f"  {C_DIM}{desc}{C_RESET}")

        f5, r5 = normalize_window(metrics.get(f"{fam}_5h_fraction"), metrics.get(f"{fam}_5h_reset"))
        fw, rw = normalize_window(metrics.get(f"{fam}_weekly_fraction"), metrics.get(f"{fam}_weekly_reset"))
        dis = bool(metrics.get(f"{fam}_disabled", False))
        weekly_empty = (fw is not None and fw <= 0.001) or dis

        # Ventana 5H
        if weekly_empty:
            bar_5h = make_linebar(0.0, length=16)
            st_5h = f"{C_RED}[Inactivo - Semanal agotada]{C_RESET}"
        else:
            bar_5h = make_linebar(f5, length=16)
            st_5h = format_window_status(f5, r5, mode="quota")
        print(f"    • {'Five Hour Limit Remaining':<27} {bar_5h}  {st_5h}")
        b_desc_5h = bucket_desc_map.get((fam, "5h"))
        if b_desc_5h and f5 is not None and f5 < 0.9995 and not weekly_empty:
            print(f"      {C_DIM}{b_desc_5h}{C_RESET}")

        # Ventana Weekly
        bar_wk = make_linebar(fw, length=16)
        st_wk = format_window_status(fw, rw, mode="quota")
        print(f"    • {'Weekly Limit Remaining':<27} {bar_wk}  {st_wk}")
        b_desc_wk = bucket_desc_map.get((fam, "weekly"))
        if b_desc_wk and fw is not None and fw < 0.9995:
            print(f"      {C_DIM}{b_desc_wk}{C_RESET}")

    if q_raw.get("description"):
        print(f"\n{C_DIM}{q_raw['description']}{C_RESET}")
    print()


def get_active_model_name() -> str:
    candidate_paths = []
    cur_home = (os.environ.get("HOME") or os.environ.get("USERPROFILE") or "").strip()
    if cur_home and platform._has_agyc_homes_segment(cur_home):
        candidate_paths.append(os.path.join(cur_home, ".gemini", "antigravity-cli", "settings.json"))
    base = get_base_dir()
    candidate_paths.append(os.path.join(base, "settings.json"))

    for sp in candidate_paths:
        if os.path.exists(sp):
            try:
                with open(sp, "r", encoding="utf-8") as f:
                    s = json.load(f)
                if isinstance(s, dict) and s.get("model"):
                    return str(s["model"])
            except Exception:
                pass
    return "Gemini 3.8 Flash (High)"


def _eval_account_for_auto(alias: str) -> tuple[str, dict | None, dict]:
    data = load_account(alias)
    if not data:
        return alias, None, {}
    old_q = data.get("quota", {}) if isinstance(data.get("quota"), dict) else {}
    if data.get("locked") is True and old_q.get("plan_type"):
        return alias, data, _sanitize_cached_or_stored_quota(old_q)
    token_data = data.get("token_data", {})
    try:
        token_data, _ = refresh_token_if_needed(token_data, alias=alias)
        data["token_data"] = token_data
        data["is_revoked"] = False
        access_token = token_data.get("token", {}).get("access_token")
        q_raw = fetch_quota_summary(access_token) if access_token else None
        if q_raw:
            quota = _merge_tier_fallback_if_unfetched(extract_quota_metrics(q_raw), old_q, q_raw)
            data["quota"] = quota
            data.pop("has_gemini4", None)
            save_account(alias, data, sync_links=False)
            write_quota_cache(alias, quota)
        else:
            quota = _sanitize_cached_or_stored_quota(old_q)
    except TokenRevokedError:
        data["is_revoked"] = True
        save_account(alias, data, sync_links=False)
        quota = _sanitize_cached_or_stored_quota(old_q)
    except Exception:
        quota = _sanitize_cached_or_stored_quota(old_q)

    return alias, data, quota


def _builtin_compute_smart_auto_choice(
    accounts: list[dict],
    target_mode: str = "gemini",
    active_panes_map: dict[str, list[dict]] | None = None,
    current_pane: str | None = None,
    allow_ultra: bool = False,
) -> dict:
    """
    Algoritmo 'Reserva ULTRA + Burn-First + Anti-Colisión':
      1) Omite cuentas revocadas o locked == True.
      2) En gemini/claude (sin --allow-ultra), si existe al menos una cuenta PRO saludable (5H >= 15% y Sem >= 15%),
         protege las cuentas ULTRA reservándolas para Gemini 4 Carbon; si todas las PRO están <15% o agotadas,
         habilita automáticamente el fallback a ULTRA.
      3) Anti-colisión: prioriza cuentas libres ([Libre]) sin paneles activos en Herdr frente a cuentas en uso.
      4) Burn-First: entre cuentas libres saludables del mismo tier, prioriza ventana 5H abierta (20% <= 5H < 100%)
         antes de abrir el reloj de 5H de una cuenta intacta al 100%.
    """
    panes_map = active_panes_map or {}
    cur_pane = (current_pane or "").strip() or None
    fam_key = "gemini" if target_mode in ("gemini", "carbon") else "claude"
    now_dt = datetime.now(timezone.utc)

    # Pre-evaluación para detectar disponibilidad de cuentas PRO saludables y total de ULTRA
    has_healthy_pro = False
    ultra_count = 0

    prepared: list[dict] = []
    for acc in accounts:
        if not isinstance(acc, dict):
            continue
        alias = str(acc.get("alias") or "")
        quota = _sanitize_cached_or_stored_quota(acc.get("quota") or {})
        plan_type = str(quota.get("plan_type") or acc.get("plan_type") or "FREE").upper()
        supports_carbon = bool(quota.get("supports_carbon") or acc.get("supports_carbon") or plan_type == "ULTRA")
        is_revoked = bool(acc.get("is_revoked", False))
        is_locked = bool(acc.get("locked", False))

        if not is_revoked and supports_carbon:
            ultra_count += 1

        q5h, r5h = normalize_window(quota.get(f"{fam_key}_5h_fraction"), quota.get(f"{fam_key}_5h_reset"))
        qweek, rweek = normalize_window(quota.get(f"{fam_key}_weekly_fraction"), quota.get(f"{fam_key}_weekly_reset"))
        dis = bool(quota.get(f"{fam_key}_disabled", False))

        if (qweek is not None and qweek <= 0.001) or (dis and (qweek is None or qweek <= 0.001)):
            q5h = 0.0
            qweek = 0.0

        q5h_f = 0.0 if q5h is None else float(q5h)
        qweek_f = 0.0 if qweek is None else float(qweek)
        p5 = pct_display(q5h_f) or 0
        pw = pct_display(qweek_f) or 0

        if not is_revoked and not is_locked and plan_type == "PRO" and p5 >= 15 and pw >= 15:
            has_healthy_pro = True

        all_panes = panes_map.get(alias, [])
        other_panes = [p for p in all_panes if p.get("pane_id") != cur_pane]
        short_other = [str(p.get("short_pane") or _short_pane_label(str(p.get("pane_id") or ""))) for p in other_panes]

        prepared.append({
            "alias": alias,
            "email": str(acc.get("email") or ""),
            "plan_type": plan_type,
            "supports_carbon": supports_carbon,
            "is_revoked": is_revoked,
            "locked": is_locked,
            "lock_reason": str(acc.get("lock_reason") or acc.get("note") or "").strip(),
            "note": str(acc.get("note") or "").strip(),
            "q5h": q5h_f,
            "r5h": r5h,
            "qweek": qweek_f,
            "rweek": rweek,
            "p5": p5,
            "pw": pw,
            "other_panes": other_panes,
            "short_panes": [s for s in short_other if s],
        })

    protect_ultra = bool(target_mode in ("gemini", "claude") and not allow_ultra and has_healthy_pro)
    ultra_fallback = bool(
        target_mode in ("gemini", "claude") and not allow_ultra and not has_healthy_pro and ultra_count > 0
    )

    best_alias: str | None = None
    best_rank: tuple | None = None
    best_5h = 0.0
    best_week = 0.0

    earliest_alias: str | None = None
    min_reset_seconds = float("inf")
    earliest_reset_str = "N/A"

    evaluations: list[dict] = []
    for item in prepared:
        alias = item["alias"]
        if item["is_revoked"]:
            item["status"] = "revoked"
            evaluations.append(item)
            continue

        if target_mode == "carbon" and not item["supports_carbon"]:
            item["status"] = "skip_non_ultra"
            evaluations.append(item)
            continue

        if item["locked"]:
            item["status"] = "locked"
            evaluations.append(item)
            continue

        if protect_ultra and item["plan_type"] == "ULTRA":
            item["status"] = "ultra_protected"
            evaluations.append(item)
            continue

        q5h_f = item["q5h"]
        qweek_f = item["qweek"]
        p5 = item["p5"]
        pw = item["pw"]
        is_free = len(item["short_panes"]) == 0
        is_healthy = (p5 >= 15 and pw >= 15)
        is_burn_first = (is_free and 20 <= p5 < 100 and pw >= 15)

        item["is_free"] = is_free
        item["is_healthy"] = is_healthy
        item["is_burn_first"] = is_burn_first

        if q5h_f > 0.001 and qweek_f > 0.001:
            if target_mode == "carbon":
                base_score = (qweek_f * 0.70) + (q5h_f * 0.30)
            elif target_mode == "claude":
                base_score = (qweek_f * 0.65) + (q5h_f * 0.35)
            else:
                base_score = (q5h_f * 0.65) + (qweek_f * 0.35)

            rank = (
                1 if is_healthy else 0,
                1 if is_free else 0,
                -len(item["short_panes"]),
                1 if is_burn_first else 0,
                round(base_score, 6),
                1 if (target_mode != "carbon" and item["plan_type"] != "ULTRA") else 0,
            )
            item["status"] = "eligible"
            item["score"] = base_score
            item["rank"] = rank
            if best_rank is None or rank > best_rank:
                best_rank = rank
                best_alias = alias
                best_5h = q5h_f
                best_week = qweek_f
        else:
            item["status"] = "exhausted"
            blocking_rst = item["rweek"] if qweek_f <= 0.001 else item["r5h"]
            if blocking_rst:
                try:
                    r_dt = parse_iso_datetime(blocking_rst)
                    secs = max(0.0, (r_dt - now_dt).total_seconds())
                    if 0 < secs < min_reset_seconds:
                        min_reset_seconds = secs
                        earliest_alias = alias
                        earliest_reset_str = format_countdown(blocking_rst)
                except Exception:
                    pass

        evaluations.append(item)

    return {
        "best_alias": best_alias,
        "best_5h": best_5h,
        "best_week": best_week,
        "protect_ultra": protect_ultra,
        "ultra_fallback": ultra_fallback,
        "ultra_count": ultra_count,
        "earliest_alias": earliest_alias,
        "earliest_reset_str": earliest_reset_str,
        "evaluations": evaluations,
    }


def compute_smart_auto_choice(
    accounts_map: dict[str, dict] | list[dict],
    target_mode: str = "gemini",
    active_model: str = "",
    active_panes_map: dict[str, list[dict]] | None = None,
    allow_ultra_for_pro_models: bool = False,
    exclude_pane_id: str | None = None,
) -> dict:
    if isinstance(accounts_map, dict):
        accounts_list = []
        for k, v in accounts_map.items():
            if isinstance(v, dict):
                rec = dict(v)
                rec.setdefault("alias", k)
                accounts_list.append(rec)
        map_for_core = accounts_map
    else:
        accounts_list = [x for x in accounts_map if isinstance(x, dict)]
        map_for_core = {str(x.get("alias") or ""): x for x in accounts_list if x.get("alias")}

    builtin_res = _builtin_compute_smart_auto_choice(
        accounts_list,
        target_mode=target_mode,
        active_panes_map=active_panes_map,
        current_pane=exclude_pane_id,
        allow_ultra=allow_ultra_for_pro_models,
    )
    core_fn = getattr(_agyc_core, "compute_smart_auto_choice", None) if _agyc_core else None
    if callable(core_fn):
        try:
            core_res = core_fn(
                map_for_core,
                target_mode,
                active_model=active_model,
                active_panes_map=active_panes_map or {},
                allow_ultra_for_pro_models=bool(allow_ultra_for_pro_models),
                exclude_pane_id=exclude_pane_id,
            )
            if isinstance(core_res, dict):
                chosen = core_res.get("best_alias")
                if isinstance(chosen, str) and chosen.strip():
                    norm_ch = normalize_alias(chosen.strip())
                    ev_by_alias = {ev.get("alias"): ev for ev in builtin_res["evaluations"]}
                    cand_ev = ev_by_alias.get(norm_ch)
                    cur_ev = ev_by_alias.get(builtin_res.get("best_alias"))
                    # Respetar elección de agyc_core salvo cuando rompería Burn-First estricto (20%<=5H<100% libre vs 100%)
                    preserve_strict_burn_first = bool(
                        cur_ev
                        and cand_ev
                        and cur_ev.get("is_burn_first")
                        and not cand_ev.get("is_burn_first")
                        and cur_ev.get("is_free")
                        and cur_ev.get("is_healthy")
                        and cur_ev.get("plan_type") == cand_ev.get("plan_type")
                    )
                    if cand_ev and cand_ev.get("status") == "eligible" and not preserve_strict_burn_first:
                        builtin_res["best_alias"] = norm_ch
                        builtin_res["best_5h"] = cand_ev["q5h"]
                        builtin_res["best_week"] = cand_ev["qweek"]
                if core_res.get("earliest_alias") and not builtin_res.get("earliest_alias"):
                    builtin_res["earliest_alias"] = core_res["earliest_alias"]
                    if core_res.get("earliest_reset"):
                        builtin_res["earliest_reset_str"] = format_countdown(core_res["earliest_reset"])
        except Exception:
            pass
    return builtin_res


def cmd_auto(args):
    aliases = list_account_aliases()
    if not aliases:
        print(f"{C_YELLOW}No hay cuentas registradas.{C_RESET}")
        return

    allow_ultra = bool(getattr(args, "allow_ultra", False))
    active_model = get_active_model_name()
    forced_family = getattr(args, "family", None)
    if forced_family:
        f_low = forced_family.strip().lower()
        if f_low in ("carbon", "ultra") or "carbon" in f_low or "ultra" in f_low:
            target_mode = "carbon"
        elif f_low in ("claude", "gpt", "3p") or any(k in f_low for k in ("claude", "gpt", "3p", "opus", "sonnet")):
            target_mode = "claude"
        elif f_low in ("gemini", "argon", "hydrogen", "flash") or any(k in f_low for k in ("gemini", "argon", "hydrogen", "flash")):
            target_mode = "gemini"
        else:
            print(f"{C_RED}Error:{C_RESET} Familia '{forced_family}' no válida. Usa: gemini, claude o carbon.")
            sys.exit(1)
    else:
        m_low = active_model.lower()
        if "carbon" in m_low:
            target_mode = "carbon"
        elif any(k in m_low for k in ("claude", "gpt", "3p", "opus", "sonnet")):
            target_mode = "claude"
        else:
            target_mode = "gemini"

    if target_mode == "carbon":
        family_label = "Gemini 4 Carbon (Exclusivo ULTRA)"
    elif target_mode == "claude":
        family_label = "Claude & GPT"
    else:
        family_label = "Gemini (Argon / Hydrogen / Flash)"

    real_home = resolve_real_home()
    active_panes_map = scan_active_herdr_panes(real_home)
    current_pane = (os.environ.get("HERDR_PANE_ID") or "").strip() or None

    print(f"{C_CYAN}Modelo activo en configuración: {C_BOLD}{active_model}{C_RESET}")
    print(f"{C_CYAN}Evaluando cuotas y paneles Herdr en paralelo para {C_BOLD}{family_label}{C_RESET} entre {len(aliases)} cuentas...{C_RESET}")

    with ThreadPoolExecutor(max_workers=6) as pool:
        eval_results = list(pool.map(_eval_account_for_auto, aliases))

    accounts_map: dict[str, dict] = {}
    for alias, data, quota in eval_results:
        if not data:
            continue
        rec = dict(data)
        rec["alias"] = alias
        rec["quota"] = quota
        accounts_map[alias] = rec

    choice = compute_smart_auto_choice(
        accounts_map,
        target_mode=target_mode,
        active_model=active_model,
        active_panes_map=active_panes_map,
        allow_ultra_for_pro_models=allow_ultra,
        exclude_pane_id=current_pane,
    )

    if choice.get("ultra_fallback"):
        print(f"  {C_YELLOW}ℹ Sin cuentas PRO saludables (>=15%); habilitando fallback automático a cuentas ULTRA.{C_RESET}")

    for ev in choice["evaluations"]:
        alias = ev["alias"]
        email = ev["email"]
        plan_badge = format_plan_badge(ev["plan_type"])
        st = ev["status"]

        if st == "revoked":
            print(f"  • {alias:<8} ({email}): {C_RED}[EXPIRADA - Re-vincular con 'agyc renew {alias}']{C_RESET}")
            continue
        if st == "skip_non_ultra":
            print(f"  • {alias:<8} [{plan_badge}] ({email}): {C_DIM}[Omitida — Gemini 4 Carbon requiere ULTRA]{C_RESET}")
            continue
        if st == "locked":
            reason = ev.get("lock_reason") or ""
            tag = f"[🔒 Reservada: {reason}]" if reason else "[🔒 Reservada]"
            print(f"  • {alias:<8} [{plan_badge}] ({email}): {C_YELLOW}{tag}{C_RESET}")
            continue
        if st == "ultra_protected":
            p5 = ev["p5"]
            pw = ev["pw"]
            print(
                f"  • {alias:<8} [{plan_badge}] ({email}): 5H = {p5:3d}% | Semanal = {pw:3d}% "
                f"{C_MAGENTA}[🛡 Reserva ULTRA protegida]{C_RESET}"
            )
            continue

        p5 = ev["p5"]
        pw = ev["pw"]
        short_panes = ev.get("short_panes") or []
        if short_panes:
            pane_tag = f"{C_YELLOW}[En uso: {','.join(short_panes)}]{C_RESET}"
        else:
            pane_tag = f"{C_GREEN}[Libre]{C_RESET}"

        extra_flags: list[str] = [pane_tag]
        if ev["qweek"] <= 0.001:
            extra_flags.append(f"{C_RED}[Semanal Agotada]{C_RESET}")
        elif ev["q5h"] <= 0.001:
            extra_flags.append(f"{C_YELLOW}[5H Agotada]{C_RESET}")
        elif ev.get("is_burn_first"):
            extra_flags.append(f"{C_CYAN}[🔥 Burn-first: aprovecha ventana 5H activa]{C_RESET}")

        flags_str = " " + " ".join(extra_flags) if extra_flags else ""
        print(f"  • {alias:<8} [{plan_badge}] ({email}): 5H = {p5:3d}% | Semanal = {pw:3d}%{flags_str}")

    if target_mode == "carbon" and choice.get("ultra_count", 0) == 0:
        print(f"\n{C_BOLD}{C_YELLOW}⚠ Ninguna de tus cuentas registradas tiene suscripción Google AI Ultra.{C_RESET}")
        print(f"Gemini 4 Carbon solo está habilitado en cuentas ULTRA. Usa {C_CYAN}agyc auto gemini{C_RESET} para Argon/Hydrogen/Flash.\n")
        return

    best_alias = choice.get("best_alias")
    best_5h = float(choice.get("best_5h") or 0.0)
    best_week = float(choice.get("best_week") or 0.0)
    earliest_alias = choice.get("earliest_alias")
    earliest_reset_str = choice.get("earliest_reset_str") or "N/A"

    if best_alias is not None and best_5h > 0.001 and best_week > 0.001:
        print(
            f"\n{C_BOLD}{C_GREEN}✓ Cuenta óptima para {family_label}: {best_alias} "
            f"(5H: {pct_display(best_5h)}%, Semanal: {pct_display(best_week)}%){C_RESET}"
        )
        switch_active_account(best_alias)
    elif earliest_alias:
        print(f"\n{C_BOLD}{C_YELLOW}⚠ Todas las cuentas elegibles tienen la cuota de {family_label} agotada.{C_RESET}")
        print(f"La cuenta más próxima a reiniciarse es {C_CYAN}{earliest_alias}{C_RESET} (se reinicia en: {earliest_reset_str}).")
        print(f"Cambiando a {earliest_alias} para cuando se renueve el ciclo...")
        switch_active_account(earliest_alias)
    else:
        print(f"\n{C_YELLOW}No se encontró ninguna cuenta disponible con saldo en 5H y Semanal para {family_label}.{C_RESET}\n")


def cmd_lock(args):
    try:
        alias = validate_alias(args.alias)
    except ValueError as e:
        print(f"{C_RED}Error:{C_RESET} {e}")
        sys.exit(1)
    data = load_account(alias)
    if not data:
        print(f"{C_RED}Error:{C_RESET} La cuenta '{alias}' no existe.")
        sys.exit(1)

    raw_opt = getattr(args, "note_opt", None)
    raw_pos = getattr(args, "reason", None)
    motivo = None
    if raw_opt is not None:
        motivo = " ".join(str(raw_opt).split()).strip()
    elif isinstance(raw_pos, list) and len(raw_pos) > 0:
        motivo = " ".join(str(x) for x in raw_pos).strip()

    data["locked"] = True
    if motivo is not None and motivo != "":
        data["lock_reason"] = motivo
        if not (data.get("note") or "").strip():
            data["note"] = motivo
    save_account(alias, data, sync_links=False)
    reason_disp = data.get("lock_reason") or data.get("note") or ""
    note_msg = f" ({reason_disp})" if reason_disp else ""
    print(f"{C_BOLD}{C_YELLOW}🔒 Cuenta '{alias}' marcada como RESERVADA{note_msg}.{C_RESET} 'agyc auto' la omitirá.\n")


def cmd_unlock(args):
    try:
        alias = validate_alias(args.alias)
    except ValueError as e:
        print(f"{C_RED}Error:{C_RESET} {e}")
        sys.exit(1)
    data = load_account(alias)
    if not data:
        print(f"{C_RED}Error:{C_RESET} La cuenta '{alias}' no existe.")
        sys.exit(1)
    data["locked"] = False
    data["lock_reason"] = ""
    save_account(alias, data, sync_links=False)
    print(f"{C_BOLD}{C_GREEN}🔓 Cuenta '{alias}' liberada.{C_RESET} Disponible nuevamente para 'agyc auto'.\n")


def cmd_note(args):
    try:
        alias = validate_alias(args.alias)
    except ValueError as e:
        print(f"{C_RED}Error:{C_RESET} {e}")
        sys.exit(1)
    data = load_account(alias)
    if not data:
        print(f"{C_RED}Error:{C_RESET} La cuenta '{alias}' no existe.")
        print(f"Cuentas disponibles: {', '.join(list_account_aliases())}")
        sys.exit(1)

    clear_flag = bool(getattr(args, "clear", False))
    raw_parts = getattr(args, "text", None)

    if clear_flag or (isinstance(raw_parts, list) and len(raw_parts) > 0 and " ".join(raw_parts).strip() == ""):
        data["note"] = ""
        if not data.get("locked"):
            data["lock_reason"] = ""
        save_account(alias, data, sync_links=False)
        print(f"{C_BOLD}{C_GREEN}✓ Nota eliminada en '{alias}' ({data.get('email')}).{C_RESET}\n")
        return

    if isinstance(raw_parts, list) and len(raw_parts) > 0:
        clean_note = " ".join(" ".join(raw_parts).split()).strip()
        data["note"] = clean_note
        save_account(alias, data, sync_links=False)
        print(f"{C_BOLD}{C_GREEN}✓ Nota guardada en '{alias}':{C_RESET} {C_CYAN}{clean_note}{C_RESET}\n")
        return

    cur_note = (data.get("note") or "").strip()
    cur_lock_reason = (data.get("lock_reason") or "").strip()
    if cur_note:
        print(f"{C_BOLD}Nota actual de '{alias}':{C_RESET} {C_CYAN}{cur_note}{C_RESET}\n")
    elif cur_lock_reason:
        print(f"{C_BOLD}Motivo de reserva en '{alias}':{C_RESET} {C_YELLOW}{cur_lock_reason}{C_RESET}\n")
    else:
        print(f"{C_DIM}La cuenta '{alias}' no tiene ninguna nota asignada.{C_RESET}")
        print(f"Usa: {C_CYAN}agyc note {alias} \"Descripción\"{C_RESET} o {C_CYAN}agyc note {alias} --clear{C_RESET}\n")


def _copy_executable(src: str, dst: str) -> bool:
    if not os.path.exists(src):
        return False
    if _same_link_target(src, dst):
        return True
    parent = os.path.dirname(dst)
    if not os.path.exists(parent):
        return False
    try:
        if os.path.islink(dst):
            os.unlink(dst)
        tmp = f"{dst}.tmp.{os.getpid()}"
        shutil.copy2(src, tmp)
        if not platform.IS_WINDOWS:
            os.chmod(tmp, 0o755)
            os.replace(tmp, dst)
        else:
            for attempt in range(4):
                try:
                    os.replace(tmp, dst)
                    break
                except PermissionError:
                    if attempt == 3:
                        raise
                    time.sleep(0.005)
        return True
    except Exception:
        return False


def _copy_regular_file(src: str, dst: str, mode: int = 0o644) -> bool:
    if not os.path.isfile(src):
        return False
    if _same_link_target(src, dst):
        return True
    parent = os.path.dirname(dst)
    try:
        os.makedirs(parent, exist_ok=True)
        if os.path.islink(dst):
            os.unlink(dst)
        tmp = f"{dst}.tmp.{os.getpid()}"
        shutil.copy2(src, tmp)
        if not platform.IS_WINDOWS:
            os.chmod(tmp, mode)
            os.replace(tmp, dst)
        else:
            for attempt in range(4):
                try:
                    os.replace(tmp, dst)
                    break
                except PermissionError:
                    if attempt == 3:
                        raise
                    time.sleep(0.005)
        return True
    except Exception:
        return False


def _sync_agyc_lib_dirs(repo_dir: str, real_home: str) -> list[str]:
    """Sincroniza lib/agyc_core.py, lib/__init__.py y lib/platform/* hacia los directorios lib/ instalados."""
    synced: list[str] = []
    repo_lib = os.path.join(repo_dir, "lib")
    if not os.path.isdir(repo_lib):
        return synced

    target_libs = [os.path.join(real_home, ".gemini", "antigravity-cli", "lib")]
    if platform.IS_WINDOWS:
        la = _use_real_localappdata(real_home)
        if la:
            la_lib = os.path.join(la, "agyc", "lib")
            if la_lib not in target_libs:
                target_libs.append(la_lib)
    else:
        snap_base = os.path.join(real_home, "snap", "antigravity-cli", "common", ".gemini", "antigravity-cli")
        if os.path.isdir(snap_base):
            target_libs.append(os.path.join(snap_base, "lib"))
        for bkp_root in (
            os.path.join(real_home, "proyectos", "backup_agyc"),
            "/home/aidev/proyectos/backup_agyc",
        ):
            if os.path.isdir(bkp_root):
                cand_bkp = os.path.join(bkp_root, "lib")
                if cand_bkp not in target_libs:
                    target_libs.append(cand_bkp)

    lib_rel_files = (
        "agyc_core.py",
        "__init__.py",
        os.path.join("platform", "__init__.py"),
        os.path.join("platform", "linux.py"),
        os.path.join("platform", "win32.py"),
    )
    for fname in lib_rel_files:
        src_f = os.path.join(repo_lib, fname)
        if not os.path.isfile(src_f):
            continue
        for tlib in target_libs:
            dst_f = os.path.join(tlib, fname)
            if _copy_regular_file(src_f, dst_f, mode=0o644):
                synced.append(dst_f)

    # Garantizar __init__.py vacío si se sincronizó agyc_core.py y aún no existía __init__.py en origen
    if os.path.isfile(os.path.join(repo_lib, "agyc_core.py")) and not os.path.isfile(os.path.join(repo_lib, "__init__.py")):
        for tlib in target_libs:
            init_f = os.path.join(tlib, "__init__.py")
            if os.path.isdir(tlib) and not os.path.exists(init_f):
                try:
                    with open(init_f, "w", encoding="utf-8") as f:
                        f.write("")
                    if not platform.IS_WINDOWS:
                        os.chmod(init_f, 0o644)
                except Exception:
                    pass

    return synced


def _parse_semver_tuple(ver_str: str | None) -> tuple[int, int, int]:
    if not ver_str:
        return (0, 0, 0)
    m = re.search(r"(\d+)\.(\d+)(?:\.(\d+))?", ver_str)
    if not m:
        return (0, 0, 0)
    return (int(m.group(1)), int(m.group(2)), int(m.group(3) or 0))


def _dir_size_bytes(root_path: str) -> int:
    total = 0
    stack = [root_path]
    while stack:
        cur = stack.pop()
        try:
            with os.scandir(cur) as it:
                for entry in it:
                    try:
                        if entry.is_symlink() or platform.is_dir_link(entry.path):
                            continue
                        if entry.is_dir(follow_symlinks=False):
                            stack.append(entry.path)
                        else:
                            total += entry.stat(follow_symlinks=False).st_size
                    except Exception:
                        continue
        except Exception:
            continue
    return total


def _resolve_base_dir_readonly(real_home: str) -> str:
    candidates = [
        os.environ.get("ANTIGRAVITY_HOME"),
        os.environ.get("AGY_CONFIG_DIR"),
        os.path.join(real_home, ".gemini", "antigravity-cli"),
    ]
    if not platform.IS_WINDOWS:
        candidates.append(
            os.path.join(real_home, "snap", "antigravity-cli", "common", ".gemini", "antigravity-cli")
        )
    for c in candidates:
        if c and not platform._has_agyc_homes_segment(c) and os.path.exists(c):
            return c
    return os.path.join(real_home, ".gemini", "antigravity-cli")


def _list_aliases_readonly(accounts_dir: str) -> list[str]:
    if not os.path.isdir(accounts_dir):
        return []
    aliases: list[str] = []
    try:
        for f in sorted(os.listdir(accounts_dir)):
            if f.endswith(".json") and f != "config.json":
                stem = f[:-5]
                if ALIAS_REGEX.match(stem) and stem.lower() not in RESERVED_ALIASES:
                    aliases.append(stem)
    except Exception:
        pass
    return aliases


def cmd_doctor(args):
    """Diagnóstico integral [1/6..6/6] y auto-reparación segura (--fix) de la flota Antigravity."""
    fix = bool(getattr(args, "fix", False))
    real_home = resolve_real_home()
    base_dir = _resolve_base_dir_readonly(real_home)
    bin_dir = os.path.join(base_dir, "bin")
    local_la = _use_real_localappdata(real_home) if platform.IS_WINDOWS else None
    local_bin = (
        os.path.join(local_la, "agyc", "bin")
        if local_la
        else (bin_dir if platform.IS_WINDOWS else os.path.join(real_home, ".local", "bin"))
    )
    accounts_dir = os.path.join(base_dir, "accounts")
    homes_base = os.path.join(real_home, ".agyc_homes")
    cache_dir = platform.get_cache_dir(real_home)
    locks_dir = os.path.join(cache_dir, "locks")
    repo_dir = _find_repo_dir(real_home)
    repo_bin = os.path.join(repo_dir, "bin")

    issues_found = 0
    fixes_applied = 0
    freed_npm_bytes = 0

    mode_badge = f"{C_BG_GREEN} AUTO-FIX ACTIVO {C_RESET}" if fix else f"{C_DIM}(modo auditoría — usa --fix para reparar){C_RESET}"
    print(f"\n{C_BOLD}{C_WHITE}DIAGNÓSTICO DE FLOTA AGYC DOCTOR (v1.6){C_RESET} {mode_badge}")
    print(f"{C_DIM}{'=' * 78}{C_RESET}")

    aliases = _list_aliases_readonly(accounts_dir)

    # ── [1/6] Binarios, Librería y PATH ──────────────────────────────────────────
    print(f"\n[{C_BOLD}{C_CYAN}1/6{C_RESET}] {C_BOLD}Binarios, Librería y PATH{C_RESET}")

    agy_real_path = _find_real_agy_binary(real_home)
    if agy_real_path:
        ver_str = ""
        try:
            vres = subprocess.run([agy_real_path, "--version"], capture_output=True, text=True, timeout=5)
            ver_str = (vres.stdout or vres.stderr or "").strip().splitlines()[0] if (vres.stdout or vres.stderr) else ""
        except Exception:
            ver_str = ""
        vtuple = _parse_semver_tuple(ver_str)
        if vtuple >= (1, 5, 10):
            print(f"  {C_GREEN}✓{C_RESET} Motor agy-real v{ver_str} (>= 1.5.10) en {agy_real_path}")
        else:
            issues_found += 1
            print(f"  {C_YELLOW}⚠{C_RESET} Motor agy-real versión '{ver_str or 'desconocida'}' (< 1.5.10) en {agy_real_path} — ejecuta 'agyc update'")
    else:
        issues_found += 1
        print(f"  {C_RED}✗{C_RESET} Motor nativo 'agy-real' / 'agy' no encontrado — ejecuta 'agyc update'")

    def _check_agy_wrapper(wpath: str) -> tuple[bool, str]:
        if not os.path.exists(wpath):
            return False, "faltante"
        if not platform.IS_WINDOWS and not os.access(wpath, os.X_OK):
            return False, "sin permiso +x"
        try:
            with open(wpath, "rb") as wf:
                head = wf.read(4096)
            if platform.IS_WINDOWS:
                if head.startswith(b"MZ"):
                    return False, "es ejecutable nativo en vez de wrapper .cmd"
                txt = head.decode("utf-8", errors="ignore")
                if "agy-real.exe" not in txt or "--dangerously-skip-permissions" not in txt:
                    return False, "contenido inesperado en wrapper .cmd"
                if "agyc\\bin\\agy.cmd" in txt.lower():
                    return False, "riesgo de recursión en wrapper .cmd"
                return True, "wrapper .cmd seguro sin recursión"
            if head.startswith(b"\x7fELF"):
                return False, "es binario ELF directo en vez de wrapper"
            txt = head.decode("utf-8", errors="ignore")
            if "agy-real" not in txt or "--dangerously-skip-permissions" not in txt:
                return False, "contenido inesperado en wrapper"
            for line in txt.splitlines():
                ls = line.strip()
                if ls.startswith("#"):
                    continue
                if ".local/bin/agy" in ls and ("exec" in ls or "REAL_AGY=" in ls):
                    return False, "riesgo de recursión a .local/bin/agy"
            return True, "wrapper seguro sin recursión"
        except Exception as e:
            return False, f"error lectura ({e})"

    def _is_bin_ready(bp: str) -> bool:
        if platform.IS_WINDOWS:
            return os.path.isfile(bp)
        return os.path.exists(bp) and os.access(bp, os.X_OK)

    win_bdirs = _windows_bin_dirs(real_home) if platform.IS_WINDOWS else [bin_dir, local_bin]
    wrapper_targets = (
        [os.path.join(d, "agy.cmd") for d in win_bdirs]
        if platform.IS_WINDOWS
        else [os.path.join(bin_dir, "agy"), os.path.join(local_bin, "agy")]
    )
    wrapper_missing_or_bad = []
    for wloc in wrapper_targets:
        ok_w, msg_w = _check_agy_wrapper(wloc)
        if not ok_w:
            wrapper_missing_or_bad.append((wloc, msg_w))

    required_bins = (
        ("agyc.cmd", "agyc-statusline.cmd", "agyc-titleline.cmd", "agyc-topbar.cmd", "agyc", "agyc-statusline", "agyc-topbar")
        if platform.IS_WINDOWS
        else ("agyc", "agyc-statusline", "agyc-titleline", "agyc-topbar")
    )
    missing_tools: list[str] = []
    for bname in required_bins:
        for dloc in win_bdirs:
            bp = os.path.join(dloc, bname)
            if not _is_bin_ready(bp):
                missing_tools.append(bp)

    missing_launchers: list[str] = []
    for al in aliases:
        lname = f"{al}.cmd" if platform.IS_WINDOWS else al
        for dloc in win_bdirs:
            lp = os.path.join(dloc, lname)
            if not _is_bin_ready(lp):
                missing_launchers.append(lp)

    installed_core = os.path.join(base_dir, "lib", "agyc_core.py")
    installed_plat = os.path.join(base_dir, "lib", "platform", "__init__.py")
    repo_core = os.path.join(repo_dir, "lib", "agyc_core.py")
    core_present = os.path.isfile(installed_core) and os.path.isfile(installed_plat)

    if fix and (wrapper_missing_or_bad or missing_tools or missing_launchers or (not core_present and os.path.isfile(repo_core))):
        if platform.IS_WINDOWS:
            sync_launchers(force=True)
            fixes_applied += len(wrapper_missing_or_bad) + len(missing_tools) + len(missing_launchers)
        else:
            os.makedirs(bin_dir, exist_ok=True)
            os.makedirs(local_bin, exist_ok=True)
            src_agyc = os.path.join(repo_bin, "agyc") if os.path.isfile(os.path.join(repo_bin, "agyc")) else os.path.realpath(__file__)
            for bname in ("agyc", "agy", "agyc-statusline", "agyc-topbar"):
                src_b = src_agyc if bname == "agyc" else os.path.join(repo_bin, bname)
                if not os.path.isfile(src_b):
                    alt_b = os.path.join(bin_dir, bname)
                    src_b = alt_b if os.path.isfile(alt_b) else src_b
                if os.path.isfile(src_b):
                    for dloc in (bin_dir, local_bin):
                        if _copy_executable(src_b, os.path.join(dloc, bname)):
                            fixes_applied += 1
            for dloc in (bin_dir, local_bin):
                sl_p = os.path.join(dloc, "agyc-statusline")
                tl_p = os.path.join(dloc, "agyc-titleline")
                if os.path.exists(sl_p) and not os.path.exists(tl_p):
                    try:
                        if os.path.lexists(tl_p):
                            os.unlink(tl_p)
                        os.symlink(sl_p, tl_p)
                        fixes_applied += 1
                    except Exception:
                        pass
            sync_launchers(force=True)
            canonical_agyc = os.path.join(bin_dir, "agyc")
            all_ln = set(aliases) | {f"agy{i:02d}" for i in range(1, 16)} | {f"agi{i:02d}" for i in range(1, 16)}
            for al in sorted(all_ln):
                lp = os.path.join(local_bin, al)
                if not os.path.exists(lp):
                    try:
                        if os.path.lexists(lp):
                            os.unlink(lp)
                        os.symlink(canonical_agyc, lp)
                        fixes_applied += 1
                    except Exception:
                        pass
        synced_libs = _sync_agyc_lib_dirs(repo_dir, real_home)
        fixes_applied += len(synced_libs)
        wrapper_missing_or_bad = [
            (wloc, _check_agy_wrapper(wloc)[1])
            for wloc in wrapper_targets
            if not _check_agy_wrapper(wloc)[0]
        ]
        missing_tools = [
            os.path.join(dloc, bname)
            for bname in required_bins
            for dloc in win_bdirs
            if not _is_bin_ready(os.path.join(dloc, bname))
        ]
        missing_launchers = [
            os.path.join(dloc, f"{al}.cmd" if platform.IS_WINDOWS else al)
            for al in aliases
            for dloc in win_bdirs
            if not _is_bin_ready(os.path.join(dloc, f"{al}.cmd" if platform.IS_WINDOWS else al))
        ]
        core_present = os.path.isfile(installed_core) and os.path.isfile(installed_plat)
        print(f"  {C_CYAN}🔧 Wrappers, binarios y enlaces resincronizados.{C_RESET}")

    if not wrapper_missing_or_bad:
        print(f"  {C_GREEN}✓{C_RESET} Wrapper 'agy' verificado sin recursión en {bin_dir} y {local_bin}")
    else:
        issues_found += len(wrapper_missing_or_bad)
        for wp, wmsg in wrapper_missing_or_bad:
            print(f"  {C_RED}✗{C_RESET} Wrapper {wp}: {wmsg}")

    if not missing_tools and not missing_launchers:
        print(f"  {C_GREEN}✓{C_RESET} Herramientas (agyc, statusline, titleline, topbar) y {len(aliases)} lanzadores OK")
    else:
        issues_found += len(missing_tools) + (1 if missing_launchers else 0)
        if missing_tools:
            print(f"  {C_YELLOW}⚠{C_RESET} Binarios/wrappers faltantes: {', '.join(missing_tools[:4])}")
        if missing_launchers:
            print(f"  {C_YELLOW}⚠{C_RESET} Lanzadores faltantes ({len(missing_launchers)}): {', '.join(missing_launchers[:4])}")

    if core_present:
        print(f"  {C_GREEN}✓{C_RESET} Librería compartida y lib/platform instaladas en: {os.path.dirname(installed_core)}")
    elif os.path.isfile(repo_core):
        issues_found += 1
        print(f"  {C_YELLOW}⚠{C_RESET} lib/agyc_core.py o lib/platform/ presente en repo pero aún no sincronizada en {os.path.dirname(installed_core)}")
    else:
        print(f"  {C_DIM}ℹ{C_RESET} lib/agyc_core.py no instalada aún en {installed_core} (usando motor interno integrado)")

    if platform.IS_WINDOWS:
        env_path_dirs = {os.path.normcase(os.path.abspath(p)) for p in os.environ.get("PATH", "").split(os.pathsep) if p}
        target_path_dirs = {os.path.normcase(os.path.abspath(d)) for d in win_bdirs}
        path_ok = bool(env_path_dirs & target_path_dirs)
    else:
        env_path_dirs = [os.path.abspath(p) for p in os.environ.get("PATH", "").split(os.pathsep) if p]
        path_ok = os.path.abspath(local_bin) in env_path_dirs or os.path.abspath(bin_dir) in env_path_dirs

    if path_ok:
        print(f"  {C_GREEN}✓{C_RESET} PATH incluye directorios ejecutables de agyc")
    else:
        issues_found += 1
        print(f"  {C_YELLOW}⚠{C_RESET} PATH actual no contiene {local_bin} ni {bin_dir}")

    # ── [2/6] Permisos de Seguridad (0700 / 0600 en Linux; NTFS en Windows) ─────
    if platform.IS_WINDOWS:
        print(f"\n[{C_BOLD}{C_CYAN}2/6{C_RESET}] {C_BOLD}Seguridad NTFS y Directorios Privados{C_RESET}")
    else:
        print(f"\n[{C_BOLD}{C_CYAN}2/6{C_RESET}] {C_BOLD}Permisos de Seguridad (0700 / 0600){C_RESET}")

    expected_700_dirs = [accounts_dir, homes_base, cache_dir, locks_dir]
    if platform.IS_WINDOWS:
        expected_700_dirs.append(platform.get_run_dir(real_home))
    if os.path.isdir(homes_base):
        try:
            for h in sorted(os.listdir(homes_base)):
                hp = os.path.join(homes_base, h)
                if os.path.isdir(hp) and not os.path.islink(hp) and not platform.is_dir_link(hp):
                    expected_700_dirs.append(hp)
        except Exception:
            pass

    expected_600_files: list[str] = []
    if os.path.isdir(accounts_dir):
        try:
            for fn in sorted(os.listdir(accounts_dir)):
                if fn.endswith(".json"):
                    fp = os.path.join(accounts_dir, fn)
                    if os.path.isfile(fp) and not os.path.islink(fp):
                        expected_600_files.append(fp)
        except Exception:
            pass

    global_sec_cands = [
        os.path.join(base_dir, "antigravity-oauth-token"),
        os.path.join(base_dir, "settings.json"),
    ]
    if not platform.IS_WINDOWS:
        global_sec_cands.append(
            os.path.join(real_home, "snap", "antigravity-cli", "common", ".gemini", "antigravity-cli", "antigravity-oauth-token")
        )
    for global_sec in global_sec_cands:
        if os.path.isfile(global_sec) and not os.path.islink(global_sec) and global_sec not in expected_600_files:
            expected_600_files.append(global_sec)

    if os.path.isdir(homes_base):
        try:
            for h in sorted(os.listdir(homes_base)):
                igem = os.path.join(homes_base, h, ".gemini", "antigravity-cli")
                for fn in ("antigravity-oauth-token", "settings.json"):
                    fp = os.path.join(igem, fn)
                    if os.path.isfile(fp) and not os.path.islink(fp):
                        expected_600_files.append(fp)
        except Exception:
            pass

    if os.path.isdir(cache_dir):
        for qcf in sorted(glob.glob(os.path.join(cache_dir, "quota_cache_*.json"))):
            if os.path.isfile(qcf) and not os.path.islink(qcf):
                expected_600_files.append(qcf)

    if platform.IS_WINDOWS:
        missing_priv_dirs = [dp for dp in (accounts_dir, homes_base, cache_dir, locks_dir) if not os.path.isdir(dp)]
        if fix:
            for dp in missing_priv_dirs:
                platform.ensure_private_dir(dp, 0o700)
                fixes_applied += 1
            hardened = 0
            for dp in (accounts_dir, homes_base, cache_dir):
                if os.path.isdir(dp) and platform.harden_ntfs_acl(dp):
                    hardened += 1
            if hardened:
                fixes_applied += hardened
                print(f"  {C_CYAN}🔧 ACLs NTFS endurecidas para el usuario actual en {hardened} directorio(s) privado(s).{C_RESET}")
            missing_priv_dirs = [dp for dp in (accounts_dir, homes_base, cache_dir, locks_dir) if not os.path.isdir(dp)]
        if not missing_priv_dirs:
            print(
                f"  {C_GREEN}✓{C_RESET} {len(expected_700_dirs)} directorios privados y "
                f"{len(expected_600_files)} archivos sensibles verificados en NTFS"
            )
        else:
            issues_found += len(missing_priv_dirs)
            for dp in missing_priv_dirs:
                print(f"  {C_YELLOW}⚠{C_RESET} Directorio privado faltante: {dp}")
    else:
        perm_issues: list[tuple[str, int, int | None]] = []
        for dp in expected_700_dirs:
            if not os.path.exists(dp):
                if dp in (accounts_dir, homes_base, cache_dir, locks_dir):
                    perm_issues.append((dp, 0o700, None))
                continue
            cur_m = stat.S_IMODE(os.lstat(dp).st_mode)
            if cur_m != 0o700:
                perm_issues.append((dp, 0o700, cur_m))

        for fp in expected_600_files:
            cur_m = stat.S_IMODE(os.lstat(fp).st_mode)
            if cur_m != 0o600:
                perm_issues.append((fp, 0o600, cur_m))

        if perm_issues and fix:
            repaired_perms = 0
            for p_item, exp_mode, cur_mode in perm_issues:
                try:
                    if cur_mode is None:
                        os.makedirs(p_item, mode=exp_mode, exist_ok=True)
                    os.chmod(p_item, exp_mode)
                    repaired_perms += 1
                    fixes_applied += 1
                except Exception as e:
                    issues_found += 1
                    print(f"  {C_RED}✗{C_RESET} No se pudo ajustar {oct(exp_mode)} en {p_item}: {e}")
            print(f"  {C_CYAN}🔧 Permisos endurecidos automáticamente en {repaired_perms} ruta(s) (0700/0600).{C_RESET}")
            perm_issues = []

        if not perm_issues:
            print(
                f"  {C_GREEN}✓{C_RESET} {len(expected_700_dirs)} directorios en 0700 y "
                f"{len(expected_600_files)} archivos sensibles en 0600 verificados"
            )
        else:
            issues_found += len(perm_issues)
            for p_item, exp_mode, cur_mode in perm_issues[:6]:
                cur_s = f"0{cur_mode:03o}" if cur_mode is not None else "no existe"
                print(f"  {C_YELLOW}⚠{C_RESET} {p_item}: actual={cur_s}, esperado=0{exp_mode:03o}")
            if len(perm_issues) > 6:
                print(f"  {C_DIM}  ... y {len(perm_issues) - 6} ruta(s) adicional(es) por endurecer con --fix{C_RESET}")

    # ── [3/6] Aislamiento de Perfiles, Enlaces y Duplicados ─────────────────────
    print(f"\n[{C_BOLD}{C_CYAN}3/6{C_RESET}] {C_BOLD}Aislamiento de Perfiles, Enlaces y Duplicados{C_RESET}")

    email_map: dict[str, list[str]] = {}
    revoked_aliases: list[str] = []
    profile_drift_aliases: list[tuple[str, list[str]]] = []

    def _audit_single_profile(al: str) -> tuple[dict | None, list[str]]:
        acc_p = os.path.join(accounts_dir, f"{al}.json")
        acc_d = None
        try:
            with open(acc_p, "r", encoding="utf-8") as f:
                acc_d = json.load(f)
        except Exception:
            return None, ["JSON de cuenta ilegible"]

        reasons: list[str] = []
        iso_h = os.path.join(homes_base, al)
        iso_g = os.path.join(iso_h, ".gemini", "antigravity-cli")
        if not os.path.isdir(iso_g):
            reasons.append("HOME aislado faltante")
            return acc_d, reasons

        # Token aislado vs accounts/<alias>.json
        tok_file = os.path.join(iso_g, "antigravity-oauth-token")
        exp_td = (acc_d.get("token_data") or {}).get("token") or {}
        if os.path.islink(tok_file) or not os.path.isfile(tok_file):
            reasons.append("token aislado faltante o symlink")
        else:
            try:
                with open(tok_file, "r", encoding="utf-8") as tf:
                    iso_td = (json.load(tf).get("token") or {})
                if exp_td.get("refresh_token") and iso_td.get("refresh_token") != exp_td.get("refresh_token"):
                    reasons.append("refresh_token desincronizado")
                elif exp_td.get("access_token") and iso_td.get("access_token") != exp_td.get("access_token"):
                    reasons.append("access_token desincronizado")
            except Exception:
                reasons.append("token aislado corrupto")

        for req_gem_link in ("builtin", "mcp", "lib"):
            src_t = os.path.join(base_dir, req_gem_link)
            dst_l = os.path.join(iso_g, req_gem_link)
            if os.path.exists(src_t) or req_gem_link == "mcp":
                if not platform.is_dir_link(dst_l) or not os.path.exists(dst_l):
                    reasons.append(f"enlace '{req_gem_link}' faltante/roto")

        for req_dot in (".gitconfig", ".ssh", os.path.join(".config", "herdr")):
            src_d = os.path.join(real_home, req_dot)
            dst_d = os.path.join(iso_h, req_dot)
            if os.path.exists(src_d) and not os.path.exists(dst_d):
                reasons.append(f"enlace '{req_dot}' faltante")

        if platform.IS_WINDOWS:
            real_ad = os.environ.get("APPDATA", "").strip()
            src_wh = os.path.join(real_ad, "herdr") if (real_ad and not platform._has_agyc_homes_segment(real_ad)) else os.path.join(real_home, "AppData", "Roaming", "herdr")
            dst_wh = os.path.join(iso_h, "AppData", "Roaming", "herdr")
            if os.path.isdir(src_wh) and (not platform.is_dir_link(dst_wh) or not os.path.isdir(dst_wh)):
                reasons.append("junction 'AppData/Roaming/herdr' faltante")

        return acc_d, reasons

    loaded_accounts: dict[str, dict] = {}
    for al in aliases:
        acc_obj, drift_reasons = _audit_single_profile(al)
        if isinstance(acc_obj, dict):
            loaded_accounts[al] = acc_obj
            em = (acc_obj.get("email") or "").strip().lower()
            if em and em not in ("desconocido@google.com", "cuenta@google.com", f"{al.lower()}@google.com"):
                email_map.setdefault(em, []).append(al)
            if acc_obj.get("is_revoked"):
                revoked_aliases.append(al)
        if drift_reasons:
            profile_drift_aliases.append((al, drift_reasons))

    if profile_drift_aliases and fix:
        repaired_profiles = 0
        for al, _ in profile_drift_aliases:
            try:
                prepare_isolated_home(al)
                repaired_profiles += 1
                fixes_applied += 1
            except Exception as e:
                print(f"  {C_RED}✗{C_RESET} Error reparando perfil {al}: {e}")
        print(f"  {C_CYAN}🔧 Perfiles aislados y tokens reparados en {repaired_profiles} cuenta(s).{C_RESET}")
        profile_drift_aliases = []
        for al in aliases:
            _, post_reasons = _audit_single_profile(al)
            if post_reasons:
                profile_drift_aliases.append((al, post_reasons))

    if not profile_drift_aliases:
        link_kind = "junctions" if platform.IS_WINDOWS else "symlinks"
        print(f"  {C_GREEN}✓{C_RESET} {len(aliases)} perfil(es) aislados con tokens sincronizados y {link_kind} (builtin, mcp, lib, dotfiles) OK")
    else:
        issues_found += len(profile_drift_aliases)
        for al, rlist in profile_drift_aliases:
            print(f"  {C_YELLOW}⚠{C_RESET} {al}: {', '.join(rlist)}")

    dup_emails = {em: als for em, als in email_map.items() if len(als) > 1}
    if not dup_emails:
        print(f"  {C_GREEN}✓{C_RESET} 0 emails duplicados entre cuentas registradas")
    else:
        issues_found += len(dup_emails)
        for em, als in dup_emails.items():
            print(f"  {C_YELLOW}⚠{C_RESET} Email duplicado '{em}' en alias: {', '.join(als)}")

    if revoked_aliases:
        issues_found += len(revoked_aliases)
        print(f"  {C_RED}✗{C_RESET} Tokens expirados/revocados: {', '.join(revoked_aliases)} (usa 'agyc renew <alias>')")

    # ── [4/6] Auditoría de Espacio y Cachés Duplicadas en ~/.agyc_homes ──────────
    print(f"\n[{C_BOLD}{C_CYAN}4/6{C_RESET}] {C_BOLD}Auditoría de Espacio y Cachés Duplicadas en ~/.agyc_homes{C_RESET}")

    dup_npm_entries: list[tuple[str, str, int]] = []
    unlinked_npm_profiles: list[tuple[str, str]] = []
    linked_npm_count = 0
    info_large_dirs: list[tuple[str, int]] = []

    if os.path.isdir(homes_base):
        profile_dirs = [
            h for h in sorted(os.listdir(homes_base))
            if os.path.isdir(os.path.join(homes_base, h))
            and not os.path.islink(os.path.join(homes_base, h))
            and not platform.is_dir_link(os.path.join(homes_base, h))
        ]
        size_jobs: list[tuple[str, str, str]] = []
        for h in profile_dirs:
            hp = os.path.join(homes_base, h)
            npm_p = os.path.join(hp, ".npm")
            if platform.is_dir_link(npm_p) and os.path.exists(npm_p):
                linked_npm_count += 1
            elif os.path.isdir(npm_p) and not platform.is_dir_link(npm_p):
                size_jobs.append(("npm", h, npm_p))
            else:
                unlinked_npm_profiles.append((h, npm_p))

            try:
                for sub in sorted(os.listdir(hp)):
                    if sub in (".gemini", ".npm", ".ssh", ".gitconfig", ".git-credentials"):
                        continue
                    sp = os.path.join(hp, sub)
                    if os.path.isdir(sp) and not platform.is_dir_link(sp):
                        size_jobs.append(("other", f"{h}/{sub}", sp))
            except Exception:
                pass

        if size_jobs:
            with ThreadPoolExecutor(max_workers=6) as pool:
                measured = list(pool.map(lambda job: (job[0], job[1], job[2], _dir_size_bytes(job[2])), size_jobs))
            for kind, label, path_m, sz in measured:
                if kind == "npm":
                    dup_npm_entries.append((label, path_m, sz))
                elif sz >= 5 * 1024 * 1024:
                    info_large_dirs.append((label, sz))

    stale_tmp_files: list[str] = []
    if not platform.IS_WINDOWS:
        my_uid = os.getuid()
        real_home_abs = os.path.abspath(real_home)
        for tp in sorted(glob.glob("/tmp/agyc_*")):
            try:
                tp_abs = os.path.abspath(tp)
                if real_home_abs == tp_abs or real_home_abs.startswith(tp_abs + "/"):
                    continue
                lst = os.lstat(tp)
                if lst.st_uid == my_uid and not stat.S_ISDIR(lst.st_mode):
                    stale_tmp_files.append(tp)
            except Exception:
                pass

    if fix and (dup_npm_entries or unlinked_npm_profiles or stale_tmp_files):
        real_npm = os.path.join(real_home, ".npm")
        if (os.path.islink(real_npm) or platform.is_dir_link(real_npm)) and not os.path.exists(real_npm):
            try:
                _safe_unlink_link(real_npm)
            except Exception:
                pass
        os.makedirs(real_npm, exist_ok=True)

        unified_count = 0
        for h, npm_p, sz in dup_npm_entries:
            try:
                if not _same_link_target(os.path.realpath(npm_p), os.path.realpath(real_npm)) and not platform.is_dir_link(npm_p):
                    _safe_rmtree(npm_p)
                    platform.create_dir_link(real_npm, npm_p)
                    freed_npm_bytes += sz
                    unified_count += 1
                    linked_npm_count += 1
                    fixes_applied += 1
            except Exception as e:
                issues_found += 1
                print(f"  {C_RED}✗{C_RESET} Error unificando {npm_p}: {e}")

        for h, npm_p in unlinked_npm_profiles:
            try:
                if platform.is_dir_link(npm_p) or os.path.islink(npm_p):
                    _safe_unlink_link(npm_p)
                if not os.path.exists(npm_p):
                    platform.create_dir_link(real_npm, npm_p)
                    linked_npm_count += 1
                    fixes_applied += 1
            except Exception:
                pass

        if unified_count > 0 or unlinked_npm_profiles:
            freed_mb = freed_npm_bytes / (1024.0 * 1024.0)
            print(
                f"  {C_CYAN}🔧 Caché .npm unificada hacia {real_npm} en {linked_npm_count} perfil(es) "
                f"({freed_mb:.2f} MB liberados).{C_RESET}"
            )
        dup_npm_entries = []
        unlinked_npm_profiles = []

        removed_tmp = 0
        for tp in stale_tmp_files:
            try:
                os.remove(tp)
                removed_tmp += 1
                fixes_applied += 1
            except Exception:
                pass
        if removed_tmp > 0:
            print(f"  {C_CYAN}🔧 Eliminados {removed_tmp} archivo(s) obsoletos en /tmp/agyc_*.{C_RESET}")
        stale_tmp_files = []

    if not dup_npm_entries:
        print(f"  {C_GREEN}✓{C_RESET} Cachés .npm unificadas por enlace ({linked_npm_count} perfil(es) -> {os.path.join(real_home, '.npm')})")
    else:
        issues_found += 1
        total_npm_mb = sum(x[2] for x in dup_npm_entries) / (1024.0 * 1024.0)
        print(
            f"  {C_YELLOW}⚠{C_RESET} {len(dup_npm_entries)} cachés .npm duplicadas ocupan {C_BOLD}{total_npm_mb:.2f} MB{C_RESET} "
            f"(usa 'agyc doctor --fix' para unificar a ~/.npm)"
        )

    if not platform.IS_WINDOWS:
        if stale_tmp_files:
            issues_found += 1
            print(f"  {C_YELLOW}⚠{C_RESET} {len(stale_tmp_files)} archivo(s) legacy en /tmp/agyc_* pendientes de limpieza")
        else:
            print(f"  {C_GREEN}✓{C_RESET} 0 archivos legacy en /tmp/agyc_*")

    if info_large_dirs:
        info_large_dirs.sort(key=lambda x: x[1], reverse=True)
        summary_dirs = ", ".join(f"{lbl} ({sz / (1024.0 * 1024.0):.1f} MB)" for lbl, sz in info_large_dirs[:5])
        print(f"  {C_DIM}ℹ Otros directorios en perfiles aislados (intactos): {summary_dirs}{C_RESET}")

    # ── [5/6] Telemetría TUI y TopBar de Herdr ───────────────────────────────────
    print(f"\n[{C_BOLD}{C_CYAN}5/6{C_RESET}] {C_BOLD}Telemetría TUI y TopBar de Herdr{C_RESET}")

    settings_targets = [os.path.join(base_dir, "settings.json")]
    for al in aliases:
        iso_sp = os.path.join(homes_base, al, ".gemini", "antigravity-cli", "settings.json")
        if os.path.isdir(os.path.dirname(iso_sp)):
            settings_targets.append(iso_sp)

    valid_sl_cmds = ("agyc-statusline", "agyc-statusline.cmd") if platform.IS_WINDOWS else ("agyc-statusline",)
    valid_tl_cmds = ("agyc-titleline", "agyc-titleline.cmd") if platform.IS_WINDOWS else ("agyc-titleline",)

    def _check_settings_hooks(paths: list[str]) -> list[str]:
        bad: list[str] = []
        for sp in paths:
            if not os.path.isfile(sp):
                bad.append(sp)
                continue
            try:
                with open(sp, "r", encoding="utf-8") as f:
                    s = json.load(f)
                sl = s.get("statusLine") or {}
                tl = s.get("title") or {}
                if (
                    sl.get("command") not in valid_sl_cmds
                    or not sl.get("enabled")
                    or sl.get("type") != "command"
                    or tl.get("command") not in valid_tl_cmds
                    or not tl.get("enabled")
                    or tl.get("type") != "command"
                ):
                    bad.append(sp)
            except Exception:
                bad.append(sp)
        return bad

    bad_settings = _check_settings_hooks(settings_targets)
    if bad_settings and fix:
        main_sp = os.path.join(base_dir, "settings.json")
        if not os.path.exists(main_sp):
            try:
                os.makedirs(base_dir, exist_ok=True)
                _atomic_write_json(main_sp, {}, mode=0o600, indent=2)
            except Exception:
                pass
        ensure_statusline_configured()
        for al in aliases:
            iso_sp = os.path.join(homes_base, al, ".gemini", "antigravity-cli", "settings.json")
            if not os.path.isfile(iso_sp):
                try:
                    prepare_isolated_home(al)
                except Exception:
                    pass
        fixes_applied += len(bad_settings)
        print(f"  {C_CYAN}🔧 Hooks statusLine/title reparados en {len(bad_settings)} archivo(s) settings.json.{C_RESET}")
        bad_settings = _check_settings_hooks(settings_targets)

    if not bad_settings:
        print(f"  {C_GREEN}✓{C_RESET} Hooks statusLine y title activos en {len(settings_targets)} archivo(s) settings.json")
    else:
        issues_found += len(bad_settings)
        print(f"  {C_YELLOW}⚠{C_RESET} {len(bad_settings)} archivo(s) settings.json sin hooks completos (agyc-statusline / agyc-titleline)")

    herdr_toml_cands = []
    if platform.IS_WINDOWS:
        real_ad = os.environ.get("APPDATA", "").strip()
        if real_ad and not platform._has_agyc_homes_segment(real_ad):
            herdr_toml_cands.append(os.path.join(real_ad, "herdr", "config.toml"))
        herdr_toml_cands.append(os.path.join(real_home, "AppData", "Roaming", "herdr", "config.toml"))
    herdr_toml_cands.append(os.path.join(real_home, ".config", "herdr", "config.toml"))
    herdr_toml = next((p for p in herdr_toml_cands if os.path.isfile(p)), herdr_toml_cands[0])
    if os.path.isfile(herdr_toml):
        try:
            with open(herdr_toml, "r", encoding="utf-8", errors="ignore") as f:
                toml_txt = f.read()
            has_topbar = "agyc-topbar" in toml_txt
            has_borders = bool(re.search(r"(?m)^\s*show_agent_labels_on_pane_borders\s*=\s*true\b", toml_txt))
            has_toast = "[ui.toast]" in toml_txt

            if has_topbar and has_borders:
                print(f"  {C_GREEN}✓{C_RESET} Widget global 'agyc-topbar' y bordes de panel configurados en {herdr_toml}")
            elif fix:
                new_txt = toml_txt
                if not has_borders:
                    if re.search(r"(?m)^\s*show_agent_labels_on_pane_borders\s*=", new_txt):
                        new_txt = re.sub(
                            r"(?m)^\s*show_agent_labels_on_pane_borders\s*=.*$",
                            "show_agent_labels_on_pane_borders = true",
                            new_txt,
                            count=1,
                        )
                    elif re.search(r"(?m)^\[ui\]\s*$", new_txt):
                        new_txt = re.sub(
                            r"(?m)^(\[ui\]\s*)$",
                            "\\1\nshow_agent_labels_on_pane_borders = true",
                            new_txt,
                            count=1,
                        )
                    else:
                        if new_txt and not new_txt.endswith("\n"):
                            new_txt += "\n"
                        new_txt += '\n[ui]\nshow_agent_labels_on_pane_borders = true\ntab_bar_position = "top"\n'

                if not has_topbar:
                    if platform.IS_WINDOWS:
                        topbar_cmd = os.path.join(real_home, ".gemini", "antigravity-cli", "bin", "agyc-topbar.cmd")
                    else:
                        topbar_cmd = os.path.join(real_home, ".local", "bin", "agyc-topbar")
                    if new_txt and not new_txt.endswith("\n"):
                        new_txt += "\n"
                    new_txt += (
                        "\n[[ui.tab_bar_right]]\n"
                        'type = "command"\n'
                        f"command = {json.dumps(topbar_cmd)}\n"
                        "interval_seconds = 10\n"
                        "timeout_seconds = 2\n"
                    )

                if not has_toast:
                    if new_txt and not new_txt.endswith("\n"):
                        new_txt += "\n"
                    new_txt += '\n[ui.toast]\ndelivery = "herdr"\n'

                try:
                    import tomllib  # Python 3.11+
                    tomllib.loads(new_txt)
                except ImportError:
                    pass
                tmp_toml = f"{herdr_toml}.tmp.{os.getpid()}"
                with open(tmp_toml, "w", encoding="utf-8") as tf:
                    tf.write(new_txt)
                os.replace(tmp_toml, herdr_toml)
                repairs_applied += 1
                print(
                    f"  {C_CYAN}🔧{C_RESET} Configurado Herdr (show_agent_labels_on_pane_borders + agyc-topbar) en {herdr_toml}"
                )
                herdr_exe = None
                for h_cand in (
                    os.environ.get("HERDR_BIN_PATH", "").strip(),
                    shutil.which("herdr.exe" if platform.IS_WINDOWS else "herdr"),
                    shutil.which("herdr"),
                ):
                    if h_cand and os.path.isfile(h_cand):
                        herdr_exe = h_cand
                        break
                if herdr_exe:
                    try:
                        subprocess.run(
                            [herdr_exe, "server", "reload-config"],
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                            timeout=2,
                        )
                    except Exception:
                        pass
            else:
                issues_found += 1
                missing_parts = []
                if not has_borders:
                    missing_parts.append("show_agent_labels_on_pane_borders")
                if not has_topbar:
                    missing_parts.append("agyc-topbar")
                print(f"  {C_YELLOW}⚠{C_RESET} Falta {', '.join(missing_parts)} en {herdr_toml}")
        except Exception:
            print(f"  {C_YELLOW}⚠{C_RESET} No se pudo leer {herdr_toml}")
    else:
        print(f"  {C_DIM}ℹ{C_RESET} {herdr_toml} no encontrado en este entorno")

    h_panes, h_lat_ms, h_sock = _query_herdr_panes_fast(real_home, timeout=0.12)
    if h_lat_ms is not None:
        print(f"  {C_GREEN}✓{C_RESET} Socket Herdr vivo ({h_sock} — {len(h_panes)} paneles totales, {h_lat_ms:.1f} ms)")
    else:
        print(f"  {C_DIM}ℹ{C_RESET} Socket Herdr sin sesión activa en {h_sock}")

    # ── [6/6] Resumen Operativo de Flota ─────────────────────────────────────────
    print(f"\n[{C_BOLD}{C_CYAN}6/6{C_RESET}] {C_BOLD}Resumen Operativo de Flota{C_RESET}")

    tier_counts = {"ULTRA": 0, "PRO": 0, "ENT": 0, "FREE": 0}
    locked_info: list[str] = []
    for al in aliases:
        acc_d = loaded_accounts.get(al) or load_account(al) or {}
        q_d = acc_d.get("quota") or {}
        pt = str(q_d.get("plan_type") or acc_d.get("plan_type") or "FREE").upper()
        tier_counts[pt if pt in tier_counts else "FREE"] += 1
        if acc_d.get("locked"):
            rsn = (acc_d.get("lock_reason") or acc_d.get("note") or "").strip()
            locked_info.append(f"{al} ({rsn})" if rsn else al)

    active_panes_map = scan_active_herdr_panes(real_home)
    total_agy_panes = sum(len(v) for v in active_panes_map.values())

    tier_parts = [f"{C_MAGENTA}{tier_counts['ULTRA']} ULTRA{C_RESET}", f"{C_CYAN}{tier_counts['PRO']} PRO{C_RESET}"]
    if tier_counts["ENT"]:
        tier_parts.append(f"{tier_counts['ENT']} ENT")
    if tier_counts["FREE"]:
        tier_parts.append(f"{tier_counts['FREE']} FREE")

    print(f"  • Cuentas totales:     {C_BOLD}{len(aliases)}{C_RESET} ({', '.join(tier_parts)})")
    if locked_info:
        print(f"  • Cuentas reservadas:  {C_YELLOW}{len(locked_info)}{C_RESET} -> {', '.join(locked_info)}")
    else:
        print(f"  • Cuentas reservadas:  0 {C_DIM}(todas elegibles según política PRO/ULTRA){C_RESET}")

    if active_panes_map:
        by_acc_str = ", ".join(
            f"{C_GREEN}{al}{C_RESET} ({','.join(p['short_pane'] for p in plist)})"
            for al, plist in sorted(active_panes_map.items())
        )
        print(f"  • Paneles agy vivos:   {C_BOLD}{total_agy_panes}{C_RESET} en {len(active_panes_map)} cuenta(s) -> {by_acc_str}")
    else:
        print(f"  • Paneles agy vivos:   0")

    print(f"\n{C_DIM}{'-' * 78}{C_RESET}")
    if fix:
        freed_suffix = f" | {freed_npm_bytes / (1024.0 * 1024.0):.2f} MB liberados" if freed_npm_bytes > 0 else ""
        if issues_found == 0:
            print(f"{C_BOLD}{C_GREEN}✓ Doctor completado: {fixes_applied} reparación(es) aplicada(s){freed_suffix}. Flota 100% saludable.{C_RESET}\n")
        else:
            print(
                f"{C_BOLD}{C_YELLOW}⚠ Doctor aplicó {fixes_applied} reparación(es){freed_suffix}; "
                f"quedan {issues_found} observación(es) manual(es).{C_RESET}\n"
            )
    else:
        if issues_found == 0:
            print(f"{C_BOLD}{C_GREEN}✓ Flota 100% saludable (0 observaciones pendientes).{C_RESET}\n")
        else:
            print(
                f"{C_BOLD}{C_YELLOW}⚠ Se detectaron {issues_found} observación(es). "
                f"Ejecuta '{C_CYAN}agyc doctor --fix{C_YELLOW}' para auto-reparar.{C_RESET}\n"
            )


def _verify_sha512(file_path: str, expected: str) -> bool:
    exp = (expected or "").strip()
    if not exp:
        return True
    if exp.lower().startswith("sha512-"):
        exp = exp[7:].strip()
    h = hashlib.sha512()
    with open(file_path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    digest_bytes = h.digest()
    digest_hex = digest_bytes.hex()
    digest_b64 = base64.b64encode(digest_bytes).decode("ascii")
    if re.fullmatch(r"[0-9a-fA-F]{128}", exp):
        return hmac.compare_digest(digest_hex.lower(), exp.lower())
    return hmac.compare_digest(digest_b64.rstrip("="), exp.rstrip("="))


def cmd_update(args):
    real_home = resolve_real_home()
    print(f"\n{C_BOLD}{C_WHITE}ACTUALIZADOR DE AGYC Y ANTIGRAVITY (v1.6){C_RESET}")
    print(f"{C_DIM}{'=' * 68}{C_RESET}\n")

    self_repo = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    repo_candidates = [
        self_repo,
        os.path.join(real_home, "proyectos", "agyc-antigravity-cli-switcher"),
        os.path.join(real_home, "proyectos", "agyc"),
        os.path.join(real_home, "proyectos", "antigravity-switcher"),
    ]
    repo_dir = os.path.join(real_home, "proyectos", "agyc-antigravity-cli-switcher")
    for cand in repo_candidates:
        if cand and os.path.isdir(os.path.join(cand, ".git")):
            repo_dir = cand
            break

    repo_bin = os.path.join(repo_dir, "bin")
    bin_src = os.path.join(repo_bin, "agyc") if os.path.exists(os.path.join(repo_bin, "agyc")) else __file__

    # 1. Comprobar repositorio en GitHub
    print(f"[{C_CYAN}1/4{C_RESET}] Comprobando repositorio en GitHub...")
    if os.path.isdir(os.path.join(repo_dir, ".git")):
        try:
            r = subprocess.run(["git", "-C", repo_dir, "pull"], capture_output=True, text=True, timeout=15)
            if "Already up to date" in r.stdout or "Ya está actualizado" in r.stdout:
                print(f"  {C_GREEN}✓ Repositorio git ya está al día.{C_RESET}")
            else:
                print(f"  {C_GREEN}✓ Repositorio actualizado desde GitHub:{C_RESET}")
                for l in r.stdout.strip().split("\n")[:3]:
                    if l.strip():
                        print(f"    {C_DIM}{l}{C_RESET}")
        except Exception as e:
            print(f"  {C_YELLOW}⚠ Git pull omitido: {e}{C_RESET}")
    else:
        try:
            url = "https://raw.githubusercontent.com/russbellc/agyc-antigravity-cli-switcher/main/bin/agyc"
            with urllib.request.urlopen(url, timeout=10) as resp:
                code = resp.read().decode("utf-8")
                if "agyc" in code and len(code) > 10000:
                    self_path = os.path.abspath(__file__)
                    tmp_self = f"{self_path}.tmp.{os.getpid()}"
                    with open(tmp_self, "w", encoding="utf-8") as f:
                        f.write(code)
                    if not platform.IS_WINDOWS:
                        os.chmod(tmp_self, 0o755)
                    os.replace(tmp_self, self_path)
                    print(f"  {C_GREEN}✓ Binario agyc actualizado desde GitHub.{C_RESET}")
        except Exception as e:
            print(f"  {C_YELLOW}⚠ Descarga omitida: {e}{C_RESET}")

    # 2. Sincronizar agyc, wrappers, statusline, titleline, topbar y lib/ (incl. lib/platform/)
    print(f"\n[{C_CYAN}2/4{C_RESET}] Sincronizando binarios, librería core, wrappers, statusline, titleline y topbar...")
    gemini_bin = os.path.join(real_home, ".gemini", "antigravity-cli", "bin")
    os.makedirs(gemini_bin, exist_ok=True)

    if platform.IS_WINDOWS:
        for bdir in _windows_bin_dirs(real_home):
            os.makedirs(bdir, exist_ok=True)
        for synced_lib in _sync_agyc_lib_dirs(repo_dir, real_home):
            print(f"  {C_GREEN}✓{C_RESET} {synced_lib}")
        sync_launchers(force=True)
        for bdir in _windows_bin_dirs(real_home):
            print(f"  {C_GREEN}✓{C_RESET} Wrappers .cmd sincronizados en {bdir}")
    else:
        snap_bin = os.path.join(real_home, "snap", "antigravity-cli", "common", ".gemini", "antigravity-cli", "bin")
        local_bin = os.path.join(real_home, ".local", "bin")
        backup_bin = os.path.join(real_home, "proyectos", "backup_agyc", "bin")

        os.makedirs(local_bin, exist_ok=True)

        target_bin_dirs = [gemini_bin, snap_bin, local_bin, backup_bin]
        managed_bins = ["agyc", "agy", "agyc-statusline", "agyc-topbar"]

        for bname in managed_bins:
            src_path = os.path.join(repo_bin, bname)
            if bname == "agyc" and not os.path.exists(src_path):
                src_path = bin_src
            if not os.path.exists(src_path):
                continue
            for tdir in target_bin_dirs:
                if os.path.isdir(tdir):
                    dst_path = os.path.join(tdir, bname)
                    if _copy_executable(src_path, dst_path):
                        print(f"  {C_GREEN}✓{C_RESET} {dst_path}")

        for synced_lib in _sync_agyc_lib_dirs(repo_dir, real_home):
            print(f"  {C_GREEN}✓{C_RESET} {synced_lib}")

        # Symlink agyc-titleline -> agyc-statusline en ~/.gemini/antigravity-cli/bin, snap y ~/.local/bin
        for tdir in [gemini_bin, snap_bin, local_bin]:
            if not os.path.isdir(tdir):
                continue
            sl_path = os.path.join(tdir, "agyc-statusline")
            tl_path = os.path.join(tdir, "agyc-titleline")
            if os.path.exists(sl_path):
                try:
                    if os.path.lexists(tl_path):
                        os.unlink(tl_path)
                    os.symlink(sl_path, tl_path)
                    print(f"  {C_GREEN}✓{C_RESET} {tl_path} -> {sl_path}")
                except Exception:
                    pass

        # Sincronizar lanzadores agy01..agy15 y agi01..agi15 en ~/.local/bin y ~/.gemini/antigravity-cli/bin
        canonical_agyc = os.path.join(gemini_bin, "agyc")
        all_aliases = set(list_account_aliases())
        for i in range(1, 16):
            all_aliases.add(f"agy{i:02d}")
            all_aliases.add(f"agi{i:02d}")

        for al in sorted(all_aliases):
            lp = os.path.join(local_bin, al)
            try:
                if os.path.lexists(lp):
                    os.unlink(lp)
                os.symlink(canonical_agyc, lp)
            except Exception:
                _copy_executable(bin_src, lp)
        agi_local = os.path.join(local_bin, "agi")
        agy_local = os.path.join(local_bin, "agy")
        if os.path.exists(agy_local):
            try:
                if os.path.lexists(agi_local):
                    os.unlink(agi_local)
                os.symlink(agy_local, agi_local)
            except Exception:
                pass
        print(f"  {C_GREEN}✓{C_RESET} Lanzadores directos sincronizados en {local_bin}")

    # 3. Comprobar motor oficial de Google Antigravity CLI (agy-real)
    # IMPORTANTE: jamás sobrescribir ~/.local/bin/agy ni wrappers .cmd propios con el binario nativo.
    print(f"\n[{C_CYAN}3/4{C_RESET}] Comprobando motor oficial de Google Antigravity CLI...")
    native_bin = os.path.join(gemini_bin, "agy-real.exe" if platform.IS_WINDOWS else "agy-real")
    current_ver = None
    ver_probe_bin = native_bin if os.path.isfile(native_bin) else _find_real_agy_binary(real_home)
    if ver_probe_bin and os.path.exists(ver_probe_bin):
        try:
            ver_res = subprocess.run([ver_probe_bin, "--version"], capture_output=True, text=True, timeout=5)
            current_ver = (ver_res.stdout or ver_res.stderr or "").strip().splitlines()[0].strip()
        except Exception:
            pass

    if platform.IS_WINDOWS:
        # Limpiar cualquier agy-real.exe.old previo si ya no está bloqueado
        for old_cand in glob.glob(f"{native_bin}*.old"):
            try:
                os.unlink(old_cand)
            except OSError:
                pass

    try:
        manifest_name = "windows_amd64.json" if platform.IS_WINDOWS else "linux_amd64.json"
        manifest_url = f"https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/{manifest_name}"
        req = urllib.request.Request(manifest_url, headers={"User-Agent": "curl/7.88.1"})
        with urllib.request.urlopen(req, timeout=8) as resp:
            mani = json.loads(resp.read().decode("utf-8"))
            latest_ver = mani.get("version")
            download_url = mani.get("url")
            expected_sha512 = str(mani.get("sha512") or mani.get("sha512sum") or "").strip()

        needs_install = (not os.path.isfile(native_bin)) or (not current_ver or current_ver != latest_ver)
        if needs_install and download_url:
            native_parent = os.path.dirname(native_bin)
            os.makedirs(native_parent, exist_ok=True)
            tmp_update_dir = tempfile.mkdtemp(prefix=".agy-update-", dir=native_parent)
            try:
                tmp_bin = os.path.join(tmp_update_dir, f"agy-real.tmp.{os.getpid()}{'.exe' if platform.IS_WINDOWS else ''}")

                if platform.IS_WINDOWS:
                    import zipfile
                    reused_local = False
                    local_agy_exe = os.path.join(os.environ.get("LOCALAPPDATA", ""), "agy", "bin", "agy.exe")
                    if expected_sha512 and local_agy_exe and os.path.isfile(local_agy_exe):
                        try:
                            if _verify_sha512(local_agy_exe, expected_sha512):
                                shutil.copy2(local_agy_exe, tmp_bin)
                                reused_local = True
                                print(f"  {C_GREEN}✓ Integridad SHA-512 verificada desde binario local v{latest_ver}.{C_RESET}")
                        except Exception:
                            reused_local = False

                    if not reused_local:
                        print(f"  {C_CYAN}→ Descargando release oficial de Google Antigravity CLI v{latest_ver}...{C_RESET}")
                        scratch_dl = os.path.join(tmp_update_dir, "antigravity_cli_pkg")
                        dl_req = urllib.request.Request(download_url, headers={"User-Agent": "curl/7.88.1"})
                        with urllib.request.urlopen(dl_req, timeout=60) as dl_resp, open(scratch_dl, "wb") as out_f:
                            shutil.copyfileobj(dl_resp, out_f)

                        if download_url.lower().endswith(".zip") or zipfile.is_zipfile(scratch_dl):
                            with zipfile.ZipFile(scratch_dl, "r") as zf:
                                exe_members = [m for m in zf.infolist() if not m.is_dir() and m.filename.lower().endswith(".exe")]
                                target_m = next(
                                    (
                                        m for m in exe_members
                                        if os.path.basename(m.filename).lower() in ("antigravity.exe", "agy.exe", "agy-real.exe", "cli_windows_x64.exe")
                                    ),
                                    exe_members[0] if exe_members else None,
                                )
                                if not target_m:
                                    raise RuntimeError("No se encontró el binario '.exe' dentro del paquete ZIP oficial.")
                                with zf.open(target_m, "r") as zstream, open(tmp_bin, "wb") as bin_f:
                                    shutil.copyfileobj(zstream, bin_f)
                        else:
                            shutil.move(scratch_dl, tmp_bin)

                        if expected_sha512:
                            if not ((os.path.exists(scratch_dl) and _verify_sha512(scratch_dl, expected_sha512)) or _verify_sha512(tmp_bin, expected_sha512)):
                                raise RuntimeError("Verificación de integridad SHA-512 fallida; actualización abortada.")
                            print(f"  {C_GREEN}✓ Integridad SHA-512 verificada.{C_RESET}")

                    try:
                        os.replace(tmp_bin, native_bin)
                    except PermissionError:
                        old_bin = f"{native_bin}.old"
                        if os.path.exists(old_bin):
                            try:
                                os.unlink(old_bin)
                            except OSError:
                                old_bin = f"{native_bin}.{time.time_ns()}.old"
                        os.replace(native_bin, old_bin)
                        os.replace(tmp_bin, native_bin)
                    print(f"  {C_GREEN}✓ Antigravity CLI actualizado a v{latest_ver} ({native_bin}){C_RESET}")
                else:
                    print(f"  {C_CYAN}→ Descargando release oficial de Google Antigravity CLI v{latest_ver}...{C_RESET}")
                    import tarfile
                    scratch_tar = os.path.join(tmp_update_dir, "antigravity_cli.tar.gz")
                    dl_req = urllib.request.Request(download_url, headers={"User-Agent": "curl/7.88.1"})
                    with urllib.request.urlopen(dl_req, timeout=60) as dl_resp, open(scratch_tar, "wb") as out_f:
                        shutil.copyfileobj(dl_resp, out_f)

                    with tarfile.open(scratch_tar, "r:gz") as tar:
                        target_member = None
                        for member in tar.getmembers():
                            if os.path.basename(member.name) == "antigravity" and member.isfile():
                                target_member = member
                                break
                        if not target_member:
                            raise RuntimeError("No se encontró el binario 'antigravity' dentro del paquete oficial.")
                        extracted_stream = tar.extractfile(target_member)
                        if extracted_stream is None:
                            raise RuntimeError("No se pudo extraer el flujo del binario 'antigravity'.")
                        with extracted_stream, open(tmp_bin, "wb") as bin_f:
                            shutil.copyfileobj(extracted_stream, bin_f)

                    if expected_sha512:
                        if not (_verify_sha512(scratch_tar, expected_sha512) or _verify_sha512(tmp_bin, expected_sha512)):
                            raise RuntimeError("Verificación de integridad SHA-512 fallida; actualización abortada.")
                        print(f"  {C_GREEN}✓ Integridad SHA-512 verificada.{C_RESET}")

                    os.chmod(tmp_bin, 0o755)
                    os.replace(tmp_bin, native_bin)
                    print(f"  {C_GREEN}✓ Antigravity CLI actualizado atómicamente a v{latest_ver} ({native_bin}){C_RESET}")
            finally:
                shutil.rmtree(tmp_update_dir, ignore_errors=True)
        else:
            print(f"  {C_GREEN}✓ Antigravity CLI nativo en su última versión oficial: v{current_ver or '1.5.10'}{C_RESET}")
    except Exception as e:
        if current_ver:
            print(f"  {C_GREEN}✓ Antigravity CLI nativo instalado: v{current_ver}{C_RESET}")
        else:
            print(f"  {C_YELLOW}⚠ Aviso comprobando release oficial de Google: {e}{C_RESET}")

    # 4. Actualizar settings.json y perfiles aislados (~/.agyc_homes)
    print(f"\n[{C_CYAN}4/4{C_RESET}] Actualizando perfiles aislados (~/.agyc_homes) y hooks...")
    sync_account_symlinks()
    for al in list_account_aliases():
        try:
            prepare_isolated_home(al)
        except Exception:
            pass
    print(f"  {C_GREEN}✓ Perfiles aislados y hooks statusLine/title sincronizados.{C_RESET}")

    print(f"\n{C_BOLD}{C_GREEN}════════════════════════════════════════════════════════════════════{C_RESET}")
    print(f"{C_BOLD}{C_GREEN}  ✓ SISTEMA ACTUALIZADO AL 100% (agyc v1.6 — Pro / Ultra)           {C_RESET}")
    print(f"{C_BOLD}{C_GREEN}════════════════════════════════════════════════════════════════════{C_RESET}")
    print(f"• Motor unificado v1.5.10:  {C_BOLD}Google AI Pro / Ultra + Gemini 4 Carbon{C_RESET}")
    print(f"• Refresca cuotas en vivo:  {C_CYAN}agyc list -r{C_RESET}")
    print(f"• Rotación inteligente:     {C_CYAN}agyc auto [gemini|claude|carbon] [--allow-ultra]{C_RESET}")
    print(f"• Diagnóstico de flota:     {C_CYAN}agyc doctor [--fix]{C_RESET}\n")


BUNDLE_FORMAT_V1 = "agyc-bundle-v1"


def cmd_export(args):
    """Exporta una o todas las cuentas registradas a un bundle JSON portable (0600)."""
    raw_alias = getattr(args, "alias", None)
    accounts_dir = get_accounts_dir()
    exported_entries: list[dict] = []

    if raw_alias:
        try:
            alias = validate_alias(raw_alias)
        except ValueError as e:
            print(f"{C_RED}Error:{C_RESET} {e}")
            sys.exit(1)
        acc_path = os.path.join(accounts_dir, f"{alias}.json")
        if not os.path.isfile(acc_path):
            print(f"{C_RED}Error:{C_RESET} La cuenta '{alias}' no existe en {accounts_dir}.")
            sys.exit(1)
        acc_data = load_account(alias)
        if not isinstance(acc_data, dict):
            print(f"{C_RED}Error:{C_RESET} No se pudo leer la cuenta '{alias}' (JSON inválido).")
            sys.exit(1)
        exported_entries.append({"alias": alias, "account_data": acc_data})
    else:
        for fname in sorted(os.listdir(accounts_dir)):
            if not fname.endswith(".json") or fname == "config.json" or fname.startswith("_"):
                continue
            stem = fname[:-5]
            try:
                safe_alias = validate_alias(stem)
            except ValueError:
                continue
            acc_data = load_account(safe_alias)
            if isinstance(acc_data, dict):
                exported_entries.append({"alias": safe_alias, "account_data": acc_data})

        if not exported_entries:
            print(f"{C_RED}Error:{C_RESET} No hay cuentas válidas registradas para exportar.")
            sys.exit(1)

    out_path = getattr(args, "output", None)
    if not out_path:
        if len(exported_entries) == 1:
            out_path = f"agyc-{exported_entries[0]['alias']}.json"
        else:
            out_path = "agyc-accounts-bundle.json"

    bundle = {
        "format": BUNDLE_FORMAT_V1,
        "exported_at": datetime.now(timezone.utc).isoformat(),
        "accounts": exported_entries,
    }
    _atomic_write_json(out_path, bundle, mode=0o600, indent=2)

    aliases_str = ", ".join(e["alias"] for e in exported_entries)
    print(f"{C_BOLD}{C_GREEN}✓ Exportadas {len(exported_entries)} cuenta(s) ({aliases_str}) -> {out_path}{C_RESET}")
    print(
        f"{C_YELLOW}⚠ ADVERTENCIA DE SEGURIDAD:{C_RESET} Este archivo contiene tokens OAuth activos.\n"
        f"  Transfiérelo únicamente por un canal cifrado (ej. scp) y bórralo tras importarlo."
    )


def _activate_imported_account_if_needed(alias: str, acc_data: dict):
    """Configura active_account/default_account y token activo si no había cuenta activa."""
    cfg = load_config()
    if cfg.get("active_account"):
        return
    cfg["active_account"] = alias
    if not cfg.get("default_account"):
        cfg["default_account"] = alias
    save_config(cfg)
    token_data = acc_data.get("token_data")
    if isinstance(token_data, dict) and token_data:
        _atomic_write_json(get_active_token_path(), token_data, mode=0o600, indent=2)


def cmd_import(args):
    """Importa cuentas desde un bundle agyc-bundle-v1 y prepara sus HOMEs aislados."""
    bundle_path = args.file
    if not os.path.isfile(bundle_path):
        print(f"{C_RED}Error:{C_RESET} El archivo '{bundle_path}' no existe.")
        sys.exit(1)

    try:
        with open(bundle_path, "r", encoding="utf-8") as f:
            bundle = json.load(f)
    except Exception as e:
        print(f"{C_RED}Error:{C_RESET} No se pudo leer el bundle '{bundle_path}': {e}")
        sys.exit(1)

    if not isinstance(bundle, dict) or bundle.get("format") != BUNDLE_FORMAT_V1:
        print(f"{C_RED}Error:{C_RESET} Formato de bundle inválido (se esperaba '{BUNDLE_FORMAT_V1}').")
        sys.exit(1)

    entries = bundle.get("accounts")
    if not isinstance(entries, list) or not entries:
        print(f"{C_RED}Error:{C_RESET} El bundle no contiene cuentas para importar.")
        sys.exit(1)

    raw_override = getattr(args, "alias", None)
    override_alias: str | None = None
    if raw_override is not None:
        try:
            override_alias = validate_alias(raw_override)
        except ValueError as e:
            print(f"{C_RED}Error:{C_RESET} {e}")
            sys.exit(1)
        if len(entries) != 1:
            print(
                f"{C_RED}Error:{C_RESET} --alias solo puede usarse cuando el bundle contiene "
                f"exactamente 1 cuenta (tiene {len(entries)})."
            )
            sys.exit(1)

    overwrite = bool(getattr(args, "overwrite", False))
    imported: list[tuple[str, dict]] = []
    skipped: list[str] = []

    for entry in entries:
        if not isinstance(entry, dict) or not isinstance(entry.get("account_data"), dict):
            print(f"{C_RED}Error:{C_RESET} Entrada de cuenta inválida dentro del bundle.")
            sys.exit(1)

        raw_entry_alias = override_alias if override_alias else entry.get("alias")
        try:
            target_alias = validate_alias(raw_entry_alias)
        except ValueError as e:
            print(f"{C_RED}Error:{C_RESET} {e}")
            sys.exit(1)

        acc_data = dict(entry["account_data"])
        email = acc_data.get("email")

        existing_by_alias = load_account(target_alias)
        dup_email_alias = _find_alias_by_email(email)
        has_conflict = (existing_by_alias is not None) or (
            dup_email_alias is not None and dup_email_alias != target_alias
        )

        if has_conflict and not overwrite:
            conflict_ref = target_alias if existing_by_alias is not None else dup_email_alias
            print(
                f"{C_YELLOW}Aviso:{C_RESET} Omitiendo '{target_alias}' ({email or 'sin email'}): "
                f"ya existe como '{conflict_ref}'. Usa --overwrite para reemplazar."
            )
            skipped.append(target_alias)
            continue

        save_account(target_alias, acc_data, sync_links=False)
        prepare_isolated_home(target_alias)
        imported.append((target_alias, acc_data))
        print(f"{C_GREEN}✓ Importada cuenta '{target_alias}' ({email or 'sin email'}).{C_RESET}")

    if imported:
        sync_launchers()
        first_alias, first_data = imported[0]
        _activate_imported_account_if_needed(first_alias, first_data)
        print(f"{C_BOLD}{C_GREEN}✓ Importación completada: {len(imported)} cuenta(s) importada(s).{C_RESET}")

    if not imported and skipped:
        print(f"{C_RED}Error:{C_RESET} No se importó ninguna cuenta (duplicados omitidos sin --overwrite).")
        sys.exit(1)


def main():
    prog_name = os.path.basename(sys.argv[0])
    for ext in (".cmd", ".exe", ".bat"):
        if prog_name.lower().endswith(ext):
            prog_name = prog_name[: -len(ext)]
            break
    invoked_as = os.environ.pop("AGYC_INVOKED_AS", "").strip()
    if invoked_as:
        prog_name = invoked_as

    # 1. Lanzamiento directo por alias invocado como comando: 'agy01', 'agy02', 'agi05', etc.
    #    Arranque instantáneo (<50ms): prepara HOME aislado y refresca token solo si expira en <300s,
    #    SIN mutar active_account global ni bloquear con fetch_quota_summary síncrono.
    m_prog = re.match(r"^(?:agy|agi)(\d+)$", prog_name, re.IGNORECASE)
    if m_prog:
        alias = f"agy{int(m_prog.group(1)):02d}"
        data = load_account(alias)
        if not data:
            print(f"{C_RED}Error:{C_RESET} La cuenta '{alias}' aún no está registrada.")
            print(f"Ejecuta {C_CYAN}agyc add{C_RESET} para registrarla.")
            sys.exit(1)
        sys_argv_to_pass = [a for a in sys.argv[1:] if a not in ("-y", "--yes", "-f", "--force")]

        token_data = data.get("token_data", {})
        if _token_needs_refresh(token_data, margin_seconds=300):
            try:
                token_data, _ = refresh_token_if_needed(token_data, force=False, alias=alias)
                data["token_data"] = token_data
            except TokenRevokedError:
                print(
                    f"\n{C_BOLD}{C_RED}Error: El token de Google para '{alias}' ({data.get('email')}) "
                    f"expiró o fue revocado (invalid_grant).{C_RESET}"
                )
                print(f"\n{C_BOLD}Solución:{C_RESET} Re-vincula la cuenta ejecutando:")
                print(f"  {C_GREEN}agyc renew {alias}{C_RESET}\n")
                sys.exit(1)
            except Exception as e:
                print(f"{C_YELLOW}Aviso al refrescar token de '{alias}':{C_RESET} {e}")

        print(f"{C_BOLD}{C_GREEN}✓ Entrando a cuenta {alias} ({data.get('email')}) [modo: --dangerously-skip-permissions]...{C_RESET}\n")
        launch_real_agy(sys_argv_to_pass, alias=alias)
        return

    is_doctor_cmd = len(sys.argv) >= 2 and sys.argv[1] == "doctor"
    if not is_doctor_cmd:
        sync_account_symlinks()

    # 2. Ejecución directa 'agyc <alias>' para switch rápido
    if len(sys.argv) == 2 and not sys.argv[1].startswith("-"):
        candidate = normalize_alias(sys.argv[1]) or sys.argv[1]
        if candidate.lower() not in RESERVED_ALIASES and candidate in list_account_aliases():
            class DirectSwitchArgs:
                alias = candidate
            cmd_switch(DirectSwitchArgs())
            return

    parser = argparse.ArgumentParser(
        prog="agyc",
        description="Administrador multi-cuenta de Google Antigravity (Pro / Ultra — agyc v1.6)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="subcommand", help="Comandos disponibles")

    # list
    p_list = subparsers.add_parser("list", help="Lista todas las cuentas, planes, paneles vivos y barras de consumo")
    p_list.add_argument("-r", "--refresh", action="store_true", help="Forzar actualización en paralelo desde Google")
    p_list.add_argument("--json", action="store_true", help="Salida en formato JSON sanitizada (sin secretos)")
    p_list.set_defaults(func=cmd_list)

    # switch / use
    p_switch = subparsers.add_parser("switch", aliases=["use"], help="Cambia a la cuenta indicada")
    p_switch.add_argument("alias", help="Alias de la cuenta (ej. agy01, agy02)")
    p_switch.set_defaults(func=cmd_switch)

    # default / set-default
    p_default = subparsers.add_parser("default", aliases=["set-default"], help="Fija la cuenta predefinida para agy")
    p_default.add_argument("alias", help="Alias de la cuenta predefinida")
    p_default.set_defaults(func=cmd_default)

    # add
    p_add = subparsers.add_parser("add", aliases=["renew", "reauth", "login"], help="Registra o renueva una cuenta (ej. agyc renew agy03)")
    p_add.add_argument("alias", nargs="?", default=None, help="Alias opcional (por defecto correlativo automático)")
    p_add.add_argument("-f", "--force", action="store_true", help="Forzar sobrescritura aunque difiera el email registrado")
    p_add.set_defaults(func=cmd_add)

    # capture
    p_capture = subparsers.add_parser("capture", aliases=["import-current"], help="Guarda la sesión actual activa en agy")
    p_capture.add_argument("alias", nargs="?", default=None, help="Alias opcional (por defecto correlativo)")
    p_capture.set_defaults(func=cmd_capture)

    # remove / rm
    p_rm = subparsers.add_parser("remove", aliases=["rm"], help="Elimina una cuenta guardada, su caché y su HOME aislado")
    p_rm.add_argument("alias", help="Alias de la cuenta a eliminar")
    p_rm.set_defaults(func=cmd_remove)

    # quota
    p_quota = subparsers.add_parser("quota", help="Muestra el reporte detallado de plan, Carbon y grupos de cuota")
    p_quota.add_argument("alias", nargs="?", default=None, help="Alias de la cuenta (por defecto la activa)")
    p_quota.set_defaults(func=cmd_quota)

    # auto
    p_auto = subparsers.add_parser(
        "auto",
        help="Auto-switch inteligente (Reserva ULTRA + Burn-First + Anti-colisión)",
    )
    p_auto.add_argument(
        "family",
        nargs="?",
        default=None,
        help="Familia/modo: gemini (argon/hydrogen/flash), claude (gpt/3p) o carbon (ultra)",
    )
    p_auto.add_argument(
        "--allow-ultra",
        action="store_true",
        help="Permitir seleccionar cuentas ULTRA en gemini/claude aunque existan cuentas PRO saludables",
    )
    p_auto.set_defaults(func=cmd_auto)

    # lock / unlock
    p_lock = subparsers.add_parser("lock", help="Marca una cuenta como reservada para que 'agyc auto' no la seleccione")
    p_lock.add_argument("alias", help="Alias de la cuenta a reservar (ej. agy10)")
    p_lock.add_argument("reason", nargs="*", default=[], help="Motivo opcional de reserva (ej. 'Carbon dedicado')")
    p_lock.add_argument("-m", "--note", dest="note_opt", default=None, help="Nota/motivo opcional de reserva")
    p_lock.set_defaults(func=cmd_lock)

    p_unlock = subparsers.add_parser("unlock", help="Desbloquea una cuenta reservada para 'agyc auto'")
    p_unlock.add_argument("alias", help="Alias de la cuenta a liberar")
    p_unlock.set_defaults(func=cmd_unlock)

    # note / tag / label
    p_note = subparsers.add_parser(
        "note",
        aliases=["tag", "label"],
        help="Asigna o limpia una etiqueta/nota visible en 'agyc list' para una cuenta",
    )
    p_note.add_argument("alias", help="Alias de la cuenta (ej. agy05)")
    p_note.add_argument("text", nargs="*", default=[], help="Texto de la nota (o '' / --clear para limpiar)")
    p_note.add_argument("-c", "--clear", action="store_true", help="Limpiar la nota de la cuenta")
    p_note.set_defaults(func=cmd_note)

    # doctor
    p_doctor = subparsers.add_parser(
        "doctor",
        help="Diagnóstico integral [1/6..6/6] y auto-reparación segura (--fix) de la flota",
    )
    p_doctor.add_argument("--fix", action="store_true", help="Auto-reparar permisos, symlinks, hooks y cachés .npm duplicadas")
    p_doctor.set_defaults(func=cmd_doctor)

    # wipe / clean / purge
    p_wipe = subparsers.add_parser("wipe", aliases=["clean", "purge"], help="Vacía todas las credenciales, tokens aislados y caché")
    p_wipe.add_argument("-f", "--force", "-y", "--yes", action="store_true", dest="force", help="Omitir confirmación interactiva")
    p_wipe.set_defaults(func=cmd_wipe)

    # update / upgrade
    p_update = subparsers.add_parser("update", aliases=["upgrade"], help="Actualiza agyc, librería core, wrappers y Antigravity CLI")
    p_update.set_defaults(func=cmd_update)

    # export
    p_export = subparsers.add_parser("export", help="Exporta una o todas las cuentas a un bundle JSON portable")
    p_export.add_argument("alias", nargs="?", default=None, help="Alias opcional de la cuenta a exportar (por defecto todas)")
    p_export.add_argument("-o", "--output", dest="output", default=None, help="Archivo de salida del bundle")
    p_export.set_defaults(func=cmd_export)

    # import
    p_import = subparsers.add_parser("import", help="Importa cuentas desde un bundle JSON generado por 'agyc export'")
    p_import.add_argument("file", help="Ruta al archivo bundle JSON")
    p_import.add_argument("--alias", dest="alias", default=None, help="Nuevo alias (solo válido si el bundle contiene 1 cuenta)")
    p_import.add_argument("--overwrite", action="store_true", help="Reemplazar cuentas existentes con el mismo alias o email")
    p_import.set_defaults(func=cmd_import)

    args = parser.parse_args()

    if not args.subcommand:
        class DefaultListArgs:
            refresh = False
            json = False
        cmd_list(DefaultListArgs())
    else:
        args.func(args)


if __name__ == "__main__":
    main()
