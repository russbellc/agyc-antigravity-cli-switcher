def strip_ansi(s: str) -> str:
    return ANSI_REGEX.sub("", str(s))


def _char_display_width(ch: str) -> int:
    import unicodedata
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def visible_len(s: str) -> int:
    return sum(_char_display_width(ch) for ch in strip_ansi(s))


def truncate_visible(s: str, max_len: int) -> str:
    clean = strip_ansi(s)
    if visible_len(clean) <= max_len:
        return clean
    if max_len <= 1:
        return "…" if max_len == 1 else ""
    out = []
    acc = 0
    for ch in clean:
        w = _char_display_width(ch)
        if acc + w > max_len - 1:
            break
        out.append(ch)
        acc += w
    return "".join(out) + "…"


def pad_visible(s: str, width: int, align: str = "left") -> str:
    vlen = visible_len(s)
    pad = max(0, width - vlen)
    if align == "right":
        return (" " * pad) + s
    elif align == "center":
        l_pad = pad // 2
        r_pad = pad - l_pad
        return (" " * l_pad) + s + (" " * r_pad)
    else:
        return s + (" " * pad)


def _strip_agyc_homes_pre(path: str) -> str:
    p = (path or "").strip()
    if not p:
        return ""
    norm = p.replace("\\", "/")
    if "/.agyc_homes/" in norm:
        p = p[: norm.find("/.agyc_homes/")]
    elif norm.rstrip("/").endswith("/.agyc_homes"):
        p = p[: norm.rstrip("/").rfind("/.agyc_homes")]
    if len(p) == 3 and p[1] == ":" and p[2] in ("/", "\\"):
        return p
    stripped = p.rstrip("/\\")
    if not stripped:
        return "/" if p.startswith("/") else p
    if len(stripped) == 2 and stripped[1] == ":":
        return stripped + os.sep
    return stripped


def _pre_resolve_home() -> str:
    for env_key in ("AGYC_REAL_HOME", "REAL_HOME", "USERPROFILE", "HOME"):
        val = os.environ.get(env_key, "").strip()
        if val and val != "~":
            cleaned = _strip_agyc_homes_pre(val)
            if cleaned and os.path.isdir(cleaned):
                return cleaned
    try:
        expanded = os.path.expanduser("~")
        if expanded and expanded != "~":
            cleaned_exp = _strip_agyc_homes_pre(expanded)
            if cleaned_exp and os.path.isdir(cleaned_exp):
                return cleaned_exp
    except Exception:
        pass
    return os.environ.get("SystemDrive", "C:") + os.sep if os.name == "nt" else "/tmp"


def _candidate_lib_dirs() -> list[str]:
    pre_home = _pre_resolve_home()
    cands = [
        os.path.normpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib")),
        os.path.join(pre_home, ".gemini", "antigravity-cli", "lib"),
    ]
    if os.name == "nt":
        la = os.environ.get("LOCALAPPDATA", "").strip()
        if la:
            cands.insert(1, os.path.join(la, "agyc", "lib"))
    else:
        cands.append("/home/aidev/proyectos/agyc-antigravity-cli-switcher/lib")
        cands.append(
            os.path.join(
                pre_home,
                "snap",
                "antigravity-cli",
                "common",
                ".gemini",
                "antigravity-cli",
                "lib",
            )
        )
    return cands


class _FallbackFileLock:
    def __init__(self, fd: int) -> None:
        self._fd: int | None = fd

    def release(self) -> None:
        if self._fd is None:
            return
        fd = self._fd
        self._fd = None
        try:
            if os.name == "nt":
                import msvcrt
                os.lseek(fd, 0, os.SEEK_SET)
                msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
            else:
                import fcntl
                fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        try:
            os.close(fd)
        except OSError:
            pass

    def __enter__(self):
        return self

    def __exit__(self, *args) -> None:
        self.release()


class _FallbackPlatform:
    IS_WINDOWS: bool = os.name == "nt"

    @staticmethod
    def _has_agyc_homes_segment(path: str) -> bool:
        s = (path or "").strip().replace("\\", "/")
        return bool(s) and ("/.agyc_homes/" in s or s.rstrip("/").endswith("/.agyc_homes") or s == ".agyc_homes")

    @staticmethod
    def _strip_agyc_homes(path: str) -> str:
        return _strip_agyc_homes_pre(path)

    @staticmethod
    def resolve_real_home() -> str:
        return _pre_resolve_home()

    @staticmethod
    def ensure_private_dir(path: str, mode: int = 0o700) -> str:
        if os.name == "nt":
            os.makedirs(path, exist_ok=True)
        else:
            os.makedirs(path, mode=mode, exist_ok=True)
            try:
                os.chmod(path, mode)
            except OSError:
                pass
        return path

    @staticmethod
    def ensure_private_file(path: str, mode: int = 0o600) -> str:
        parent = os.path.dirname(os.path.abspath(path))
        if parent:
            _FallbackPlatform.ensure_private_dir(parent, 0o700)
        if not os.path.exists(path):
            fd = os.open(path, os.O_WRONLY | os.O_CREAT, mode)
            os.close(fd)
        if os.name != "nt":
            try:
                os.chmod(path, mode)
            except OSError:
                pass
        return path

    @staticmethod
    def harden_ntfs_acl(path: str) -> bool:
        return os.path.exists(path)

    @staticmethod
    def get_base_dir(real_home: str | None = None) -> str:
        rh = _strip_agyc_homes_pre(real_home) if real_home else _pre_resolve_home()
        for c in (
            os.environ.get("ANTIGRAVITY_HOME") if real_home is None else None,
            os.environ.get("AGY_CONFIG_DIR") if real_home is None else None,
            os.path.join(rh, ".gemini", "antigravity-cli"),
        ):
            if c and not _FallbackPlatform._has_agyc_homes_segment(c) and os.path.exists(c):
                return _strip_agyc_homes_pre(c)
        return _FallbackPlatform.ensure_private_dir(os.path.join(rh, ".gemini", "antigravity-cli"), 0o700)

    @staticmethod
    def get_cache_dir(real_home: str | None = None) -> str:
        rh = _strip_agyc_homes_pre(real_home) if real_home else _pre_resolve_home()
        if os.name == "nt":
            la = os.environ.get("LOCALAPPDATA", "").strip()
            if la and not _FallbackPlatform._has_agyc_homes_segment(la):
                return _FallbackPlatform.ensure_private_dir(os.path.join(la, "agyc", "cache"), 0o700)
        return _FallbackPlatform.ensure_private_dir(os.path.join(rh, ".cache", "agyc"), 0o700)

    @staticmethod
    def get_locks_dir(real_home: str | None = None) -> str:
        return _FallbackPlatform.ensure_private_dir(os.path.join(_FallbackPlatform.get_cache_dir(real_home), "locks"), 0o700)

    @staticmethod
    def get_run_dir(real_home: str | None = None) -> str:
        return _FallbackPlatform.ensure_private_dir(os.path.join(_FallbackPlatform.get_cache_dir(real_home), "run"), 0o700)

    @staticmethod
    def create_dir_link(src: str, dst: str) -> None:
        parent = os.path.dirname(os.path.abspath(dst))
        if parent:
            os.makedirs(parent, exist_ok=True)
        if os.name == "nt":
            res = subprocess.run(["cmd", "/c", "mklink", "/J", os.path.abspath(dst), os.path.abspath(src)], capture_output=True)
            if res.returncode != 0:
                raise OSError("mklink /J failed")
        else:
            os.symlink(src, dst)

    @staticmethod
    def is_dir_link(path: str) -> bool:
        is_junc = getattr(os.path, "isjunction", None)
        return bool(os.path.islink(path) or (is_junc is not None and is_junc(path)))

    @staticmethod
    def read_dir_link(path: str) -> str:
        t = os.readlink(path)
        return t[4:] if t.startswith("\\\\?\\") else t

    @staticmethod
    def create_file_link(src: str, dst: str) -> None:
        parent = os.path.dirname(os.path.abspath(dst))
        if parent:
            os.makedirs(parent, exist_ok=True)
        if os.name == "nt":
            try:
                os.link(src, dst)
            except OSError:
                shutil.copy2(src, dst)
        else:
            os.symlink(src, dst)

    @staticmethod
    def acquire_file_lock(lock_path: str, blocking: bool = True) -> _FallbackFileLock:
        parent = os.path.dirname(os.path.abspath(lock_path))
        if parent:
            _FallbackPlatform.ensure_private_dir(parent, 0o700)
        fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
        try:
            if os.name == "nt":
                import msvcrt
                if os.fstat(fd).st_size == 0:
                    os.write(fd, b"\0")
                os.lseek(fd, 0, os.SEEK_SET)
                msvcrt.locking(fd, msvcrt.LK_LOCK if blocking else msvcrt.LK_NBLCK, 1)
            else:
                import fcntl
                fcntl.flock(fd, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
            return _FallbackFileLock(fd)
        except BaseException:
            os.close(fd)
            raise

    @staticmethod
    def default_herdr_socket_path(real_home: str | None = None) -> str:
        rh = _strip_agyc_homes_pre(real_home) if real_home else _pre_resolve_home()
        if os.name == "nt":
            ad = os.environ.get("APPDATA", "").strip()
            if ad:
                return os.path.join(ad, "herdr", "herdr.sock")
        return os.environ.get("HERDR_SOCKET_PATH") or os.path.join(rh, ".config", "herdr", "herdr.sock")

    @staticmethod
    def query_herdr_ipc(sock_path: str | None, payload_dict: dict, timeout: float = 0.06) -> dict | None:
        del sock_path, payload_dict, timeout
        return None

    @staticmethod
    def scan_agy_processes(proc_root: str = "/proc", run_dir: str | None = None) -> list[dict]:
        del proc_root, run_dir
        return []


def _load_platform_and_core():
    plat_mod = None
    core_mod = None
    for lib_dir in _candidate_lib_dirs():
        if not lib_dir or not os.path.isdir(lib_dir):
            continue
        parent_dir = os.path.dirname(lib_dir)
        if parent_dir and parent_dir not in sys.path:
            sys.path.insert(0, parent_dir)
        if plat_mod is None and os.path.isfile(os.path.join(lib_dir, "platform", "__init__.py")):
            try:
                from lib import platform as p_cand  # type: ignore
                if hasattr(p_cand, "resolve_real_home"):
                    plat_mod = p_cand
            except Exception:
                pass
            if plat_mod is None:
                try:
                    import importlib.util
                    plat_dir = os.path.join(lib_dir, "platform")
                    spec = importlib.util.spec_from_file_location(
                        "_agyc_platform",
                        os.path.join(plat_dir, "__init__.py"),
                        submodule_search_locations=[plat_dir],
                    )
                    if spec and spec.loader:
                        mod = importlib.util.module_from_spec(spec)
                        sys.modules["_agyc_platform"] = mod
                        spec.loader.exec_module(mod)
                        plat_mod = mod
                except Exception:
                    pass
        if core_mod is None and os.path.isfile(os.path.join(lib_dir, "agyc_core.py")):
            try:
                from lib import agyc_core as c_cand  # type: ignore
                if hasattr(c_cand, "compute_smart_auto_choice"):
                    core_mod = c_cand
            except Exception:
                pass
            if core_mod is None:
                try:
                    import importlib.util
                    spec = importlib.util.spec_from_file_location(
                        "agyc_core",
                        os.path.join(lib_dir, "agyc_core.py"),
                    )
                    if spec and spec.loader:
                        mod = importlib.util.module_from_spec(spec)
                        sys.modules["agyc_core"] = mod
                        spec.loader.exec_module(mod)
                        core_mod = mod
                except Exception:
                    pass
        if plat_mod is not None and core_mod is not None:
            break
    if plat_mod is None:
        plat_mod = _FallbackPlatform()
    return plat_mod, core_mod


platform, _agyc_core = _load_platform_and_core()


def _strip_agyc_homes(path: str) -> str:
    return platform._strip_agyc_homes(path)


def resolve_real_home() -> str:
    """Resuelve el HOME real del usuario dinámicamente, inmune a sesiones con HOME aislado en ~/.agyc_homes/."""
    return platform.resolve_real_home()


