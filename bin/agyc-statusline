#!/usr/bin/python3 -S
"""
agyc-statusline: Ultra-fast Live Statusline, Titleline & Herdr Metadata Reporter
for Antigravity CLI (agy 1.5.10+).

Modes:
  - Default (`agyc-statusline`): ANSI statusline + Herdr pane.report_metadata sync
  - Title (`agyc-statusline --title` or symlink `agyc-titleline`): plain-text OSC title line + Herdr sync
  - Background worker (`agyc-statusline --refresh-quota-bg <alias>`): parallel unified 1.5.10 quota fetcher
"""

import sys
import os
import json
import math
import time
from datetime import datetime, timezone, timedelta

if os.name == "nt":
    try:
        if hasattr(sys.stdout, "reconfigure"):
            sys.stdout.reconfigure(encoding="utf-8", errors="replace")
        if hasattr(sys.stderr, "reconfigure"):
            sys.stderr.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass


def _strip_agyc_homes_pre(raw: str) -> str:
    s = (raw or "").strip()
    if not s:
        return ""
    norm = s.replace("\\", "/")
    if "/.agyc_homes/" in norm:
        s = s[: norm.find("/.agyc_homes/")]
    elif norm.rstrip("/").endswith("/.agyc_homes"):
        s = s[: norm.rstrip("/").rfind("/.agyc_homes")]
    return s.rstrip("/\\") or ("/" if s.startswith("/") else s)


def _load_platform():
    real_here = os.path.dirname(os.path.realpath(__file__))
    candidates = [os.path.normpath(os.path.join(real_here, "..", "lib"))]
    if os.name == "nt":
        la = os.environ.get("LOCALAPPDATA", "").strip()
        if la:
            candidates.append(os.path.join(la, "agyc", "lib"))
    for env_k in ("AGYC_REAL_HOME", "REAL_HOME", "USERPROFILE", "HOME"):
        val = os.environ.get(env_k, "").strip()
        if val and val != "~":
            cleaned = _strip_agyc_homes_pre(val)
            if cleaned:
                candidates.append(os.path.join(cleaned, ".gemini", "antigravity-cli", "lib"))
    if os.name != "nt":
        exp = _strip_agyc_homes_pre(os.path.expanduser("~"))
        if exp and exp != "~":
            candidates.append(os.path.join(exp, ".gemini", "antigravity-cli", "lib"))
            candidates.append(os.path.join(exp, "snap", "antigravity-cli", "common", ".gemini", "antigravity-cli", "lib"))
        candidates.append("/home/aidev/proyectos/agyc-antigravity-cli-switcher/lib")

    for lib_dir in candidates:
        plat_init = os.path.join(lib_dir, "platform", "__init__.py")
        if not os.path.isfile(plat_init):
            continue
        parent_dir = os.path.dirname(lib_dir)
        if parent_dir and parent_dir not in sys.path:
            sys.path.insert(0, parent_dir)
        try:
            from lib import platform as mod  # type: ignore
            if hasattr(mod, "resolve_real_home"):
                return mod
        except Exception:
            pass
        try:
            import importlib.util
            plat_dir = os.path.join(lib_dir, "platform")
            spec = importlib.util.spec_from_file_location(
                "_agyc_platform",
                plat_init,
                submodule_search_locations=[plat_dir],
            )
            if spec and spec.loader:
                mod = importlib.util.module_from_spec(spec)
                sys.modules["_agyc_platform"] = mod
                spec.loader.exec_module(mod)
                return mod
        except Exception:
            pass
    return None


platform = _load_platform()
IS_WINDOWS: bool = bool(platform.IS_WINDOWS) if platform is not None else (os.name == "nt")

# ANSI Colors
C_RESET   = "\033[0m"
C_BOLD    = "\033[1m"
C_DIM     = "\033[2m"
C_GREEN   = "\033[38;5;48m"    # Bright green
C_CYAN    = "\033[38;5;51m"    # Electric cyan
C_BLUE    = "\033[38;5;75m"    # Soft blue
C_YELLOW  = "\033[38;5;220m"   # Gold/Yellow
C_ORANGE  = "\033[38;5;208m"   # Orange
C_RED     = "\033[38;5;196m"   # Bright red
C_MAGENTA = "\033[38;5;177m"   # Light purple/magenta (ULTRA badge)
C_PURPLE  = "\033[38;5;147m"   # Soft lavender/purple for models
C_GRAY    = "\033[38;5;244m"   # Muted gray

# OAuth credentials for token refresh (same as in agyc)
GOOGLE_CLIENT_ID     = "moc.tnetnocresuelgoog.sppa.pe304g4hjolotv532ercl12h2nisshmt-1950606001701"[::-1]
GOOGLE_CLIENT_SECRET = "fADq6z4CXs8BLm1JLdL684RWF85K-XPSCOG"[::-1]

# Unified Antigravity 1.5.10 User-Agent
ANTIGRAVITY_UA = "antigravity/1.5.10 (aidev_client; os_type=linux; arch=amd64; cl=999999999)"


def resolve_real_home() -> str:
    """Resolves real user HOME dynamically, immune to isolated ~/.agyc_homes/<alias> sessions."""
    if platform is not None:
        return platform.resolve_real_home()
    for env_key in ("AGYC_REAL_HOME", "REAL_HOME", "USERPROFILE", "HOME"):
        val = os.environ.get(env_key, "").strip()
        if val and val != "~":
            cleaned = _strip_agyc_homes_pre(val)
            if cleaned and os.path.isdir(cleaned):
                return cleaned
    return os.environ.get("SystemDrive", "C:") + os.sep if IS_WINDOWS else "/tmp"


REAL_HOME = resolve_real_home()
CACHE_DIR = platform.get_cache_dir(REAL_HOME) if platform is not None else os.path.join(REAL_HOME, ".cache", "agyc")
LOCKS_DIR = os.path.join(CACHE_DIR, "locks")

# Live refresh & throttle parameters
CACHE_TTL_SECONDS = 20
REFRESH_LOCK_SECONDS = 15
HERDR_META_THROTTLE_SECONDS = 8
HORIZON_5H_SECONDS = 5 * 3600 + 5 * 60  # 5h + 5m
LOW_QUOTA_THRESHOLD_PCT = 15
LOW_QUOTA_DEDUP_SECONDS = 5 * 3600      # 5h deduplication per reset cycle


def ensure_cache_dir(need_locks: bool = False) -> str:
    """Ensures cache dir (and optionally locks/) exists with private permissions."""
    if platform is not None:
        try:
            platform.ensure_private_dir(CACHE_DIR, 0o700)
            if need_locks:
                platform.ensure_private_dir(LOCKS_DIR, 0o700)
        except Exception:
            pass
        return CACHE_DIR
    try:
        os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
        if need_locks:
            os.makedirs(LOCKS_DIR, mode=0o700, exist_ok=True)
    except Exception:
        pass
    return CACHE_DIR


def safe_cache_key(raw: str) -> str:
    return "".join(ch if (ch.isalnum() or ch in "_.-") else "_" for ch in raw)


def extract_agy_alias(text: str) -> str | None:
    """Finds word-bounded agy01..agy99 in text without regex import overhead."""
    if not text:
        return None
    low = text.lower()
    idx = 0
    n = len(low)
    while True:
        pos = low.find("agy", idx)
        if pos == -1:
            return None
        if pos > 0 and (low[pos - 1].isalnum() or low[pos - 1] == "_"):
            idx = pos + 3
            continue
        end = pos + 3
        while end < n and low[end].isdigit():
            end += 1
        digits_len = end - (pos + 3)
        if 1 <= digits_len <= 2 and (end == n or not (low[end].isalnum() or low[end] == "_")):
            return low[pos:end]
        idx = pos + 3


def fmt_pct(frac: float | None) -> int:
    """Exact quota percentage without false 100%: >=0.9995 -> 100, else floor(frac * 100)."""
    if frac is None:
        return 100
    f = max(0.0, min(1.0, float(frac)))
    if f >= 0.9995:
        return 100
    if f <= 0.0:
        return 0
    return int(math.floor(f * 100.0))


def fmt_ctx_pct(frac: float | None) -> int:
    """Exact context percentage: 0 if <=0, 100 if >=0.9995, min(99, round(frac*100)) otherwise."""
    if frac is None:
        return 0
    f = float(frac)
    if f <= 0.0:
        return 0
    if f >= 0.9995:
        return 100
    return min(99, int(round(f * 100.0)))


def _safe_nonneg_int(val: object) -> int:
    if val is None or isinstance(val, bool):
        return 0
    try:
        return max(0, int(val))  # type: ignore[arg-type]
    except Exception:
        return 0


def parse_iso_utc(ts_str: str | None) -> datetime | None:
    """Parses ISO-8601 timestamp into UTC-aware datetime."""
    if not ts_str or not isinstance(ts_str, str):
        return None
    try:
        s = ts_str.strip()
        if s.endswith("Z"):
            s = s[:-1] + "+00:00"
        dt = datetime.fromisoformat(s)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt
    except Exception:
        return None


def normalize_quota_value(
    frac: float | None,
    reset_iso: str | None,
    now_dt: datetime | None = None,
    disabled: bool = False,
) -> tuple[float, str | None, bool]:
    """Normalizes (fraction, resetTime, disabled):
    - If resetTime <= now -> (1.0, None, False)
    - If frac >= 0.9995 -> (1.0, None, False)
    """
    if now_dt is None:
        now_dt = datetime.now(timezone.utc)
    if reset_iso:
        rst_dt = parse_iso_utc(reset_iso)
        if rst_dt is not None and rst_dt <= now_dt:
            return 1.0, None, False
    f = 1.0 if frac is None else max(0.0, min(1.0, float(frac)))
    if disabled:
        f = 0.0
    if f >= 0.9995:
        return 1.0, None, False
    return f, reset_iso, bool(disabled or f <= 0.0)


def atomic_write_json(path: str, data: dict, mode: int = 0o600, indent: int | None = None) -> None:
    """Atomically writes JSON with strict permissions via .tmp.{pid}.{ns} + os.replace."""
    parent = os.path.dirname(os.path.abspath(path))
    if parent:
        if platform is not None:
            platform.ensure_private_dir(parent, 0o700)
        else:
            os.makedirs(parent, mode=0o700, exist_ok=True)
    tmp_path = f"{path}.tmp.{os.getpid()}.{time.time_ns()}"
    fd = os.open(tmp_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=indent, ensure_ascii=False)
        if not IS_WINDOWS:
            os.chmod(tmp_path, mode)
            os.replace(tmp_path, path)
        else:
            for attempt in range(4):
                try:
                    os.replace(tmp_path, path)
                    break
                except PermissionError:
                    if attempt == 3:
                        raise
                    time.sleep(0.005)
    except Exception:
        try:
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)
        except Exception:
            pass
        raise


def make_linebar(fraction: float | None, length: int = 8, fill_char: str = "█", empty_char: str = "░") -> str:
    """Generates a colored text progress linebar."""
    if fraction is None:
        fraction = 1.0
    fraction = max(0.0, min(1.0, float(fraction)))
    pct = fmt_pct(fraction)
    filled_len = int(round(fraction * length))
    empty_len = length - filled_len

    if pct >= 50:
        bar_color = C_GREEN
    elif pct >= 20:
        bar_color = C_YELLOW
    else:
        bar_color = C_RED

    bar = f"{bar_color}{fill_char * filled_len}{C_GRAY}{empty_char * empty_len}{C_RESET}"
    return f"[{bar}]"


def make_context_linebar(fraction: float | None, length: int = 8, fill_char: str = "█", empty_char: str = "░") -> str:
    """Generates a colored text progress linebar for context usage (inverse color coding)."""
    if fraction is None:
        fraction = 0.0
    fraction = max(0.0, min(1.0, float(fraction)))
    filled_len = int(round(fraction * length))
    empty_len = length - filled_len

    if fraction < 0.50:
        bar_color = C_GREEN
    elif fraction < 0.75:
        bar_color = C_YELLOW
    elif fraction < 0.85:
        bar_color = C_ORANGE
    else:
        bar_color = C_RED

    bar = f"{bar_color}{fill_char * filled_len}{C_GRAY}{empty_char * empty_len}{C_RESET}"
    return f"[{bar}]"


def format_countdown(reset_iso: str | None, default_val: str = "5h 00m") -> str:
    if not reset_iso:
        return default_val
    dt = parse_iso_utc(reset_iso)
    if dt is None:
        return default_val
    now = datetime.now(timezone.utc)
    total_sec = int((dt - now).total_seconds())
    if total_sec <= 0:
        return "0m"
    hrs = total_sec // 3600
    mins = (total_sec % 3600) // 60
    if hrs >= 24:
        days = hrs // 24
        rem_hrs = hrs % 24
        return f"{days}d {rem_hrs:02d}h"
    if hrs > 0:
        return f"{hrs}h {mins:02d}m"
    return f"{mins}m"


def get_account_file_path(alias: str) -> str | None:
    """Returns the path to the account JSON file, searching REAL_HOME first."""
    acc_paths = [
        os.path.join(REAL_HOME, ".gemini", "antigravity-cli", "accounts", f"{alias}.json"),
        os.path.join(REAL_HOME, "snap", "antigravity-cli", "common", ".gemini", "antigravity-cli", "accounts", f"{alias}.json"),
    ]
    for ap in acc_paths:
        if os.path.exists(ap):
            return ap
    return None


def detect_active_account(stdin_data: dict | None = None) -> str:
    """Detects the active agyc account alias (agy01..agy15)."""
    if stdin_data and stdin_data.get("email"):
        email = str(stdin_data.get("email", "")).strip().lower()
        accounts_dir = os.path.join(REAL_HOME, ".gemini", "antigravity-cli", "accounts")
        if email and os.path.isdir(accounts_dir):
            try:
                for fname in os.listdir(accounts_dir):
                    if fname.startswith("agy") and fname.endswith(".json"):
                        alias = fname[:-5]
                        try:
                            with open(os.path.join(accounts_dir, fname), "r", encoding="utf-8") as af:
                                d = json.load(af)
                                if str(d.get("email", "")).strip().lower() == email:
                                    return alias
                        except Exception:
                            pass
            except Exception:
                pass

    for env_key in ("HOME", "USERPROFILE", "ANTIGRAVITY_APP_DATA_DIR", "AGYC_ACCOUNT"):
        val = os.environ.get(env_key, "")
        if not val:
            continue
        if env_key == "AGYC_ACCOUNT":
            alias = extract_agy_alias(val) or (platform._normalize_alias_token(val) if platform is not None else val.strip())
        else:
            alias = (
                platform._extract_alias_from_home_path(val)
                if platform is not None
                else extract_agy_alias(val)
            )
        if alias:
            return alias

    config_paths = [
        os.path.join(REAL_HOME, ".gemini", "antigravity-cli", "accounts", "config.json"),
    ]
    if platform is not None:
        base_cfg = os.path.join(platform.get_base_dir(REAL_HOME), "accounts", "config.json")
        if base_cfg not in config_paths:
            config_paths.insert(0, base_cfg)
    if not IS_WINDOWS:
        config_paths.append(
            os.path.join(REAL_HOME, "snap", "antigravity-cli", "common", ".gemini", "antigravity-cli", "accounts", "config.json")
        )
    for cp in config_paths:
        if os.path.exists(cp):
            try:
                with open(cp, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    act = data.get("active_account")
                    if act:
                        return str(act)
            except Exception:
                pass
    return "agy01"


def get_git_branch(start_dir: str | None = None) -> str | None:
    """Ultra-fast zero-subprocess branch reader directly from .git/HEAD."""
    try:
        cwd = start_dir if (start_dir and os.path.isdir(start_dir)) else os.getcwd()
        for _ in range(6):
            git_path = os.path.join(cwd, ".git")
            if os.path.exists(git_path):
                if os.path.isfile(git_path):
                    with open(git_path, "r", encoding="utf-8") as f:
                        line = f.read().strip()
                        if line.startswith("gitdir:"):
                            git_path = os.path.abspath(os.path.join(cwd, line[7:].strip()))
                head_file = os.path.join(git_path, "HEAD")
                if os.path.isfile(head_file):
                    with open(head_file, "r", encoding="utf-8") as f:
                        c = f.read().strip()
                    if c.startswith("ref: refs/heads/"):
                        return c[16:]
                    return c[:7]
            parent = os.path.dirname(cwd)
            if parent == cwd:
                break
            cwd = parent
    except Exception:
        pass
    return None


def get_vcs_info(stdin_data: dict | None) -> tuple[str | None, bool]:
    """Extracts (branch, is_dirty) from stdin_data.vcs with fallback to .git/HEAD."""
    if stdin_data and isinstance(stdin_data.get("vcs"), dict):
        vcs = stdin_data["vcs"]
        branch = vcs.get("branch") or vcs.get("head") or vcs.get("ref")
        dirty = bool(vcs.get("dirty") or vcs.get("is_dirty") or vcs.get("has_changes"))
        if isinstance(branch, str) and branch.strip():
            return branch.strip(), dirty

    if stdin_data and isinstance(stdin_data.get("git_branch"), str) and stdin_data["git_branch"].strip():
        return stdin_data["git_branch"].strip(), bool(stdin_data.get("git_dirty", False))

    start_dir = None
    if stdin_data:
        ws = stdin_data.get("workspace")
        if isinstance(ws, dict):
            start_dir = ws.get("current_dir") or ws.get("project_dir") or ws.get("cwd")
        elif isinstance(stdin_data.get("cwd"), str):
            start_dir = stdin_data["cwd"]
    return get_git_branch(start_dir), False


def _token_needs_refresh(token_data: dict | None) -> bool:
    if not isinstance(token_data, dict):
        return True
    token_obj = token_data.get("token")
    if not isinstance(token_obj, dict):
        return True
    if not token_obj.get("access_token") or not token_obj.get("expiry"):
        return True
    exp_dt = parse_iso_utc(token_obj.get("expiry"))
    return exp_dt is None or (exp_dt - datetime.now(timezone.utc)).total_seconds() < 300


def _sync_isolated_oauth_token(alias: str, token_data: dict) -> None:
    """Syncs renewed OAuth token to ~/.agyc_homes/{alias}/.gemini/antigravity-cli/antigravity-oauth-token if present."""
    if not alias or not isinstance(token_data, dict) or not token_data:
        return
    iso_gemini = os.path.join(REAL_HOME, ".agyc_homes", alias, ".gemini", "antigravity-cli")
    if not os.path.isdir(iso_gemini):
        return
    token_dst = os.path.join(iso_gemini, "antigravity-oauth-token")
    if os.path.islink(token_dst):
        try:
            os.unlink(token_dst)
        except Exception:
            pass
    try:
        atomic_write_json(token_dst, token_data, mode=0o600, indent=2)
    except Exception:
        pass


def refresh_token_if_needed(token_data: dict) -> tuple[dict, bool]:
    """Refresh OAuth access token if expired or expiring within 5 minutes."""
    import urllib.request
    import urllib.parse

    if not _token_needs_refresh(token_data):
        return token_data, False

    token_obj = dict(token_data.get("token") or {})
    refresh_token = token_obj.get("refresh_token")
    if not refresh_token:
        return token_data, False

    payload = urllib.parse.urlencode({
        "client_id": GOOGLE_CLIENT_ID,
        "client_secret": GOOGLE_CLIENT_SECRET,
        "grant_type": "refresh_token",
        "refresh_token": refresh_token,
    }).encode("utf-8")

    req = urllib.request.Request(
        "https://oauth2.googleapis.com/token",
        data=payload,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            res = json.loads(resp.read().decode("utf-8"))
        token_obj["access_token"] = res["access_token"]
        if "refresh_token" in res:
            token_obj["refresh_token"] = res["refresh_token"]
        expires_in = res.get("expires_in", 3600)
        token_obj["expiry"] = (datetime.now(timezone.utc) + timedelta(seconds=expires_in)).isoformat()
        updated = dict(token_data)
        if "id_token" in res:
            updated["id_token"] = res["id_token"]
        updated["token"] = token_obj
        return updated, True
    except Exception:
        return token_data, False


def _merge_slot(
    slot: dict,
    raw_frac: float | None,
    raw_reset: str | None,
    now_dt: datetime,
    disabled: bool = False,
) -> None:
    """Merges a candidate quota measurement into slot using min(remainingFraction)."""
    frac, rst, dis = normalize_quota_value(raw_frac, raw_reset, now_dt=now_dt, disabled=disabled)
    if dis:
        slot["disabled"] = True
    if frac < slot["frac"] - 1e-6:
        slot["frac"] = frac
        slot["reset"] = rst or slot["reset"]
    elif abs(frac - slot["frac"]) <= 1e-6 and frac < 0.9995:
        if slot["reset"] is None and rst is not None:
            slot["reset"] = rst


def _read_cached_quota_file(alias: str) -> dict | None:
    """Reads quota cache from cache dir with smooth fallback to legacy /tmp file on Linux."""
    ensure_cache_dir()
    primary = os.path.join(CACHE_DIR, f"quota_cache_{alias}.json")
    candidates = [primary]
    if not IS_WINDOWS:
        candidates.append(f"/tmp/agyc_quota_cache_{alias}.json")
    for candidate in candidates:
        if os.path.exists(candidate):
            try:
                with open(candidate, "r", encoding="utf-8") as f:
                    data = json.load(f)
                if isinstance(data, dict):
                    return data
            except Exception:
                pass
    return None


def do_fetch_and_save_quota(alias: str) -> dict | None:
    """Unified 1.5.10 quota engine (--refresh-quota-bg <alias>).
    1) Refreshes OAuth under non-blocking lock (<locks_dir>/{alias}.oauth.lock) + syncs isolated HOME token.
    2) Queries loadCodeAssist across daily & prod to obtain project_id and accurate plan_type (ULTRA/PRO/ENT/FREE).
    3) Queries retrieveUserQuotaSummary & retrieveUserQuota with {"project": project_id} in parallel across daily & prod.
    """
    import urllib.request
    from concurrent.futures import ThreadPoolExecutor

    ensure_cache_dir(need_locks=True)
    cache_file = os.path.join(CACHE_DIR, f"quota_cache_{alias}.json")
    now_ts = time.time()
    now_dt = datetime.now(timezone.utc)

    acc_path = get_account_file_path(alias)
    if not acc_path:
        return None

    try:
        with open(acc_path, "r", encoding="utf-8") as f:
            acc_data = json.load(f)
    except Exception:
        return None

    if not isinstance(acc_data, dict) or not acc_data:
        return None

    fallback_quota = acc_data.get("quota") if isinstance(acc_data.get("quota"), dict) else {}
    token_data = acc_data.get("token_data") if isinstance(acc_data.get("token_data"), dict) else {}

    if _token_needs_refresh(token_data):
        oauth_lock_path = os.path.join(LOCKS_DIR, f"{safe_cache_key(alias)}.oauth.lock")
        if platform is not None:
            try:
                with platform.acquire_file_lock(oauth_lock_path, blocking=False):
                    try:
                        with open(acc_path, "r", encoding="utf-8") as f:
                            latest_on_disk = json.load(f)
                        if isinstance(latest_on_disk, dict) and isinstance(latest_on_disk.get("token_data"), dict):
                            acc_data = latest_on_disk
                            token_data = latest_on_disk["token_data"]
                    except Exception:
                        pass

                    if _token_needs_refresh(token_data):
                        token_data, refreshed = refresh_token_if_needed(token_data)
                        if refreshed:
                            try:
                                acc_data["token_data"] = token_data
                                acc_data["is_revoked"] = False
                                atomic_write_json(acc_path, acc_data, mode=0o600, indent=2)
                            except Exception:
                                pass
                            _sync_isolated_oauth_token(alias, token_data)
            except BlockingIOError:
                pass
            except Exception:
                pass
        else:
            token_data, refreshed = refresh_token_if_needed(token_data)
            if refreshed:
                try:
                    acc_data["token_data"] = token_data
                    acc_data["is_revoked"] = False
                    atomic_write_json(acc_path, acc_data, mode=0o600, indent=2)
                except Exception:
                    pass
                _sync_isolated_oauth_token(alias, token_data)

    token = (token_data.get("token") or {}).get("access_token") if isinstance(token_data, dict) else None
    if not token:
        existing = _read_cached_quota_file(alias)
        if existing:
            return existing
        return fallback_quota if fallback_quota else None

    hosts = ["daily-cloudcode-pa.googleapis.com", "cloudcode-pa.googleapis.com"]
    headers = {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
        "User-Agent": ANTIGRAVITY_UA,
    }
    lca_payload = json.dumps({
        "metadata": {
            "ideType": "ANTIGRAVITY",
            "platform": "WINDOWS_AMD64" if IS_WINDOWS else "LINUX_AMD64",
            "pluginType": "GEMINI",
        }
    }).encode("utf-8")

    def _call_api(endpoint: str, host: str, body: bytes) -> dict | None:
        url = f"https://{host}/v1internal:{endpoint}"
        req = urllib.request.Request(url, data=body, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=6) as resp:
                return json.loads(resp.read().decode("utf-8"))
        except Exception:
            return None

    # Phase 1: loadCodeAssist on daily & prod in parallel to resolve project_id and tier
    lca_results: dict[str, dict | None] = {}
    with ThreadPoolExecutor(max_workers=2) as pool:
        lca_futs = {
            "lca_daily": pool.submit(_call_api, "loadCodeAssist", hosts[0], lca_payload),
            "lca_prod": pool.submit(_call_api, "loadCodeAssist", hosts[1], lca_payload),
        }
        for key, fut in lca_futs.items():
            try:
                lca_results[key] = fut.result()
            except Exception:
                lca_results[key] = None

    project_id: str | None = None
    for lca_key in ("lca_prod", "lca_daily"):
        lca = lca_results.get(lca_key)
        if not isinstance(lca, dict):
            continue
        raw_proj = lca.get("cloudaicompanionProject")
        if isinstance(raw_proj, dict) and raw_proj.get("id"):
            project_id = str(raw_proj["id"]).strip()
            break
        elif isinstance(raw_proj, str) and raw_proj.strip():
            project_id = raw_proj.strip()
            break
    if not project_id:
        raw_fb_proj = acc_data.get("project_id") or fallback_quota.get("project_id")
        if isinstance(raw_fb_proj, str) and raw_fb_proj.strip():
            project_id = raw_fb_proj.strip()

    plan_type = acc_data.get("plan_type") or fallback_quota.get("plan_type")
    tier_id = fallback_quota.get("tier_id")
    tier_name = fallback_quota.get("tier_name")
    supports_carbon = bool(acc_data.get("supports_carbon") or fallback_quota.get("supports_carbon", False))
    has_gemini4 = bool(acc_data.get("has_gemini4") or fallback_quota.get("has_gemini4", False))

    for lca_key in ("lca_prod", "lca_daily"):
        lca = lca_results.get(lca_key)
        if not isinstance(lca, dict):
            continue
        paid_tier = lca.get("paidTier") if isinstance(lca.get("paidTier"), dict) else {}
        curr_tier = lca.get("currentTier") if isinstance(lca.get("currentTier"), dict) else {}
        tier_obj = paid_tier or curr_tier
        if tier_obj.get("id"):
            tier_id = str(tier_obj["id"])
        if tier_obj.get("name"):
            tier_name = str(tier_obj["name"])
        paid_str = f"{paid_tier.get('id', '')} {paid_tier.get('name', '')} {paid_tier.get('description', '')}".lower()
        curr_str = f"{curr_tier.get('id', '')} {curr_tier.get('name', '')}".lower()
        if "ultra" in paid_str or "ultra" in curr_str:
            plan_type = "ULTRA"
            supports_carbon = True
            has_gemini4 = True
            break
        elif "pro" in paid_str or "pro" in curr_str:
            plan_type = "PRO"
            supports_carbon = False
            break
        elif "enterprise" in paid_str or (paid_tier and "standard" in paid_str) or "enterprise" in curr_str:
            plan_type = "ENT"
            supports_carbon = False
            break
        elif paid_tier or curr_tier:
            plan_type = "FREE"
            supports_carbon = False

    quota_payload = json.dumps({"project": project_id}).encode("utf-8") if project_id else b"{}"

    # Phase 2: retrieveUserQuotaSummary & retrieveUserQuota with {"project": project_id}
    quota_tasks = [
        ("sum_daily", "retrieveUserQuotaSummary", hosts[0], quota_payload),
        ("sum_prod", "retrieveUserQuotaSummary", hosts[1], quota_payload),
        ("mod_daily", "retrieveUserQuota", hosts[0], quota_payload),
        ("mod_prod", "retrieveUserQuota", hosts[1], quota_payload),
    ]

    results: dict[str, dict | None] = {}
    with ThreadPoolExecutor(max_workers=4) as pool:
        futs = {
            key: pool.submit(_call_api, ep, host, body)
            for key, ep, host, body in quota_tasks
        }
        for key, fut in futs.items():
            try:
                results[key] = fut.result()
            except Exception:
                results[key] = None

    slots = {
        ("gemini", "5h"): {"frac": 1.0, "reset": None, "disabled": False},
        ("gemini", "weekly"): {"frac": 1.0, "reset": None, "disabled": False},
        ("claude", "5h"): {"frac": 1.0, "reset": None, "disabled": False},
        ("claude", "weekly"): {"frac": 1.0, "reset": None, "disabled": False},
    }

    any_quota_ok = False

    for sum_key in ("sum_daily", "sum_prod"):
        sdata = results.get(sum_key)
        if not isinstance(sdata, dict) or "groups" not in sdata:
            continue
        any_quota_ok = True
        for grp in sdata.get("groups") or []:
            gname = str(grp.get("displayName") or "").lower()
            gdesc = str(grp.get("description") or "").lower()
            if "carbon" in gdesc or "carbon" in gname:
                supports_carbon = True
                has_gemini4 = True
            if any(k in gdesc or k in gname for k in ("gemini 4", "argon", "hydrogen")):
                has_gemini4 = True

            for b in grp.get("buckets") or []:
                bid = str(b.get("bucketId") or "").lower()
                win = str(b.get("window") or "").lower()
                frac = b.get("remainingFraction")
                rst = b.get("resetTime")
                dis = bool(b.get("disabled", False))

                if "carbon" in bid:
                    supports_carbon = True
                    has_gemini4 = True
                if any(k in bid for k in ("argon", "hydrogen", "gemini-4")):
                    has_gemini4 = True

                family = None
                if bid.startswith("gemini") or "gemini" in gname or "argon" in gname or "argon" in bid:
                    family = "gemini"
                elif bid.startswith("3p") or any(k in gname for k in ("claude", "gpt", "3p")):
                    family = "claude"

                window = None
                if win == "5h" or "5h" in bid:
                    window = "5h"
                elif win == "weekly" or "weekly" in bid or "month" in bid:
                    window = "weekly"

                if family and window:
                    _merge_slot(slots[(family, window)], frac, rst, now_dt=now_dt, disabled=dis)

    for mod_key in ("mod_daily", "mod_prod"):
        mdata = results.get(mod_key)
        if not isinstance(mdata, dict) or "buckets" not in mdata:
            continue
        any_quota_ok = True
        for b in mdata.get("buckets") or []:
            mid = str(b.get("modelId") or "").lower()
            if not mid or mid.startswith("chat_") or mid.startswith("tab_") or "tab_" in mid:
                continue

            if "carbon" in mid:
                supports_carbon = True
                has_gemini4 = True
            elif any(k in mid for k in ("gemini-4", "argon", "hydrogen")):
                has_gemini4 = True

            family = None
            if any(k in mid for k in ("claude", "sonnet", "opus", "haiku", "gpt")):
                family = "claude"
            elif ("gemini" in mid or "orchestrator" in mid or any(k in mid for k in ("argon", "carbon", "hydrogen"))) and "image" not in mid:
                family = "gemini"

            if not family:
                continue

            frac = b.get("remainingFraction")
            rst = b.get("resetTime")
            dis = bool(b.get("disabled", False))

            rst_dt = parse_iso_utc(rst)
            if rst_dt is not None:
                delta_sec = (rst_dt - now_dt).total_seconds()
                if delta_sec <= 0:
                    continue
                window = "5h" if delta_sec <= HORIZON_5H_SECONDS else "weekly"
            else:
                window = "5h"

            _merge_slot(slots[(family, window)], frac, rst, now_dt=now_dt, disabled=dis)

    if not any_quota_ok:
        existing = _read_cached_quota_file(alias)
        if existing:
            return existing
        return fallback_quota if fallback_quota else None

    g5 = slots[("gemini", "5h")]
    gw = slots[("gemini", "weekly")]
    c5 = slots[("claude", "5h")]
    cw = slots[("claude", "weekly")]

    g_dis = bool(gw["disabled"] or gw["frac"] <= 0.0005)
    if g_dis:
        gw["frac"] = 0.0
        g5["frac"] = 0.0
        g5["reset"] = g5["reset"] or gw["reset"]

    c_dis = bool(cw["disabled"] or cw["frac"] <= 0.0005)
    if c_dis:
        cw["frac"] = 0.0
        c5["frac"] = 0.0
        c5["reset"] = c5["reset"] or cw["reset"]

    g5_frac, g5_rst, _ = normalize_quota_value(g5["frac"], g5["reset"], now_dt=now_dt, disabled=g_dis)
    gw_frac, gw_rst, _ = normalize_quota_value(gw["frac"], gw["reset"], now_dt=now_dt, disabled=g_dis)
    c5_frac, c5_rst, _ = normalize_quota_value(c5["frac"], c5["reset"], now_dt=now_dt, disabled=c_dis)
    cw_frac, cw_rst, _ = normalize_quota_value(cw["frac"], cw["reset"], now_dt=now_dt, disabled=c_dis)

    metrics: dict = {
        "plan_type": plan_type,
        "tier_id": tier_id,
        "tier_name": tier_name,
        "project_id": project_id,
        "supports_carbon": bool(supports_carbon),
        "has_gemini4": bool(has_gemini4),
        "gemini_5h_fraction": g5_frac,
        "gemini_5h_reset": g5_rst,
        "gemini_weekly_fraction": gw_frac,
        "gemini_weekly_reset": gw_rst,
        "gemini_disabled": g_dis,
        "claude_5h_fraction": c5_frac,
        "claude_5h_reset": c5_rst,
        "claude_weekly_fraction": cw_frac,
        "claude_weekly_reset": cw_rst,
        "claude_disabled": c_dis,
        "argon_weekly_fraction": gw_frac if has_gemini4 else None,
        "argon_weekly_reset": gw_rst if has_gemini4 else None,
        "fetched_at": now_dt.isoformat(),
        "cached_at": now_ts,
    }

    try:
        atomic_write_json(cache_file, metrics, mode=0o600)
    except Exception:
        pass

    try:
        with open(acc_path, "r", encoding="utf-8") as f:
            latest_acc = json.load(f)
        latest_acc["quota"] = metrics
        if plan_type:
            latest_acc["plan_type"] = plan_type
        if project_id:
            latest_acc["project_id"] = project_id
        latest_acc["supports_carbon"] = bool(supports_carbon)
        latest_acc["has_gemini4"] = bool(has_gemini4)
        latest_acc["updated_at"] = metrics["fetched_at"]
        atomic_write_json(acc_path, latest_acc, mode=0o600, indent=2)
    except Exception:
        pass

    return metrics


def spawn_background_refresh(alias: str) -> None:
    """Spawns background refresh throttled by lock file (max 1 refresh per 15s)."""
    ensure_cache_dir()
    lock_file = os.path.join(CACHE_DIR, f"quota_refreshing_{safe_cache_key(alias)}.lock")
    now_ts = time.time()
    if os.path.exists(lock_file):
        try:
            with open(lock_file, "r", encoding="utf-8") as f:
                lock_ts = float(f.read().strip())
            if now_ts - lock_ts < REFRESH_LOCK_SECONDS:
                return
        except Exception:
            pass

    try:
        fd = os.open(lock_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(str(now_ts))
    except Exception:
        pass

    try:
        env = os.environ.copy()
        env["HOME"] = REAL_HOME
        env["AGYC_REAL_HOME"] = REAL_HOME
        if IS_WINDOWS:
            env["USERPROFILE"] = REAL_HOME
        py_exe = sys.executable
        if IS_WINDOWS and (not py_exe or not os.path.exists(py_exe)):
            import shutil
            py_exe = shutil.which("python") or "python"
        cmd = [py_exe, "-S", os.path.abspath(__file__), "--refresh-quota-bg", alias]
        if platform is not None:
            platform.spawn_detached(cmd, env=env)
        else:
            import subprocess
            subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=not IS_WINDOWS,
                env=env,
            )
    except Exception:
        pass


def fetch_online_quota(alias: str) -> dict | None:
    """Non-blocking quota reader from cache dir (fallback /tmp on Linux) with 20s background refresh TTL."""
    ensure_cache_dir()
    primary_cache = os.path.join(CACHE_DIR, f"quota_cache_{alias}.json")
    legacy_cache = f"/tmp/agyc_quota_cache_{alias}.json"
    now_ts = time.time()
    cached = None
    used_legacy = False

    if os.path.exists(primary_cache):
        try:
            with open(primary_cache, "r", encoding="utf-8") as f:
                cached = json.load(f)
        except Exception:
            cached = None
    elif not IS_WINDOWS and os.path.exists(legacy_cache):
        try:
            with open(legacy_cache, "r", encoding="utf-8") as f:
                cached = json.load(f)
            used_legacy = True
        except Exception:
            cached = None

    if isinstance(cached, dict):
        cache_age = now_ts - float(cached.get("cached_at", 0) or 0)
        if used_legacy or cache_age >= CACHE_TTL_SECONDS or "fetched_at" not in cached:
            spawn_background_refresh(alias)
        return cached

    spawn_background_refresh(alias)
    acc_path = get_account_file_path(alias)
    if acc_path and os.path.exists(acc_path):
        try:
            with open(acc_path, "r", encoding="utf-8") as f:
                acc_data = json.load(f)
            q = dict(acc_data.get("quota") or {})
            if acc_data.get("plan_type") and not q.get("plan_type"):
                q["plan_type"] = acc_data["plan_type"]
            if q:
                return q
        except Exception:
            pass

    return None


def merge_cached_and_stdin_quota(cached: dict | None, stdin_quota: dict | None) -> dict | None:
    """Combines cached online quota with agy's stdin_quota IN MEMORY ONLY.
    NEVER writes stdin_quota to disk cache (eliminates the 12-min stale overwrite).
    """
    if not cached and not stdin_quota:
        return None

    now_dt = datetime.now(timezone.utc)
    base = dict(cached or {})

    g5_f, g5_r, g5_d = normalize_quota_value(
        base.get("gemini_5h_fraction", 1.0),
        base.get("gemini_5h_reset"),
        now_dt=now_dt,
        disabled=bool(base.get("gemini_disabled", False)),
    )
    gw_f, gw_r, gw_d = normalize_quota_value(
        base.get("gemini_weekly_fraction", 1.0),
        base.get("gemini_weekly_reset"),
        now_dt=now_dt,
        disabled=bool(base.get("gemini_disabled", False)),
    )
    c5_f, c5_r, c5_d = normalize_quota_value(
        base.get("claude_5h_fraction", 1.0),
        base.get("claude_5h_reset"),
        now_dt=now_dt,
        disabled=bool(base.get("claude_disabled", False)),
    )
    cw_f, cw_r, cw_d = normalize_quota_value(
        base.get("claude_weekly_fraction", 1.0),
        base.get("claude_weekly_reset"),
        now_dt=now_dt,
        disabled=bool(base.get("claude_disabled", False)),
    )

    slots = {
        ("gemini", "5h"): {"frac": g5_f, "reset": g5_r, "disabled": g5_d},
        ("gemini", "weekly"): {"frac": gw_f, "reset": gw_r, "disabled": gw_d},
        ("claude", "5h"): {"frac": c5_f, "reset": c5_r, "disabled": c5_d},
        ("claude", "weekly"): {"frac": cw_f, "reset": cw_r, "disabled": cw_d},
    }

    if isinstance(stdin_quota, dict):
        mapping = [
            (("gemini", "5h"), stdin_quota.get("gemini-5h") or stdin_quota.get("gemini_5h")),
            (("gemini", "weekly"), stdin_quota.get("gemini-weekly") or stdin_quota.get("gemini_weekly")),
            (("claude", "5h"), stdin_quota.get("3p-5h") or stdin_quota.get("claude-5h") or stdin_quota.get("3p_5h")),
            (("claude", "weekly"), stdin_quota.get("3p-weekly") or stdin_quota.get("claude-weekly") or stdin_quota.get("3p_weekly")),
        ]
        for key, sb in mapping:
            if not isinstance(sb, dict):
                continue
            raw_f = sb.get("remaining_fraction")
            if raw_f is None:
                raw_f = sb.get("remainingFraction")
            raw_r = sb.get("reset_time") or sb.get("resetTime")
            raw_d = bool(sb.get("disabled", False))
            if raw_f is None and not raw_d:
                continue
            if raw_r:
                s_dt = parse_iso_utc(raw_r)
                if s_dt is not None and s_dt <= now_dt:
                    continue
            _merge_slot(slots[key], raw_f, raw_r, now_dt=now_dt, disabled=raw_d)

    g_dis = bool(slots[("gemini", "weekly")]["disabled"] or slots[("gemini", "weekly")]["frac"] <= 0.0005)
    if g_dis:
        slots[("gemini", "weekly")]["frac"] = 0.0
        slots[("gemini", "5h")]["frac"] = 0.0
        slots[("gemini", "5h")]["reset"] = slots[("gemini", "5h")]["reset"] or slots[("gemini", "weekly")]["reset"]

    c_dis = bool(slots[("claude", "weekly")]["disabled"] or slots[("claude", "weekly")]["frac"] <= 0.0005)
    if c_dis:
        slots[("claude", "weekly")]["frac"] = 0.0
        slots[("claude", "5h")]["frac"] = 0.0
        slots[("claude", "5h")]["reset"] = slots[("claude", "5h")]["reset"] or slots[("claude", "weekly")]["reset"]

    base["gemini_5h_fraction"] = slots[("gemini", "5h")]["frac"]
    base["gemini_5h_reset"] = slots[("gemini", "5h")]["reset"]
    base["gemini_weekly_fraction"] = slots[("gemini", "weekly")]["frac"]
    base["gemini_weekly_reset"] = slots[("gemini", "weekly")]["reset"]
    base["gemini_disabled"] = g_dis
    base["claude_5h_fraction"] = slots[("claude", "5h")]["frac"]
    base["claude_5h_reset"] = slots[("claude", "5h")]["reset"]
    base["claude_weekly_fraction"] = slots[("claude", "weekly")]["frac"]
    base["claude_weekly_reset"] = slots[("claude", "weekly")]["reset"]
    base["claude_disabled"] = c_dis
    return base


def resolve_plan_type(quota: dict | None, account: str) -> str | None:
    """Resolves account plan_type ('ULTRA', 'PRO', 'ENT', 'FREE') without mislabeling FREE/unknown as PRO."""
    if quota and quota.get("plan_type"):
        return str(quota["plan_type"]).upper()
    acc_path = get_account_file_path(account)
    if acc_path:
        try:
            with open(acc_path, "r", encoding="utf-8") as f:
                acc_data = json.load(f)
            pt = acc_data.get("plan_type") or (acc_data.get("quota") or {}).get("plan_type")
            if pt:
                return str(pt).upper()
            if acc_data.get("supports_carbon") or (acc_data.get("quota") or {}).get("supports_carbon"):
                return "ULTRA"
        except Exception:
            pass
    return None


def _prettify_model_slug(raw: str) -> tuple[str, str | None]:
    """Converts CLI model slugs (e.g. 'gemini-4-carbon-high', 'claude-opus-5-5-thinking') into clean display names."""
    s = raw.strip()
    if " " in s or "-" not in s:
        return s, None
    low = s.lower()
    extracted_effort: str | None = None

    # Strip trailing modifiers (-thinking, -tiered, -<effort>) in any order
    for _ in range(4):
        changed = False
        if low.endswith("-tiered"):
            low = low[:-7]
            changed = True
        if low.endswith("-thinking"):
            low = low[:-9]
            changed = True
        for eff in ("xhigh", "high", "medium", "low", "max", "minimal"):
            if low.endswith(f"-{eff}"):
                if extracted_effort is None:
                    extracted_effort = eff
                low = low[: -(len(eff) + 1)]
                changed = True
                break
        if not changed:
            break

    if "orchestrator" in low:
        if "carbon" in low:
            return "Gemini Pro Orchestrator (Carbon)", extracted_effort
        if "argon" in low:
            return "Gemini Pro Orchestrator (Argon)", extracted_effort
        return "Gemini Pro Orchestrator", extracted_effort
    if "gemini-4-carbon" in low:
        return "Gemini 4 Carbon", extracted_effort
    if "gemini-4-argon" in low:
        return "Gemini 4 Argon", extracted_effort
    if "gemini-4-hydrogen" in low:
        return "Gemini 4 Hydrogen", extracted_effort
    if "gemini-3.8-flash" in low or "gemini-3-8-flash" in low:
        if "image" in low:
            return "Gemini 3.8 Flash Image", extracted_effort
        return "Gemini 3.8 Flash", extracted_effort
    if "flash-image" in low:
        return "Gemini Flash Image", extracted_effort
    if "pro-image" in low:
        return "Gemini Pro Image", extracted_effort
    if "claude-opus-5-5" in low or "claude-opus-5.5" in low:
        return "Claude Opus 5.5", extracted_effort
    if "claude-sonnet-5-5" in low or "claude-sonnet-5.5" in low:
        return "Claude Sonnet 5.5", extracted_effort
    if "claude-opus-4-6" in low or "claude-opus-4.6" in low:
        return "Claude Opus 4.6", extracted_effort
    if "claude-sonnet-4-6" in low or "claude-sonnet-4.6" in low:
        return "Claude Sonnet 4.6", extracted_effort
    if "claude-haiku-4-5" in low or "claude-haiku-4.5" in low:
        return "Claude Haiku 4.5", extracted_effort
    if "gpt-oss-120b" in low or ("gpt-oss" in low and "120b" in low):
        return "GPT-OSS 120B", extracted_effort
    if "gpt-oss" in low:
        return "GPT-OSS", extracted_effort
    return s, extracted_effort


def default_max_tokens_for_model(model_name: str) -> int:
    """Returns exact default context window capacity by model family."""
    m = (model_name or "").lower()
    if "flash-image" in m or "pro-image" in m or ("image" in m and "gemini" in m):
        return 65_536
    if any(k in m for k in ("gpt-oss", "120b", "gpt")):
        return 131_072
    if any(k in m for k in ("claude", "sonnet", "opus", "haiku")):
        if "haiku" in m:
            return 200_000
        if any(v in m for v in ("4-6", "4.6", "5-5", "5.5")):
            return 250_000
        return 200_000
    return 1_048_576


def format_max_tokens_k(max_tokens: int) -> str:
    """Formats max_tokens cleanly: 1048576 -> '1M', 131072 -> '128k', 65536 -> '64k', 250000 -> '250k'."""
    if max_tokens >= 1_000_000:
        if max_tokens % 1_048_576 == 0:
            return f"{max_tokens // 1_048_576}M"
        if max_tokens % 1_000_000 == 0:
            return f"{max_tokens // 1_000_000}M"
        return f"{round(max_tokens / 1_000_000, 1):g}M"
    if max_tokens % 1024 == 0 and (max_tokens // 1024) in (32, 64, 128, 256, 512):
        return f"{max_tokens // 1024}k"
    if max_tokens >= 1000:
        return f"{max_tokens // 1000}k"
    return str(max_tokens)


def get_model_and_effort(stdin_data: dict | None, account: str) -> tuple[str, str, str]:
    """Detects active model name and reasoning effort level."""
    model_name = None
    effort = None

    if stdin_data:
        m = stdin_data.get("model")
        if isinstance(m, dict):
            model_name = m.get("display_name") or m.get("name") or m.get("id")
            effort = m.get("effort") or m.get("reasoning_effort") or stdin_data.get("effort")
        elif isinstance(m, str):
            model_name = m
        if not effort:
            effort = stdin_data.get("effort") or stdin_data.get("reasoning_effort")

    if not model_name:
        env_model = os.environ.get("ANTIGRAVITY_CLI_MODEL") or os.environ.get("ANTIGRAVITY_MODEL")
        if env_model and env_model.strip():
            model_name = env_model.strip()
    if not effort:
        env_eff = os.environ.get("ANTIGRAVITY_CLI_EFFORT") or os.environ.get("ANTIGRAVITY_EFFORT")
        if env_eff and env_eff.strip():
            effort = env_eff.strip()

    if (not model_name or not effort) and not IS_WINDOWS:
        try:
            pid = os.getppid()
            for _ in range(5):
                if pid <= 1:
                    break
                cmd_file = f"/proc/{pid}/cmdline"
                if os.path.exists(cmd_file):
                    with open(cmd_file, "rb") as f:
                        parts = f.read().decode("utf-8", errors="ignore").split("\x00")
                    for i, arg in enumerate(parts):
                        if arg == "--model" and i + 1 < len(parts) and not model_name:
                            model_name = parts[i + 1]
                        elif arg in ("--effort", "--reasoning-effort") and i + 1 < len(parts) and not effort:
                            effort = parts[i + 1]
                with open(f"/proc/{pid}/status", "r", encoding="utf-8") as sf:
                    ppid = 0
                    for line in sf:
                        if line.startswith("PPid:"):
                            ppid = int(line.split()[1])
                            break
                    if ppid <= 1 or ppid == pid:
                        break
                    pid = ppid
        except Exception:
            pass

    if not model_name:
        app_data = os.environ.get("ANTIGRAVITY_APP_DATA_DIR", "")
        candidate_paths = [
            os.path.join(app_data, "settings.json") if app_data else "",
            os.path.join(REAL_HOME, ".agyc_homes", account, ".gemini", "antigravity-cli", "settings.json"),
            os.path.join(REAL_HOME, ".gemini", "antigravity-cli", "settings.json"),
        ]
        for cp in candidate_paths:
            if cp and os.path.exists(cp):
                try:
                    with open(cp, "r", encoding="utf-8") as f:
                        s = json.load(f)
                        raw_model = s.get("model")
                        if raw_model:
                            model_name = str(raw_model)
                        if not effort and s.get("effort"):
                            effort = str(s.get("effort"))
                        if model_name:
                            break
                except Exception:
                    pass

    if not model_name:
        model_name = "Gemini 3.8 Flash (High)"

    model_name, slug_effort = _prettify_model_slug(str(model_name))
    if slug_effort and not effort:
        effort = slug_effort

    if model_name.endswith(")") and "(" in model_name:
        lp = model_name.rfind("(")
        embedded_effort = model_name[lp + 1 : -1].strip()
        if embedded_effort.lower() in (
            "low", "medium", "med", "high", "xhigh", "max", "ultra", "minimal"
        ):
            if not effort:
                effort = embedded_effort
            model_name = model_name[:lp].strip()

    if not effort:
        effort = "high"

    effort_lower = str(effort).strip().lower()
    if effort_lower in ("high", "h"):
        effort_color = C_YELLOW
    elif effort_lower in ("max", "ultra", "xhigh"):
        effort_color = C_RED
    elif effort_lower in ("medium", "med", "m"):
        effort_color = C_BLUE
    else:
        effort_color = C_DIM

    badge = f"{C_PURPLE}🤖 {model_name}{C_RESET} {effort_color}({effort_lower}){C_RESET}"
    return badge, model_name, effort_lower


def get_quota_for_model(quota: dict | None, model_name: str) -> tuple[float, str | None, float, str | None, str]:
    """Returns (frac_5h, reset_5h, frac_sem, reset_sem, label) based on active model family."""
    m = (model_name or "").lower()
    is_claude_family = any(k in m for k in ("claude", "sonnet", "opus", "haiku", "gpt"))
    label = "Claude" if is_claude_family else "Gemini"

    if not quota:
        return 1.0, None, 1.0, None, label

    if is_claude_family:
        frac_5h = quota.get("claude_5h_fraction")
        if frac_5h is None:
            frac_5h = 1.0
        reset_5h = quota.get("claude_5h_reset")
        frac_sem = quota.get("claude_weekly_fraction")
        if frac_sem is None:
            frac_sem = 1.0
        reset_sem = quota.get("claude_weekly_reset")
        is_disabled = bool(quota.get("claude_disabled", False))

        if frac_sem <= 0.0005 or is_disabled:
            return 0.0, (reset_5h or reset_sem), 0.0, reset_sem, "Claude"
        return float(frac_5h), reset_5h, float(frac_sem), reset_sem, "Claude"

    frac_5h = quota.get("gemini_5h_fraction")
    if frac_5h is None:
        frac_5h = 1.0
    reset_5h = quota.get("gemini_5h_reset")
    frac_sem = quota.get("gemini_weekly_fraction")
    if frac_sem is None:
        frac_sem = 1.0
    reset_sem = quota.get("gemini_weekly_reset")
    is_disabled = bool(quota.get("gemini_disabled", False))

    if frac_sem <= 0.0005 or is_disabled:
        return 0.0, (reset_5h or reset_sem), 0.0, reset_sem, "Gemini"
    return float(frac_5h), reset_5h, float(frac_sem), reset_sem, "Gemini"


def find_parent_agy_pid() -> int | None:
    """Climbs the process tree to find the parent agy CLI process (Linux /proc; win32 PPID/run_dir on Windows)."""
    if IS_WINDOWS:
        if platform is not None and hasattr(platform, "find_ancestor_agy_pid"):
            try:
                anc_pid = platform.find_ancestor_agy_pid()
                if anc_pid is not None:
                    return int(anc_pid)
            except Exception:
                pass
        pane_id = (os.environ.get("HERDR_PANE_ID") or "").strip()
        if not pane_id or platform is None:
            return None
        try:
            procs = platform.scan_agy_processes(run_dir=platform.get_run_dir(REAL_HOME))
            ppid = os.getppid()
            for p in procs:
                if p.get("pid") == ppid:
                    return ppid
            for p in procs:
                if p.get("herdr_pane_id") == pane_id:
                    return int(p["pid"])
        except Exception:
            pass
        return None
    try:
        pid = os.getppid()
        for _ in range(8):
            if pid <= 1:
                break
            cmd_file = f"/proc/{pid}/cmdline"
            if os.path.exists(cmd_file):
                try:
                    with open(cmd_file, "rb") as f:
                        cmd = f.read().decode("utf-8", errors="ignore")
                    if "agy" in cmd and "statusline" not in cmd and "titleline" not in cmd and "topbar" not in cmd:
                        return pid
                except Exception:
                    pass
            status_file = f"/proc/{pid}/status"
            if not os.path.exists(status_file):
                break
            ppid = None
            with open(status_file, "r", encoding="utf-8") as sf:
                for line in sf:
                    if line.startswith("PPid:"):
                        ppid = int(line.split()[1])
                        break
            if not ppid or ppid <= 1 or ppid == pid:
                break
            pid = ppid
    except Exception:
        pass
    return None


def get_herdr_env() -> tuple[str | None, str | None]:
    """Detects (HERDR_SOCKET_PATH, HERDR_PANE_ID) from os.environ or parent /proc/<pid>/environ."""
    sock_path = os.environ.get("HERDR_SOCKET_PATH")
    pane_id = os.environ.get("HERDR_PANE_ID")

    if (not sock_path or not pane_id) and not IS_WINDOWS:
        pid = find_parent_agy_pid() or os.getppid()
        cur = pid
        for _ in range(4):
            if not cur or cur <= 1:
                break
            env_file = f"/proc/{cur}/environ"
            if os.path.exists(env_file):
                try:
                    with open(env_file, "rb") as ef:
                        for entry in ef.read().split(b"\x00"):
                            if entry.startswith(b"HERDR_PANE_ID=") and not pane_id:
                                pane_id = entry[14:].decode("utf-8", errors="ignore").strip()
                            elif entry.startswith(b"HERDR_SOCKET_PATH=") and not sock_path:
                                sock_path = entry[18:].decode("utf-8", errors="ignore").strip()
                except Exception:
                    pass
            if sock_path and pane_id:
                break
            status_file = f"/proc/{cur}/status"
            if not os.path.exists(status_file):
                break
            nxt = 0
            try:
                with open(status_file, "r", encoding="utf-8") as sf:
                    for line in sf:
                        if line.startswith("PPid:"):
                            nxt = int(line.split()[1])
                            break
            except Exception:
                break
            if nxt <= 1 or nxt == cur:
                break
            cur = nxt

    if pane_id and not sock_path:
        default_sock = (
            platform.default_herdr_socket_path(REAL_HOME)
            if platform is not None
            else os.path.join(REAL_HOME, ".config", "herdr", "herdr.sock")
        )
        if default_sock and os.path.exists(default_sock):
            sock_path = default_sock

    return sock_path, pane_id


def is_quota_initialized(cached: dict | None, stdin_quota: dict | None) -> bool:
    """Returns True only when real quota measurements exist (excludes uninitialized state)."""
    quota_keys = (
        "fetched_at",
        "gemini_5h_fraction",
        "gemini_weekly_fraction",
        "claude_5h_fraction",
        "claude_weekly_fraction",
        "gemini_disabled",
        "claude_disabled",
    )
    if isinstance(cached, dict) and any(k in cached for k in quota_keys):
        return True
    if isinstance(stdin_quota, dict):
        for sb_key in (
            "gemini-5h",
            "gemini_5h",
            "gemini-weekly",
            "gemini_weekly",
            "3p-5h",
            "claude-5h",
            "3p_5h",
            "3p-weekly",
            "claude-weekly",
            "3p_weekly",
        ):
            sb = stdin_quota.get(sb_key)
            if isinstance(sb, dict) and (
                sb.get("remaining_fraction") is not None
                or sb.get("remainingFraction") is not None
                or sb.get("disabled") is not None
            ):
                return True
    return False


def build_low_quota_badge(eff_pct: int, quota_initialized: bool = True) -> str | None:
    """Builds compact ANSI low-quota badge when effective model quota <= 15%."""
    if not quota_initialized or eff_pct > LOW_QUOTA_THRESHOLD_PCT:
        return None
    if eff_pct <= 0:
        return f"{C_BOLD}{C_RED}⚠ AGOTADA{C_RESET}"
    return f"{C_BOLD}{C_ORANGE}⚠ ≤15%{C_RESET}"


def _query_herdr_busy_accounts(sock_path: str | None, exclude_pane_id: str | None = None) -> set[str]:
    """Queries Herdr pane.list via lib.platform IPC to detect accounts active in other panes."""
    busy: set[str] = set()
    if platform is None:
        return busy
    try:
        resp = platform.query_herdr_ipc(
            sock_path,
            {"id": "1", "method": "pane.list", "params": {}},
            timeout=0.03,
        )
        if not isinstance(resp, dict):
            return busy
        panes = (resp.get("result") or {}).get("panes") or []
        for pane in panes:
            if not isinstance(pane, dict):
                continue
            pid_str = pane.get("pane_id")
            if exclude_pane_id and pid_str == exclude_pane_id:
                continue
            session = pane.get("agent_session") if isinstance(pane.get("agent_session"), dict) else {}
            disp = str(pane.get("display_agent") or "")
            t_strip = str(pane.get("terminal_title_stripped") or "")
            t_raw = str(pane.get("terminal_title") or "")
            is_agy = (
                pane.get("agent") == "agy"
                or session.get("agent") == "agy"
                or "⚡ agy" in disp
                or "⚡ agy" in t_strip
            )
            if not is_agy:
                continue
            for field_val in (disp, t_strip, t_raw, str(pane.get("label") or "")):
                alias = extract_agy_alias(field_val)
                if alias:
                    busy.add(alias.lower())
                    break
    except Exception:
        pass
    return busy


def find_suggested_replacement_account(
    account: str,
    model_name: str,
    *,
    real_home: str | None = None,
    cache_dir: str | None = None,
    sock_path: str | None = None,
    current_pane_id: str | None = None,
) -> tuple[str, str, int, int] | None:
    """Selects best replacement account (<3ms local file scan):
    - Excludes current account, is_revoked == True, locked == True, low quota (<=15%), and busy Herdr panes.
    - Enforces plan_type == 'ULTRA' when model contains 'carbon'; otherwise prefers healthy PRO accounts (Reserva ULTRA).
    Returns (alias, plan_type, p5, ps) or None.
    """
    base_home = real_home if real_home is not None else REAL_HOME
    if cache_dir is not None:
        cdir = cache_dir
    elif base_home != REAL_HOME:
        cdir = platform.get_cache_dir(base_home) if platform is not None else os.path.join(base_home, ".cache", "agyc")
    else:
        cdir = CACHE_DIR

    acc_dirs = [os.path.join(base_home, ".gemini", "antigravity-cli", "accounts")]
    if base_home == REAL_HOME and not IS_WINDOWS:
        acc_dirs.append(
            os.path.join(base_home, "snap", "antigravity-cli", "common", ".gemini", "antigravity-cli", "accounts")
        )
    accounts_dir = next((d for d in acc_dirs if os.path.isdir(d)), None)
    if not accounts_dir:
        return None

    extra_locked: set[str] = set()
    for meta_fname in ("config.json", "meta.json"):
        mp = os.path.join(accounts_dir, meta_fname)
        if os.path.isfile(mp):
            try:
                with open(mp, "r", encoding="utf-8") as mf:
                    mdata = json.load(mf)
                if isinstance(mdata, dict):
                    for lk_key in ("locks", "locked", "locked_accounts"):
                        lk_obj = mdata.get(lk_key)
                        if isinstance(lk_obj, dict):
                            for k, v in lk_obj.items():
                                if v:
                                    extra_locked.add(str(k).lower())
                        elif isinstance(lk_obj, list):
                            for k in lk_obj:
                                extra_locked.add(str(k).lower())
            except Exception:
                pass

    busy_accounts = _query_herdr_busy_accounts(sock_path, exclude_pane_id=current_pane_id)
    needs_ultra = "carbon" in (model_name or "").lower()
    curr_lower = (account or "").strip().lower()

    best_key: tuple[int, int, int, int] | None = None
    best_choice: tuple[str, str, int, int] | None = None

    try:
        entries = sorted(os.listdir(accounts_dir))
    except Exception:
        return None

    for fname in entries:
        if not (fname.startswith("agy") and fname.endswith(".json")):
            continue
        cand_alias = fname[:-5]
        cand_low = cand_alias.lower()
        if extract_agy_alias(cand_low) != cand_low:
            continue
        if cand_low == curr_lower or cand_low in extra_locked or cand_low in busy_accounts:
            continue

        try:
            with open(os.path.join(accounts_dir, fname), "r", encoding="utf-8") as af:
                acc_data = json.load(af)
        except Exception:
            continue
        if not isinstance(acc_data, dict):
            continue

        if (
            bool(acc_data.get("is_revoked", False))
            or bool(acc_data.get("locked", False))
            or bool(acc_data.get("is_locked", False))
        ):
            continue

        q_data: dict = {}
        q_cache_path = os.path.join(cdir, f"quota_cache_{cand_alias}.json")
        if os.path.isfile(q_cache_path):
            try:
                with open(q_cache_path, "r", encoding="utf-8") as qf:
                    loaded_q = json.load(qf)
                if isinstance(loaded_q, dict):
                    q_data = loaded_q
            except Exception:
                q_data = {}
        if not q_data and isinstance(acc_data.get("quota"), dict):
            q_data = dict(acc_data["quota"])

        raw_plan = q_data.get("plan_type") or acc_data.get("plan_type")
        supports_cb = bool(q_data.get("supports_carbon") or acc_data.get("supports_carbon"))
        if raw_plan:
            cand_plan = str(raw_plan).strip().upper()
        elif supports_cb:
            cand_plan = "ULTRA"
        else:
            cand_plan = "PRO"

        if needs_ultra and cand_plan != "ULTRA":
            continue

        norm_q = merge_cached_and_stdin_quota(q_data, None) if q_data else None
        cf5, _, cfs, _, _ = get_quota_for_model(norm_q, model_name)
        cp5 = fmt_pct(cf5)
        cps = fmt_pct(cfs)
        if min(cp5, cps) <= LOW_QUOTA_THRESHOLD_PCT:
            continue

        if needs_ultra:
            tier_rank = 1
        else:
            # Reserva ULTRA: prefer healthy PRO accounts before touching ULTRA
            tier_rank = 2 if cand_plan == "PRO" else (1 if cand_plan != "ULTRA" else 0)

        try:
            alias_num = int(cand_low[3:])
        except Exception:
            alias_num = 99

        cand_key = (tier_rank, cp5, cps, -alias_num)
        if best_key is None or cand_key > best_key:
            best_key = cand_key
            best_choice = (cand_alias, cand_plan, cp5, cps)

    return best_choice


def maybe_notify_low_quota(
    account: str,
    model_name: str,
    family: str,
    p5: int,
    ps: int,
    r5: str | None = None,
    rs: str | None = None,
    *,
    quota_initialized: bool = True,
    real_home: str | None = None,
    cache_dir: str | None = None,
    sock_path: str | None = None,
    current_pane_id: str | None = None,
    now_ts: float | None = None,
) -> dict | None:
    """Sends a single deduplicated Herdr toast notification per reset cycle when min(p5, ps) <= 15%.
    Supports isolated testing via AGYC_TEST_HERDR_CMD or explicit real_home/cache_dir.
    """
    if not quota_initialized:
        return None

    eff_pct = min(int(p5), int(ps))
    if eff_pct > LOW_QUOTA_THRESHOLD_PCT:
        return None

    if real_home is not None:
        base_home = real_home
    else:
        env_rh = os.environ.get("AGYC_REAL_HOME", "").strip()
        base_home = env_rh if (env_rh and os.path.isdir(env_rh)) else REAL_HOME

    if cache_dir is not None:
        cdir = cache_dir
    elif base_home != REAL_HOME:
        cdir = platform.get_cache_dir(base_home) if platform is not None else os.path.join(base_home, ".cache", "agyc")
    else:
        cdir = CACHE_DIR

    ts = float(now_ts) if now_ts is not None else time.time()
    safe_account = safe_cache_key((account or "agy01").strip().lower())
    fam_norm = "claude" if "claude" in (family or "").lower() else "gemini"
    fam_label = "Claude" if fam_norm == "claude" else "Gemini"
    reset_key = str(r5 or rs or "active")
    alert_file = os.path.join(cdir, f"low_quota_alert_{safe_account}_{fam_norm}.json")

    # Fast-path read deduplication (<0.1ms)
    if os.path.isfile(alert_file):
        try:
            with open(alert_file, "r", encoding="utf-8") as af:
                prev = json.load(af)
            if isinstance(prev, dict) and str(prev.get("reset_key", "")) == reset_key:
                prev_ts = float(prev.get("notified_at", 0) or 0)
                if 0 <= (ts - prev_ts) < LOW_QUOTA_DEDUP_SECONDS:
                    return None
        except Exception:
            pass

    test_cmd = os.environ.get("AGYC_TEST_HERDR_CMD", "").strip()
    if sock_path is not None:
        eff_sock: str | None = sock_path
    elif base_home != REAL_HOME:
        if platform is not None:
            cand_sock = platform.default_herdr_socket_path(base_home)
        else:
            cand_sock = os.path.join(base_home, ".config", "herdr", "herdr.sock")
        eff_sock = cand_sock if (cand_sock and os.path.exists(cand_sock)) else None
    else:
        eff_sock = None
        sock_cands = []
        if platform is not None:
            sock_cands.append(platform.default_herdr_socket_path(base_home))
        sock_cands.extend([
            os.environ.get("HERDR_SOCKET_PATH", "").strip(),
            os.path.join(base_home, ".config", "herdr", "herdr.sock"),
        ])
        if not IS_WINDOWS:
            sock_cands.append("/home/aidev/.config/herdr/herdr.sock")
        for sc in sock_cands:
            if sc and os.path.exists(sc):
                eff_sock = sc
                break

    herdr_bin: str | None = None
    if IS_WINDOWS:
        import shutil
        herdr_cands = [
            os.environ.get("HERDR_BIN_PATH", "").strip(),
            shutil.which("herdr.exe"),
            shutil.which("herdr"),
            os.path.join(base_home, ".local", "bin", "herdr.exe"),
            os.path.join(os.environ.get("LOCALAPPDATA", ""), "herdr", "herdr.exe") if os.environ.get("LOCALAPPDATA") else "",
        ]
        for hc in herdr_cands:
            if hc and os.path.isfile(hc):
                herdr_bin = hc
                break
    else:
        import shutil
        linux_cands = [
            os.path.join(base_home, ".local", "bin", "herdr"),
            "/home/aidev/.local/bin/herdr",
            shutil.which("herdr"),
        ]
        for hc in linux_cands:
            if hc and os.path.isfile(hc) and os.access(hc, os.X_OK):
                herdr_bin = hc
                break

    if test_cmd:
        can_notify = True
    else:
        herdr_active = (
            (os.environ.get("HERDR_ENV") == "1")
            or bool(os.environ.get("HERDR_PANE_ID"))
            or bool(eff_sock and os.path.exists(eff_sock))
        )
        if IS_WINDOWS:
            can_notify = herdr_active
        else:
            can_notify = herdr_active and bool(herdr_bin) and os.path.isfile(herdr_bin) and os.access(herdr_bin, os.X_OK)

    if not can_notify:
        return None

    locks_dir = os.path.join(cdir, "locks")
    if platform is not None:
        try:
            platform.ensure_private_dir(locks_dir, 0o700)
        except Exception:
            pass
    else:
        try:
            os.makedirs(locks_dir, mode=0o700, exist_ok=True)
        except Exception:
            pass

    lock_path = os.path.join(locks_dir, f"low_quota_{safe_account}_{fam_norm}.lock")
    file_lock = None
    if platform is not None:
        try:
            file_lock = platform.acquire_file_lock(lock_path, blocking=False)
        except BlockingIOError:
            return None
        except Exception:
            file_lock = None

    try:
        # Re-check inside lock to avoid concurrent statusline + titleline race
        if os.path.isfile(alert_file):
            try:
                with open(alert_file, "r", encoding="utf-8") as af:
                    prev = json.load(af)
                if isinstance(prev, dict) and str(prev.get("reset_key", "")) == reset_key:
                    prev_ts = float(prev.get("notified_at", 0) or 0)
                    if 0 <= (ts - prev_ts) < LOW_QUOTA_DEDUP_SECONDS:
                        return None
            except Exception:
                pass

        suggested = find_suggested_replacement_account(
            account,
            model_name,
            real_home=base_home,
            cache_dir=cdir,
            sock_path=eff_sock,
            current_pane_id=current_pane_id,
        )

        title = f"⚠ Cuota baja en {account} ({eff_pct}%)"
        if suggested is not None:
            best_alias, best_plan, best_p5, _ = suggested
            body = f"Sugerida libre: {best_alias} [{best_plan}] ({best_p5}% 5H) · Ejecuta: agyc auto"
        else:
            body = f"Ventana {fam_label} al {eff_pct}% · Revisa con: agyc list"

        try:
            atomic_write_json(
                alert_file,
                {"reset_key": reset_key, "notified_at": ts},
                mode=0o600,
            )
        except Exception:
            pass

        if test_cmd:
            if test_cmd.lower() not in ("0", "none", "noop", "dry-run", "dry_run"):
                if platform is not None:
                    platform.send_low_quota_toast(title, body, herdr_bin=test_cmd)
                else:
                    try:
                        import subprocess
                        subprocess.Popen(
                            [
                                test_cmd,
                                "notification",
                                "show",
                                "--position",
                                "top-right",
                                "--sound",
                                "none",
                                "--body",
                                body,
                                title,
                            ],
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                            start_new_session=not IS_WINDOWS,
                        )
                    except Exception:
                        pass
        else:
            if platform is not None:
                platform.send_low_quota_toast(title, body, herdr_bin=herdr_bin)
            elif herdr_bin:
                try:
                    import subprocess
                    subprocess.Popen(
                        [
                            herdr_bin,
                            "notification",
                            "show",
                            "--position",
                            "top-right",
                            "--sound",
                            "none",
                            "--body",
                            body,
                            title,
                        ],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        start_new_session=not IS_WINDOWS,
                    )
                except Exception:
                    pass

        return {
            "title": title,
            "body": body,
            "reset_key": reset_key,
            "notified_at": ts,
            "suggested": suggested[0] if suggested else None,
            "suggested_plan": suggested[1] if suggested else None,
        }
    finally:
        if file_lock is not None:
            file_lock.release()


def report_herdr_pane_metadata(
    account: str,
    plan_type: str | None,
    model_name: str,
    p5: int,
    ctx_percent: int,
    ps: int,
    allow_without_parent: bool = False,
    low_quota: bool | None = None,
) -> None:
    """Reports live account, plan, model and 5H -> Ctx -> Sem telemetry to Herdr pane header.
    Uses 8s throttle in ~/.cache/agyc/herdr_meta_{safe_pane}.json with immediate bypass on
    account/plan/model/low_quota change or abs(ctx_pct - prev_ctx) >= 3.
    """
    if not allow_without_parent and find_parent_agy_pid() is None:
        return

    sock_path, pane_id = get_herdr_env()
    if not sock_path or not pane_id or not os.path.exists(sock_path):
        return

    ensure_cache_dir()
    safe_pane = safe_cache_key(pane_id)
    meta_file = os.path.join(CACHE_DIR, f"herdr_meta_{safe_pane}.json")
    now_ts = time.time()

    plan_tag = (plan_type or "").strip().upper()
    short_model = model_name.strip()
    is_low = (min(p5, ps) <= LOW_QUOTA_THRESHOLD_PCT) if low_quota is None else bool(low_quota)

    if os.path.exists(meta_file):
        try:
            with open(meta_file, "r", encoding="utf-8") as f:
                prev = json.load(f)
            if isinstance(prev, dict):
                last_ts = float(prev.get("ts", 0) or 0)
                same_identity = (
                    prev.get("account") == account
                    and prev.get("plan") == plan_tag
                    and prev.get("model") == short_model
                    and bool(prev.get("low_quota", False)) == is_low
                )
                prev_ctx = prev.get("ctx_pct")
                ctx_changed = (prev_ctx is None) or (abs(ctx_percent - int(prev_ctx)) >= 3)
                if same_identity and not ctx_changed and (now_ts - last_ts < HERDR_META_THROTTLE_SECONDS):
                    return
        except Exception:
            pass

    try:
        atomic_write_json(
            meta_file,
            {
                "ts": now_ts,
                "account": account,
                "plan": plan_tag,
                "model": short_model,
                "ctx_pct": ctx_percent,
                "p5": p5,
                "ps": ps,
                "low_quota": is_low,
            },
            mode=0o600,
        )
    except Exception:
        pass

    seq = int(now_ts * 1000)
    acc_head = f"⚡ {account} [{plan_tag}]" if plan_tag else f"⚡ {account}"
    if is_low:
        acc_head = f"⚠ {acc_head}"
    display_agent = f"{acc_head} · {short_model} · 5H:{p5}% Ctx:{ctx_percent}% Sem:{ps}%"
    tokens: dict[str, str | None] = {
        "quota": f"5H:{p5}% Ctx:{ctx_percent}% Sem:{ps}%",
        "ctx": f"{ctx_percent}%",
        "ctx_pct": str(ctx_percent),
        "plan": plan_tag if plan_tag else None,
    }

    payload = {
        "id": f"agyc:{seq}",
        "method": "pane.report_metadata",
        "params": {
            "pane_id": pane_id,
            "source": "agyc",
            "display_agent": display_agent,
            "tokens": tokens,
            "seq": seq,
        },
    }

    if platform is not None:
        try:
            platform.query_herdr_ipc(sock_path, payload, timeout=0.05)
        except Exception:
            pass


def get_session_conv_id(account: str = "agy01") -> str | None:
    """Detects conversation ID specific to THIS terminal instance of agy."""
    env_conv = os.environ.get("ANTIGRAVITY_CONVERSATION_ID") or os.environ.get("AGYC_CONV_ID")
    if env_conv and env_conv.strip():
        return env_conv.strip()

    if IS_WINDOWS:
        # Avoid /proc on Windows; safely inspect conversations/*.db if available
        cand_dirs = [
            os.path.join(os.environ.get("ANTIGRAVITY_APP_DATA_DIR", ""), "conversations")
            if os.environ.get("ANTIGRAVITY_APP_DATA_DIR")
            else "",
            os.path.join(REAL_HOME, ".agyc_homes", account, ".gemini", "antigravity-cli", "conversations"),
            os.path.join(REAL_HOME, ".gemini", "antigravity-cli", "conversations"),
        ]
        best_cid: str | None = None
        best_mtime: float = -1.0
        for cdir in cand_dirs:
            if not cdir or not os.path.isdir(cdir):
                continue
            try:
                with os.scandir(cdir) as it:
                    for entry in it:
                        name = entry.name
                        if not name.endswith(".db"):
                            continue
                        cid = name[:-3]
                        if len(cid) == 36 and cid.count("-") == 4:
                            try:
                                mt = entry.stat().st_mtime
                                if mt > best_mtime:
                                    best_mtime = mt
                                    best_cid = cid
                            except OSError:
                                pass
            except OSError:
                continue
            if best_cid:
                return best_cid
        return None

    agy_pid = find_parent_agy_pid()
    if not agy_pid:
        return None

    fd_dir = f"/proc/{agy_pid}/fd"
    if not os.path.isdir(fd_dir):
        return None

    marker = "conversations/"
    try:
        for fd in os.listdir(fd_dir):
            try:
                target = os.readlink(os.path.join(fd_dir, fd))
                mi = target.find(marker)
                if mi != -1 and target.endswith(".db"):
                    cid = target[mi + len(marker) : -3]
                    if len(cid) == 36 and cid.count("-") == 4:
                        return cid
            except Exception:
                pass
    except Exception:
        pass
    return None


def find_active_transcript(conv_id: str | None = None, account: str = "agy01") -> str | None:
    """Finds the conversation transcript file for THIS specific terminal session."""
    if not conv_id:
        conv_id = get_session_conv_id(account=account)
    if not conv_id:
        return None

    candidate_bases = [
        os.environ.get("ANTIGRAVITY_APP_DATA_DIR"),
        os.path.join(REAL_HOME, ".agyc_homes", account, ".gemini", "antigravity-cli"),
        os.path.join(REAL_HOME, ".gemini", "antigravity-cli"),
    ]
    if platform is not None:
        base_dir = platform.get_base_dir(REAL_HOME)
        if base_dir not in candidate_bases:
            candidate_bases.append(base_dir)

    for base in candidate_bases:
        if not base or not os.path.isdir(base):
            continue
        log_dir = os.path.join(base, "brain", conv_id, ".system_generated", "logs")
        for fname in ("transcript.jsonl", "transcript_full.jsonl"):
            cand = os.path.join(log_dir, fname)
            if os.path.isfile(cand):
                return cand
    return None


def _scan_transcript_window(raw_bytes: bytes, drop_first_partial: bool, max_tokens: int) -> tuple[float, int, int] | None:
    lines = raw_bytes.splitlines()
    if drop_first_partial and lines:
        lines = lines[1:]
    trailing_chars = 0

    for raw_line in reversed(lines):
        line_str = raw_line.decode("utf-8", errors="ignore").strip()
        if not line_str:
            continue
        try:
            entry = json.loads(line_str)
        except Exception:
            trailing_chars += len(line_str)
            continue
        if not isinstance(entry, dict):
            continue

        etype = str(entry.get("type") or "")
        raw_content = entry.get("content")
        if isinstance(raw_content, str):
            content_str = raw_content
        elif raw_content is not None:
            content_str = json.dumps(raw_content, ensure_ascii=False)
        else:
            content_str = ""

        # 1. Compaction marker reached before any PLANNER_RESPONSE with token usage
        if (
            etype in ("CHECKPOINT", "CONTEXT_SUMMARY", "COMPACTION")
            or "# Resuming from a compaction" in content_str
            or "<CONTEXT_SUMMARY>" in content_str
        ):
            est = 16_000 + int((trailing_chars + len(content_str)) / 4.0)
            frac = min(1.0, max(0.0, est / float(max_tokens)))
            return (frac, est, max_tokens)

        # 2. Latest PLANNER_RESPONSE with real token usage counters
        if etype == "PLANNER_RESPONSE":
            usage = entry.get("usage") if isinstance(entry.get("usage"), dict) else {}
            in_tok = entry.get("input_tokens") if entry.get("input_tokens") is not None else usage.get("input_tokens")
            cr_tok = entry.get("cache_read_tokens")
            if cr_tok is None:
                cr_tok = entry.get("cache_read_input_tokens")
            if cr_tok is None:
                cr_tok = usage.get("cache_read_tokens")
            if cr_tok is None:
                cr_tok = usage.get("cache_read_input_tokens")
            cc_tok = entry.get("cache_creation_input_tokens")
            if cc_tok is None:
                cc_tok = entry.get("cache_creation_tokens")
            if cc_tok is None:
                cc_tok = usage.get("cache_creation_input_tokens")
            if cc_tok is None:
                cc_tok = usage.get("cache_creation_tokens")
            out_tok = entry.get("output_tokens") if entry.get("output_tokens") is not None else usage.get("output_tokens")

            if in_tok is not None or cr_tok is not None:
                est = (
                    _safe_nonneg_int(in_tok)
                    + _safe_nonneg_int(cr_tok)
                    + _safe_nonneg_int(cc_tok)
                    + _safe_nonneg_int(out_tok)
                    + int(trailing_chars / 4.0)
                )
                frac = min(1.0, max(0.0, est / float(max_tokens)))
                return (frac, est, max_tokens)

        step_chars = len(content_str)
        if entry.get("tool_calls"):
            try:
                step_chars += len(json.dumps(entry["tool_calls"], ensure_ascii=False))
            except Exception:
                pass
        trailing_chars += step_chars

    return None


def estimate_context_from_transcript(transcript_path: str, max_tokens: int) -> tuple[float, int, int]:
    """O(1) tail context estimator from EOF (128 KB -> 512 KB -> post-CHECKPOINT legacy fallback).
    Never uses pre-compaction full file size.
    """
    if max_tokens <= 0:
        max_tokens = 1_048_576
    if not transcript_path or not os.path.isfile(transcript_path):
        return (0.0, 0, max_tokens)

    try:
        file_size = os.path.getsize(transcript_path)
    except Exception:
        return (0.0, 0, max_tokens)

    if file_size <= 0:
        return (0.0, 0, max_tokens)

    try:
        with open(transcript_path, "rb") as f:
            for win_bytes in (131_072, 524_288):
                offset = max(0, file_size - win_bytes)
                f.seek(offset)
                buf = f.read(file_size - offset)
                res = _scan_transcript_window(buf, drop_first_partial=(offset > 0), max_tokens=max_tokens)
                if res is not None:
                    return res
                if offset == 0:
                    break

            # Legacy fallback: bytes after the last CHECKPOINT / compaction marker divided by 4
            chunk_size = 1_048_576
            pos = file_size
            overlap = b""
            markers = (b'"CHECKPOINT"', b'"CONTEXT_SUMMARY"', b'"COMPACTION"', b"# Resuming from a compaction", b"<CONTEXT_SUMMARY>")
            while pos > 0:
                read_start = max(0, pos - chunk_size)
                f.seek(read_start)
                chunk = f.read(pos - read_start)
                search_buf = chunk + overlap
                best_idx = -1
                for mk in markers:
                    idx = search_buf.rfind(mk)
                    if idx > best_idx:
                        best_idx = idx
                if best_idx != -1:
                    nl_idx = search_buf.rfind(b"\n", 0, best_idx)
                    line_offset = read_start + (nl_idx + 1 if nl_idx != -1 else 0)
                    bytes_after = max(0, file_size - line_offset)
                    est = int(bytes_after / 4.0)
                    frac = min(1.0, max(0.0, est / float(max_tokens)))
                    return (frac, est, max_tokens)
                overlap = chunk[:128]
                pos = read_start
    except Exception:
        return (0.0, 0, max_tokens)

    # Uncompacted small legacy transcript with no token counters and no CHECKPOINT
    est = int(file_size / 4.0)
    frac = min(1.0, max(0.0, est / float(max_tokens)))
    return (frac, est, max_tokens)


def resolve_conv_and_transcript(stdin_data: dict | None, account: str = "agy01") -> tuple[str | None, str | None]:
    """Resolves (conv_id, transcript_path) with minimal overhead."""
    conv_id: str | None = None
    transcript_path: str | None = None

    if isinstance(stdin_data, dict):
        raw_cid = stdin_data.get("conversation_id") or stdin_data.get("session_id")
        if isinstance(raw_cid, str) and raw_cid.strip():
            conv_id = raw_cid.strip()
        raw_tp = stdin_data.get("transcript_path")
        if isinstance(raw_tp, str) and raw_tp.strip() and os.path.isfile(raw_tp.strip()):
            transcript_path = raw_tp.strip()

    if not conv_id:
        conv_id = get_session_conv_id(account=account)

    if not transcript_path and conv_id:
        transcript_path = find_active_transcript(conv_id, account=account)

    return conv_id, transcript_path


def get_context_usage(
    stdin_data: dict | None,
    model_name: str = "",
    account: str = "agy01",
    transcript_path: str | None = None,
) -> tuple[float, int, int]:
    """Returns (fraction, used_tokens, max_tokens) with exact current_usage + O(1) transcript fallback."""
    default_max = default_max_tokens_for_model(model_name)
    ctx = None
    if isinstance(stdin_data, dict):
        raw_ctx = stdin_data.get("context_window")
        if not isinstance(raw_ctx, dict):
            raw_ctx = stdin_data.get("context")
        if isinstance(raw_ctx, dict):
            ctx = raw_ctx

    max_t = default_max
    if isinstance(ctx, dict):
        raw_max = ctx.get("context_window_size")
        if raw_max is None:
            raw_max = ctx.get("max_tokens")
        parsed_max = _safe_nonneg_int(raw_max)
        if parsed_max > 0:
            max_t = parsed_max

    # Priority 1: Live CascadeState current_usage dict (never cumulative total_output_tokens / total_input_tokens)
    if isinstance(ctx, dict) and isinstance(ctx.get("current_usage"), dict):
        cu = ctx["current_usage"]
        cu_in = _safe_nonneg_int(cu.get("input_tokens"))
        cu_cc = _safe_nonneg_int(
            cu.get("cache_creation_input_tokens")
            if cu.get("cache_creation_input_tokens") is not None
            else cu.get("cache_creation_tokens")
        )
        cu_cr = _safe_nonneg_int(
            cu.get("cache_read_input_tokens")
            if cu.get("cache_read_input_tokens") is not None
            else cu.get("cache_read_tokens")
        )
        cu_out = _safe_nonneg_int(cu.get("output_tokens"))
        cu_tokens = cu_in + cu_cc + cu_cr + cu_out

        raw_pct = ctx.get("used_percentage")
        pct_val: float | None = None
        if raw_pct is not None and not isinstance(raw_pct, bool):
            try:
                cand_pct = float(raw_pct)
                if 0.0 <= cand_pct <= 100.0:
                    pct_val = cand_pct
            except Exception:
                pct_val = None

        if pct_val is not None:
            pct_tokens = int(round((pct_val / 100.0) * max_t))
            if cu_tokens == 0:
                frac = min(1.0, max(0.0, pct_val / 100.0))
                return (frac, pct_tokens, max_t)
            # Respect post-compaction or multi-call intra-turn sum when used_percentage is < 60% of cu_tokens
            if cu_tokens >= max(16_384, int(max_t * 0.02)) and pct_tokens < cu_tokens * 0.6:
                frac = min(1.0, max(0.0, pct_val / 100.0))
                return (frac, pct_tokens, max_t)
            # Respect intra-turn growth if used_percentage exceeds cu_tokens beyond rounding tolerance
            if pct_tokens > cu_tokens + max(2_048, int(max_t * 0.01)):
                frac = min(1.0, max(0.0, pct_val / 100.0))
                return (frac, pct_tokens, max_t)

        frac = min(1.0, max(0.0, cu_tokens / float(max_t)))
        return (frac, cu_tokens, max_t)

    # Priority 2: current_usage is None (reopened session with CascadeState == nil or no stdin_data)
    if not transcript_path:
        _, transcript_path = resolve_conv_and_transcript(stdin_data, account=account)

    if transcript_path and os.path.isfile(transcript_path):
        return estimate_context_from_transcript(transcript_path, max_t)

    if isinstance(ctx, dict):
        raw_pct = ctx.get("used_percentage")
        if raw_pct is not None and not isinstance(raw_pct, bool):
            try:
                cand_pct = float(raw_pct)
                if 0.0 < cand_pct <= 100.0:
                    frac = min(1.0, cand_pct / 100.0)
                    return (frac, int(round(frac * max_t)), max_t)
            except Exception:
                pass
        tot_in = ctx.get("total_input_tokens")
        if tot_in is None or _safe_nonneg_int(tot_in) == 0:
            return (0.0, 0, max_t)

    return (0.0, 0, max_t)


def persist_pane_context(
    pane_id: str | None,
    conv_id: str | None,
    account: str,
    plan_type: str | None,
    model_name: str,
    effort: str,
    family: str,
    ctx_frac: float,
    ctx_pct: int,
    ctx_tokens: int,
    ctx_max: int,
    transcript_path: str | None,
    allow_without_parent: bool = False,
) -> None:
    """Atomically persists live context snapshot (0600) in ~/.cache/agyc/pane_ctx_{pane|conv}.json."""
    if not pane_id and not conv_id:
        return
    if not allow_without_parent and not conv_id and find_parent_agy_pid() is None:
        return

    ensure_cache_dir()
    payload = {
        "pane_id": pane_id,
        "conv_id": conv_id,
        "account": account,
        "plan": plan_type,
        "model": model_name,
        "effort": effort,
        "family": family,
        "ctx_frac": round(float(ctx_frac), 6),
        "ctx_pct": int(ctx_pct),
        "ctx_tokens": int(ctx_tokens),
        "ctx_max": int(ctx_max),
        "transcript_path": transcript_path,
        "updated_at": time.time(),
    }

    if pane_id:
        try:
            atomic_write_json(
                os.path.join(CACHE_DIR, f"pane_ctx_{safe_cache_key(pane_id)}.json"),
                payload,
                mode=0o600,
            )
        except Exception:
            pass

    if conv_id:
        try:
            atomic_write_json(
                os.path.join(CACHE_DIR, f"pane_ctx_{safe_cache_key(conv_id)}.json"),
                payload,
                mode=0o600,
            )
        except Exception:
            pass


def read_stdin_json(max_wait_sec: float = 0.020) -> dict | None:
    """Reads JSON from stdin non-blockingly up to `max_wait_sec` (default 20ms)."""
    try:
        if platform is None:
            return None
        raw = platform.read_stdin_nonblocking(max_wait_sec)
        if not raw:
            return None
        raw_str = raw.decode("utf-8", errors="replace").strip()
        if not raw_str.startswith("{"):
            return None
        data = json.loads(raw_str)
        return data if isinstance(data, dict) else None
    except Exception:
        return None


def build_account_badge(account: str, plan_type: str | None) -> str:
    """Renders ⚡ agy10·ULTRA (magenta) or ⚡ agy02·PRO (soft cyan/blue)."""
    pt = (plan_type or "").upper()
    if pt == "ULTRA":
        return f"{C_BOLD}{C_CYAN}⚡ {account}{C_RESET}{C_GRAY}·{C_RESET}{C_BOLD}{C_MAGENTA}ULTRA{C_RESET}"
    if pt == "PRO":
        return f"{C_BOLD}{C_CYAN}⚡ {account}{C_RESET}{C_GRAY}·{C_RESET}{C_BLUE}PRO{C_RESET}"
    if pt:
        return f"{C_BOLD}{C_CYAN}⚡ {account}{C_RESET}{C_GRAY}·{C_RESET}{C_DIM}{pt}{C_RESET}"
    return f"{C_BOLD}{C_CYAN}⚡ {account}{C_RESET}"


def main() -> None:
    prog_base = os.path.basename(sys.argv[0]).lower()
    for ext in (".cmd", ".exe", ".bat"):
        if prog_base.endswith(ext):
            prog_base = prog_base[: -len(ext)]
            break
    invoked_as = os.environ.pop("AGYC_INVOKED_AS", "").strip().lower()
    is_title_mode = ("--title" in sys.argv[1:]) or (prog_base == "agyc-titleline") or (invoked_as == "agyc-titleline")
    stdin_data = read_stdin_json(0.020)
    has_stdin = isinstance(stdin_data, dict)

    # 1. Active Account
    account = detect_active_account(stdin_data)

    # 2. Model & Effort
    model_badge, model_name, effort = get_model_and_effort(stdin_data, account)

    # 3. Quota (always read cached 20s TTL + merge stdin_quota in memory only, NEVER overwriting disk!)
    cached_quota = fetch_online_quota(account)
    stdin_quota = stdin_data.get("quota") if has_stdin else None
    quota = merge_cached_and_stdin_quota(cached_quota, stdin_quota)

    plan_type = resolve_plan_type(quota, account)
    f5, r5, fs, rs, family = get_quota_for_model(quota, model_name)
    p5 = fmt_pct(f5)
    ps = fmt_pct(fs)
    quota_init = is_quota_initialized(cached_quota, stdin_quota)
    eff_pct = min(p5, ps)
    is_low_quota = quota_init and (eff_pct <= LOW_QUOTA_THRESHOLD_PCT)

    # 4. Context Usage + Persistence BEFORE is_title_mode branch
    conv_id, transcript_path = resolve_conv_and_transcript(stdin_data, account=account)
    ctx_frac, ctx_tokens, ctx_max = get_context_usage(
        stdin_data,
        model_name,
        account=account,
        transcript_path=transcript_path,
    )
    ctx_percent = fmt_ctx_pct(ctx_frac)

    sock_path, pane_id = get_herdr_env()
    persist_pane_context(
        pane_id=pane_id,
        conv_id=conv_id,
        account=account,
        plan_type=plan_type,
        model_name=model_name,
        effort=effort,
        family=family,
        ctx_frac=ctx_frac,
        ctx_pct=ctx_percent,
        ctx_tokens=ctx_tokens,
        ctx_max=ctx_max,
        transcript_path=transcript_path,
        allow_without_parent=has_stdin,
    )

    # 5. Titleline Mode (--title or agyc-titleline): plain text without ANSI codes (5H -> Ctx -> Sem)
    if is_title_mode:
        acc_part = f"⚡ {account} [{plan_type}]" if plan_type else f"⚡ {account}"
        if is_low_quota:
            acc_part = f"⚠ {acc_part}"
        model_part = f"{model_name} ({effort})"
        part_5h = f"5H: {p5}%" if (p5 >= 100 or not r5) else f"5H: {p5}% ({format_countdown(r5)})"
        ctx_part = f"Ctx: {ctx_percent}%"
        part_sem = f"Sem: {ps}%" if (ps >= 100 or not rs) else f"Sem: {ps}% ({format_countdown(rs, default_val='7d 00h')})"
        print(" · ".join([acc_part, model_part, part_5h, ctx_part, part_sem]), flush=True)
        report_herdr_pane_metadata(
            account,
            plan_type,
            model_name,
            p5,
            ctx_percent,
            ps,
            allow_without_parent=has_stdin,
            low_quota=is_low_quota,
        )
        if is_low_quota and (has_stdin or find_parent_agy_pid() is not None or bool(os.environ.get("AGYC_TEST_HERDR_CMD"))):
            maybe_notify_low_quota(
                account,
                model_name,
                family,
                p5,
                ps,
                r5,
                rs,
                quota_initialized=quota_init,
                sock_path=sock_path,
                current_pane_id=pane_id,
            )
        sys.exit(0)

    # 6. Normal ANSI Statusline Mode (5H -> Ctx -> Sem)
    acc_badge = build_account_badge(account, plan_type)
    low_badge = build_low_quota_badge(eff_pct, quota_initialized=quota_init)

    branch, is_dirty = get_vcs_info(stdin_data)
    if branch:
        dirty_mark = f"{C_YELLOW}*{C_RESET}" if is_dirty else ""
        branch_badge = f"{C_BOLD}{C_GREEN}🌿 {branch}{C_RESET}{dirty_mark}"
    else:
        branch_badge = None

    c5 = C_GREEN if p5 >= 50 else (C_YELLOW if p5 >= 20 else C_RED)
    bar_5 = make_linebar(f5, length=8)
    if p5 >= 100 or not r5:
        str_5h = f"{C_YELLOW}5H:{C_RESET} {bar_5} {c5}{C_BOLD}{p5}%{C_RESET}"
    else:
        str_5h = f"{C_YELLOW}5H:{C_RESET} {bar_5} {c5}{C_BOLD}{p5}%{C_RESET} {C_DIM}(⏳ {format_countdown(r5)}){C_RESET}"

    ctx_bar = make_context_linebar(ctx_frac, length=8)
    tokens_k = f"{ctx_tokens // 1000}k" if ctx_tokens >= 1000 else str(ctx_tokens)
    max_k = format_max_tokens_k(ctx_max)
    ctx_badge = f"{C_BLUE}Ctx:{C_RESET} {ctx_bar} {C_BOLD}{ctx_percent}%{C_RESET} {C_DIM}({tokens_k}/{max_k}){C_RESET}"

    cs = C_GREEN if ps >= 50 else (C_YELLOW if ps >= 20 else C_RED)
    bar_s = make_linebar(fs, length=8)
    if ps >= 100 or not rs:
        str_sem = f"{C_YELLOW}Sem:{C_RESET} {bar_s} {cs}{C_BOLD}{ps}%{C_RESET}"
    else:
        cd_s = format_countdown(rs, default_val="7d 00h")
        str_sem = f"{C_YELLOW}Sem:{C_RESET} {bar_s} {cs}{C_BOLD}{ps}%{C_RESET} {C_DIM}({cd_s}){C_RESET}"

    sep = f" {C_GRAY}│{C_RESET} "
    parts = [acc_badge]
    if low_badge:
        parts.append(low_badge)
    if branch_badge:
        parts.append(branch_badge)
    parts.extend([model_badge, str_5h, ctx_badge, str_sem])

    print(sep.join(parts), flush=True)

    # 7. Sync metadata with Herdr pane top bar + single low-quota toast per cycle
    report_herdr_pane_metadata(
        account,
        plan_type,
        model_name,
        p5,
        ctx_percent,
        ps,
        allow_without_parent=has_stdin,
        low_quota=is_low_quota,
    )
    if is_low_quota and (has_stdin or find_parent_agy_pid() is not None or bool(os.environ.get("AGYC_TEST_HERDR_CMD"))):
        maybe_notify_low_quota(
            account,
            model_name,
            family,
            p5,
            ps,
            r5,
            rs,
            quota_initialized=quota_init,
            sock_path=sock_path,
            current_pane_id=pane_id,
        )


if __name__ == "__main__":
    if len(sys.argv) > 2 and sys.argv[1] == "--refresh-quota-bg":
        alias = sys.argv[2]
        os.environ["HOME"] = REAL_HOME
        os.environ["AGYC_REAL_HOME"] = REAL_HOME
        if IS_WINDOWS:
            os.environ["USERPROFILE"] = REAL_HOME
        do_fetch_and_save_quota(alias)
        sys.exit(0)
    main()
