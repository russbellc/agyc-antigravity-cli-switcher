import os
import re
import json
import time
import select
import subprocess
import urllib.request
import urllib.parse
import urllib.error
import base64
from datetime import datetime, timezone, timedelta

# ANSI Colors
C_RESET   = "\033[0m"
C_BOLD    = "\033[1m"
C_DIM     = "\033[2m"
C_GREEN   = "\033[38;5;48m"    # Bright green
C_CYAN    = "\033[38;5;51m"    # Electric cyan
C_BLUE    = "\033[38;5;75m"    # Soft blue
C_YELLOW  = "\033[38;5;220m"   # Gold/Yellow
C_ORANGE  = "\033[38;5;208m"   # Orange
C_RED     = "\033[38;5;196m"   # Bright red
C_MAGENTA = "\033[38;5;177m"   # Light purple/magenta
C_PURPLE  = "\033[38;5;147m"   # Soft lavender/purple for models
C_GRAY    = "\033[38;5;244m"   # Muted gray

# OAuth credentials for token refresh (same as in agyc)
GOOGLE_CLIENT_ID     = "moc.tnetnocresuelgoog.sppa.pe304g4hjolotv532ercl12h2nisshmt-1950606001701"[::-1]
GOOGLE_CLIENT_SECRET = "fADq6z4CXs8BLm1JLdL684RWF85K-XPSCOG"[::-1]

# Real home directory (not the agy-isolated one)
REAL_HOME = "/home/aidev"

def make_linebar(fraction: float, length: int = 8, fill_char: str = "█", empty_char: str = "░") -> str:
    """Generates a colored text progress linebar."""
    if fraction is None:
        fraction = 1.0
    fraction = max(0.0, min(1.0, float(fraction)))
    filled_len = int(round(fraction * length))
    empty_len = length - filled_len
    
    # Color coding based on fraction remaining
    if fraction >= 0.50:
        bar_color = C_GREEN
    elif fraction >= 0.20:
        bar_color = C_YELLOW
    else:
        bar_color = C_RED
        
    bar = f"{bar_color}{fill_char * filled_len}{C_GRAY}{empty_char * empty_len}{C_RESET}"
    return f"[{bar}]"

def make_context_linebar(fraction: float, length: int = 8, fill_char: str = "█", empty_char: str = "░") -> str:
    """Generates a colored text progress linebar for context usage (inverse color coding)."""
    if fraction is None:
        fraction = 0.0
    fraction = max(0.0, min(1.0, float(fraction)))
    filled_len = int(round(fraction * length))
    empty_len = length - filled_len
    
    # Inverted color coding: low usage is green, high usage is red
    if fraction < 0.50:
        bar_color = C_GREEN
    elif fraction < 0.75:
        bar_color = C_YELLOW
    elif fraction < 0.85:
        bar_color = C_ORANGE
    else:
        bar_color = C_RED
        
    bar = f"{bar_color}{fill_char * filled_len}{C_GRAY}{empty_char * empty_len}{C_RESET}"
    return f"[{bar}]"

def format_countdown(reset_iso: str | None) -> str:
    if not reset_iso:
        return "5h 00m"
    try:
        if reset_iso.endswith("Z"):
            reset_iso = reset_iso[:-1] + "+00:00"
        dt = datetime.fromisoformat(reset_iso)
        now = datetime.now(timezone.utc)
        diff = dt - now
        total_sec = int(diff.total_seconds())
        if total_sec <= 0:
            return "0m"
        hrs = total_sec // 3600
        mins = (total_sec % 3600) // 60
        if hrs >= 24:
            days = hrs // 24
            rem_hrs = hrs % 24
            return f"{days}d {rem_hrs:02d}h"
        if hrs > 0:
            return f"{hrs}h {mins:02d}m"
        return f"{mins}m"
    except Exception:
        return "5h"

def detect_active_account(stdin_data: dict | None = None) -> str:
    """Detect the active agyc account alias.
    
    When running inside agy, HOME=/home/aidev/.agyc_homes/agy02.
    We also check ANTIGRAVITY_APP_DATA_DIR which contains the alias,
    or match email from stdin payload.
    """
    # 0. Check email in stdin_data
    if stdin_data and stdin_data.get("email"):
        email = stdin_data.get("email", "").strip().lower()
        accounts_dir = f"{REAL_HOME}/.gemini/antigravity-cli/accounts"
        if os.path.isdir(accounts_dir):
            try:
                for fname in os.listdir(accounts_dir):
                    if fname.startswith("agy") and fname.endswith(".json"):
                        alias = fname[:-5]
                        try:
                            with open(os.path.join(accounts_dir, fname), "r") as af:
                                d = json.load(af)
                                if d.get("email", "").strip().lower() == email:
                                    return alias
                        except Exception:
                            pass
            except Exception:
                pass

    # 1. Check HOME path (e.g., /home/aidev/.agyc_homes/agy02)
    home = os.environ.get("HOME", "")
    m = re.search(r"agy\d+", home)
    if m:
        return m.group(0)
    
    # 2. Check ANTIGRAVITY_APP_DATA_DIR (e.g., /home/aidev/.agyc_homes/agy02/.gemini/...)
    app_dir = os.environ.get("ANTIGRAVITY_APP_DATA_DIR", "")
    m = re.search(r"agy\d+", app_dir)
    if m:
        return m.group(0)
        
    # 3. Check config.json in REAL_HOME accounts (not the isolated home)
    config_paths = [
        f"{REAL_HOME}/.gemini/antigravity-cli/accounts/config.json",
        "/home/aidev/.gemini/antigravity-cli/accounts/config.json",
        "/home/aidev/snap/antigravity-cli/common/.gemini/antigravity-cli/accounts/config.json",
    ]
    for cp in config_paths:
        if os.path.exists(cp):
            try:
                with open(cp, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    act = data.get("active_account")
                    if act:
                        return act
            except Exception:
                pass
    return "agy01"

def get_git_branch() -> str | None:
    try:
        # Check current branch
        res = subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=0.2
        )
        if res.returncode == 0:
            branch = res.stdout.strip()
            # Check if dirty (quick)
            status_res = subprocess.run(
                ["git", "status", "--porcelain", "-uno"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=0.2
            )
            is_dirty = bool(status_res.stdout.strip())
            return f"{branch}*" if is_dirty else branch
    except Exception:
        pass
    return None

def get_account_file_path(alias: str) -> str | None:
    """Returns the path to the account JSON file, searching REAL_HOME first."""
    acc_paths = [
        f"{REAL_HOME}/.gemini/antigravity-cli/accounts/{alias}.json",
        f"/home/aidev/.gemini/antigravity-cli/accounts/{alias}.json",
        f"/home/aidev/snap/antigravity-cli/common/.gemini/antigravity-cli/accounts/{alias}.json",
    ]
    for ap in acc_paths:
        if os.path.exists(ap):
            return ap
    return None

def refresh_token_if_needed(token_data: dict) -> tuple[dict, bool]:
    """Refresh OAuth access token if expired or expiring within 5 minutes."""
    token_obj = token_data.get("token", {})
    refresh_token = token_obj.get("refresh_token")
    expiry_str = token_obj.get("expiry")
    needs_refresh = False

    if not token_obj.get("access_token") or not expiry_str:
        needs_refresh = True
    else:
        try:
            if expiry_str.endswith("Z"):
                expiry_str_fixed = expiry_str[:-1] + "+00:00"
            else:
                expiry_str_fixed = expiry_str
            exp_dt = datetime.fromisoformat(expiry_str_fixed)
            if (exp_dt - datetime.now(timezone.utc)).total_seconds() < 300:
                needs_refresh = True
        except Exception:
            needs_refresh = True

    if not needs_refresh:
        return token_data, False

    if not refresh_token:
        return token_data, False

    payload = urllib.parse.urlencode({
        "client_id": GOOGLE_CLIENT_ID,
        "client_secret": GOOGLE_CLIENT_SECRET,
        "grant_type": "refresh_token",
        "refresh_token": refresh_token,
    }).encode("utf-8")

    req = urllib.request.Request(
        "https://oauth2.googleapis.com/token",
        data=payload,
        headers={"Content-Type": "application/x-www-form-urlencoded"}
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            res = json.loads(resp.read().decode("utf-8"))
        token_obj["access_token"] = res["access_token"]
        if "refresh_token" in res:
            token_obj["refresh_token"] = res["refresh_token"]
        expires_in = res.get("expires_in", 3600)
        token_obj["expiry"] = (datetime.now(timezone.utc) + timedelta(seconds=expires_in)).isoformat()
        token_data["token"] = token_obj
        return token_data, True
    except Exception:
        return token_data, False

def do_fetch_and_save_quota(alias: str) -> dict | None:
    """Synchronously queries Google CloudCode PA API and saves cache.
    
    IMPORTANT: Account file is always read from REAL_HOME (/home/aidev),
    not from the agy-isolated home, because that's where agyc stores tokens.
    """
    cache_file = f"/tmp/agyc_quota_cache_{alias}.json"
    now_ts = time.time()
    
    acc_path = get_account_file_path(alias)
    if not acc_path:
        return None

    try:
        with open(acc_path, "r") as f:
            acc_data = json.load(f)
    except Exception:
        return None
                
    if not acc_data:
        return None

    fallback_quota = acc_data.get("quota", {})
    token_data = acc_data.get("token_data", {})
    
    # Refresh token if needed before calling API
    token_data, refreshed = refresh_token_if_needed(token_data)
    if refreshed:
        # Persist the refreshed token back to the file
        try:
            acc_data["token_data"] = token_data
            with open(acc_path, "w") as f:
                json.dump(acc_data, f, indent=2)
        except Exception:
            pass
    
    token = token_data.get("token", {}).get("access_token")
    fallback_res = {
        "gemini_5h_fraction": fallback_quota.get("gemini_5h_fraction", 1.0),
        "gemini_5h_reset": fallback_quota.get("gemini_5h_reset"),
        "gemini_weekly_fraction": fallback_quota.get("gemini_weekly_fraction", 1.0),
        "gemini_weekly_reset": fallback_quota.get("gemini_weekly_reset"),
        "claude_5h_fraction": fallback_quota.get("claude_5h_fraction", 1.0),
        "claude_5h_reset": fallback_quota.get("claude_5h_reset"),
        "claude_weekly_fraction": fallback_quota.get("claude_weekly_fraction", 1.0),
        "claude_weekly_reset": fallback_quota.get("claude_weekly_reset"),
        "claude_disabled": False,
        "argon_weekly_fraction": fallback_quota.get("argon_weekly_fraction"),
        "argon_weekly_reset": fallback_quota.get("argon_weekly_reset"),
        "has_gemini4": fallback_quota.get("has_gemini4", False),
        "cached_at": now_ts
    }

    if not token:
        if fallback_quota:
            try:
                with open(cache_file, "w") as f:
                    json.dump(fallback_res, f)
            except Exception:
                pass
            return fallback_res
        return None

    metrics = {
        "gemini_5h_fraction": 1.0,
        "gemini_5h_reset": None,
        "gemini_weekly_fraction": 1.0,
        "gemini_weekly_reset": None,
        "claude_5h_fraction": 1.0,
        "claude_5h_reset": None,
        "claude_weekly_fraction": 1.0,
        "claude_weekly_reset": None,
        "claude_disabled": False,
        "argon_weekly_fraction": None,
        "argon_weekly_reset": None,
        "has_gemini4": False,
        "cached_at": now_ts
    }

    # 1. Fetch live per-model quota from retrieveUserQuota (daily first, then prod)
    models_data = None
    for host in ["daily-cloudcode-pa.googleapis.com", "cloudcode-pa.googleapis.com"]:
        try:
            url = f"https://{host}/v1internal:retrieveUserQuota"
            req = urllib.request.Request(
                url,
                data=b"{}",
                headers={
                    "Authorization": f"Bearer {token}",
                    "Content-Type": "application/json",
                    "User-Agent": "antigravity/1.4.0 linux/amd64"
                }
            )
            with urllib.request.urlopen(req, timeout=6) as resp:
                models_data = json.loads(resp.read().decode("utf-8"))
            break
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                break
            continue
        except Exception:
            continue

    if models_data and "buckets" in models_data:
        for b in models_data.get("buckets", []):
            mid = b.get("modelId", "").lower()
            frac = b.get("remainingFraction", 1.0)
            rst = b.get("resetTime")
            if "gemini-3.8" in mid or "gemini-2.5-flash" in mid:
                metrics["gemini_5h_fraction"] = frac
                metrics["gemini_5h_reset"] = rst
            elif "claude-sonnet" in mid or "claude-opus" in mid:
                metrics["claude_5h_fraction"] = frac
                metrics["claude_5h_reset"] = rst
                if frac == 0:
                    metrics["claude_disabled"] = True
            elif "argon" in mid or "gemini-4" in mid:
                metrics["argon_weekly_fraction"] = frac
                metrics["argon_weekly_reset"] = rst
                metrics["has_gemini4"] = True

    # 2. Fetch weekly group quota from retrieveUserQuotaSummary (merge groups from daily & prod)
    summary_data = {"groups": []}
    for host in ["daily-cloudcode-pa.googleapis.com", "cloudcode-pa.googleapis.com"]:
        try:
            url = f"https://{host}/v1internal:retrieveUserQuotaSummary"
            req = urllib.request.Request(
                url,
                data=b"{}",
                headers={
                    "Authorization": f"Bearer {token}",
                    "Content-Type": "application/json",
                    "User-Agent": "antigravity/1.4.0 linux/amd64"
                }
            )
            with urllib.request.urlopen(req, timeout=6) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                for g in data.get("groups", []):
                    gn = g.get("displayName", "")
                    if not any(x.get("displayName") == gn for x in summary_data["groups"]):
                        summary_data["groups"].append(g)
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                break
            continue
        except Exception:
            continue

    if summary_data and "groups" in summary_data:
        for grp in summary_data.get("groups", []):
            gn = grp.get("displayName", "").lower()
            for b in grp.get("buckets", []):
                bid = b.get("bucketId", "").lower()
                frac = b.get("remainingFraction", 1.0)
                rst = b.get("resetTime")
                if "gemini" in gn and "weekly" in bid:
                    metrics["gemini_weekly_fraction"] = frac
                    metrics["gemini_weekly_reset"] = rst
                elif any(k in gn for k in ("claude", "gpt", "3p")) and "weekly" in bid:
                    metrics["claude_weekly_fraction"] = frac
                    metrics["claude_weekly_reset"] = rst
                    if frac == 0 or b.get("disabled", False):
                        metrics["claude_disabled"] = True
                elif "argon" in bid or "argon" in gn:
                    metrics["argon_weekly_fraction"] = frac
                    metrics["argon_weekly_reset"] = rst
                    metrics["has_gemini4"] = True

    # Consistency rule: if weekly Claude is 0 or disabled, 5H is locked to 0
    if (metrics.get("claude_weekly_fraction") is not None and metrics["claude_weekly_fraction"] <= 0.001) or metrics.get("claude_disabled"):
        metrics["claude_5h_fraction"] = 0.0
        metrics["claude_disabled"] = True

    if models_data or summary_data:
        try:
            tmp_cache = cache_file + ".tmp"
            with open(tmp_cache, "w") as f:
                json.dump(metrics, f)
            os.replace(tmp_cache, cache_file)
            # Persist to accounts JSON so future fallback is also accurate
            acc_data["quota"] = metrics
            tmp_acc = acc_path + ".tmp"
            with open(tmp_acc, "w") as f:
                json.dump(acc_data, f, indent=2)
            os.replace(tmp_acc, acc_path)
        except Exception:
            pass
        return metrics

    # All endpoints failed - return existing disk cache if present, else fallback without poisoning
    if os.path.exists(cache_file):
        try:
            with open(cache_file, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return fallback_res if fallback_quota else None

def extract_quota_from_stdin(stdin_quota: dict, account: str) -> dict:
    """Parses real-time quota payload delivered directly by agy CLI on stdin.
    
    This matches agy /usage exactly, updating both disk cache and account JSON.
    """
    now_ts = time.time()
    g5 = stdin_quota.get("gemini-5h") or {}
    gw = stdin_quota.get("gemini-weekly") or {}
    c5 = stdin_quota.get("3p-5h") or stdin_quota.get("claude-5h") or {}
    cw = stdin_quota.get("3p-weekly") or stdin_quota.get("claude-weekly") or {}
    ar = stdin_quota.get("argon-weekly") or stdin_quota.get("gemini-4-weekly") or {}

    c_dis = bool(
        c5.get("disabled") or 
        cw.get("disabled") or 
        (cw.get("remaining_fraction") is not None and float(cw.get("remaining_fraction")) <= 0.001)
    )
    c5_frac = 0.0 if c_dis else float(c5.get("remaining_fraction", 1.0))
    cw_frac = float(cw.get("remaining_fraction", 0.0)) if "remaining_fraction" in cw else 0.0

    metrics = {
        "gemini_5h_fraction": float(g5.get("remaining_fraction", 1.0)) if "remaining_fraction" in g5 else 1.0,
        "gemini_5h_reset": g5.get("reset_time"),
        "gemini_weekly_fraction": float(gw.get("remaining_fraction", 1.0)) if "remaining_fraction" in gw else 1.0,
        "gemini_weekly_reset": gw.get("reset_time"),
        "claude_5h_fraction": c5_frac,
        "claude_5h_reset": c5.get("reset_time") or cw.get("reset_time"),
        "claude_weekly_fraction": cw_frac,
        "claude_weekly_reset": cw.get("reset_time"),
        "claude_disabled": c_dis,
        "argon_weekly_fraction": float(ar.get("remaining_fraction")) if "remaining_fraction" in ar else None,
        "argon_weekly_reset": ar.get("reset_time"),
        "has_gemini4": ("remaining_fraction" in ar and ar.get("remaining_fraction") is not None),
        "cached_at": now_ts,
    }

    # Persist live metrics to disk cache so agyc CLI / list commands stay 100% in sync
    try:
        cache_file = f"/tmp/agyc_quota_cache_{account}.json"
        tmp_cache = cache_file + ".tmp"
        with open(tmp_cache, "w") as f:
            json.dump(metrics, f)
        os.replace(tmp_cache, cache_file)

        acc_path = get_account_file_path(account)
        if acc_path and os.path.exists(acc_path):
            with open(acc_path, "r") as f:
                acc_data = json.load(f)
            acc_data["quota"] = metrics
            tmp_acc = acc_path + ".tmp"
            with open(tmp_acc, "w") as f:
                json.dump(acc_data, f, indent=2)
            os.replace(tmp_acc, acc_path)
    except Exception:
        pass

    return metrics

def spawn_background_refresh(alias: str):
    """Spawns background refresh throttled by lock file (max 1 refresh per 30s)."""
    lock_file = f"/tmp/agyc_quota_refreshing_{alias}.lock"
    now_ts = time.time()
    if os.path.exists(lock_file):
        try:
            with open(lock_file, "r") as f:
                lock_ts = float(f.read().strip())
            if now_ts - lock_ts < 30:
                return  # Another refresh was already spawned in the last 30s
        except Exception:
            pass

    try:
        with open(lock_file, "w") as f:
            f.write(str(now_ts))
    except Exception:
        pass

    try:
        env = os.environ.copy()
        env["HOME"] = REAL_HOME
        subprocess.Popen(
            [sys.executable, __file__, "--refresh-quota-bg", alias],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            env=env
        )
    except Exception:
        pass

def fetch_online_quota(alias: str) -> dict | None:
    """Non-blocking quota fetcher. NEVER executes network calls in the foreground!
    
    1. If cache exists and is fresh (< 60s): return cache immediately.
    2. If cache exists and is stale (>= 60s): return cache immediately + spawn background refresh.
    3. If cache does not exist: read accounts/{alias}.json fallback + spawn background refresh.
    Execution time is always < 5ms.
    """
    cache_file = f"/tmp/agyc_quota_cache_{alias}.json"
    now_ts = time.time()
    cached = None
    
    if os.path.exists(cache_file):
        try:
            with open(cache_file, "r") as f:
                cached = json.load(f)
        except Exception:
            pass

    if cached:
        cache_age = now_ts - cached.get("cached_at", 0)
        if cache_age >= 60:
            spawn_background_refresh(alias)
        return cached

    # If no cache exists, read from account JSON as immediate fallback and spawn background
    spawn_background_refresh(alias)
    acc_path = get_account_file_path(alias)
    if acc_path and os.path.exists(acc_path):
        try:
            with open(acc_path, "r") as f:
                acc_data = json.load(f)
                q = acc_data.get("quota")
                if q:
                    return q
        except Exception:
            pass

    return None

def get_model_and_effort(stdin_data: dict | None, account: str) -> str:
    """Detects active model name and reasoning effort level."""
    model_name = None
    effort = None

    # 1. From stdin_data (if agy provides structured status payload)
    if stdin_data:
        m = stdin_data.get("model")
        if isinstance(m, dict):
            model_name = m.get("display_name") or m.get("name") or m.get("id")
            effort = m.get("effort") or stdin_data.get("effort")
        elif isinstance(m, str):
            model_name = m
        if not effort and "effort" in stdin_data:
            effort = stdin_data.get("effort")

    # 2. Check parent process cmdline for --model or --effort
    if not model_name or not effort:
        try:
            pid = os.getppid()
            for _ in range(4):
                if pid <= 1:
                    break
                cmd_file = f"/proc/{pid}/cmdline"
                if os.path.exists(cmd_file):
                    with open(cmd_file, "rb") as f:
                        parts = f.read().decode("utf-8", errors="ignore").split("\x00")
                    for i, arg in enumerate(parts):
                        if arg == "--model" and i + 1 < len(parts) and not model_name:
                            model_name = parts[i + 1]
                        elif arg == "--effort" and i + 1 < len(parts) and not effort:
                            effort = parts[i + 1]
                with open(f"/proc/{pid}/status") as sf:
                    for line in sf:
                        if line.startswith("PPid:"):
                            pid = int(line.split()[1])
                            break
        except Exception:
            pass

    # 3. Check settings.json
    if not model_name:
        # ANTIGRAVITY_APP_DATA_DIR is set correctly even inside agy
        app_data = os.environ.get("ANTIGRAVITY_APP_DATA_DIR", "")
        candidate_paths = [
            os.path.join(app_data, "settings.json") if app_data else "",
            f"{REAL_HOME}/.agyc_homes/{account}/.gemini/antigravity-cli/settings.json",
            f"/home/aidev/.agyc_homes/{account}/.gemini/antigravity-cli/settings.json",
            f"{REAL_HOME}/.gemini/antigravity-cli/settings.json",
        ]
        for cp in candidate_paths:
            if cp and os.path.exists(cp):
                try:
                    with open(cp, "r", encoding="utf-8") as f:
                        s = json.load(f)
                        raw_model = s.get("model")
                        if raw_model:
                            model_name = raw_model
                        if not effort and s.get("effort"):
                            effort = s.get("effort")
                        if model_name:
                            break
                except Exception:
                    pass

    if not model_name:
        model_name = "Gemini 3.8 Flash (High)"

    # Extract effort if embedded in parentheses like "Gemini 3.8 Flash (High)"
    match = re.match(r"^(.*?)(?:\s*\((.*?)\))?$", model_name)
    if match:
        clean_name = match.group(1).strip()
        embedded_effort = match.group(2)
        if embedded_effort and not effort:
            effort = embedded_effort
        model_name = clean_name

    if not effort:
        effort = "high"

    effort_lower = effort.lower()
    if effort_lower in ("high", "h"):
        effort_color = C_YELLOW
    elif effort_lower in ("max", "ultra"):
        effort_color = C_RED
    elif effort_lower in ("medium", "med", "m"):
        effort_color = C_BLUE
    else:
        effort_color = C_DIM

    badge = f"{C_PURPLE}🤖 {model_name}{C_RESET} {effort_color}({effort_lower}){C_RESET}"
    return badge, model_name, effort_lower

def get_quota_for_model(quota: dict | None, model_name: str) -> tuple[float, str | None, float | None, str | None, str]:
    """Returns (frac_5h, reset_5h, frac_sem, reset_sem, label) based on active model family."""
    if not quota:
        return 1.0, None, 1.0, None, "5H"

    m = (model_name or "").lower()
    
    # 1. Claude & GPT Models
    if any(k in m for k in ("claude", "gpt", "sonnet", "opus", "haiku")):
        frac_5h = quota.get("claude_5h_fraction")
        if frac_5h is None:
            frac_5h = 1.0
        reset_5h = quota.get("claude_5h_reset")
        frac_sem = quota.get("claude_weekly_fraction", 1.0)
        reset_sem = quota.get("claude_weekly_reset")
        is_disabled = quota.get("claude_disabled", False)
        
        # If weekly limit is 0 or disabled, 5H is locked to 0
        if (frac_sem is not None and frac_sem <= 0.001) or is_disabled:
            reset_5h = reset_sem or reset_5h
            frac_5h = 0.0
            frac_sem = 0.0
            return frac_5h, reset_5h, frac_sem, reset_sem, "Claude"
        return frac_5h, reset_5h, frac_sem, reset_sem, "Claude"

    # 2. Gemini 4 Argon Models
    elif "argon" in m:
        frac_sem = quota.get("argon_weekly_fraction")
        if frac_sem is None:
            frac_sem = quota.get("gemini_weekly_fraction", 1.0)
        reset_sem = quota.get("argon_weekly_reset") or quota.get("gemini_weekly_reset")
        frac_5h = quota.get("gemini_5h_fraction", 1.0)
        reset_5h = quota.get("gemini_5h_reset")
        if frac_sem is not None and frac_sem <= 0.001:
            frac_5h = 0.0
            frac_sem = 0.0
        return frac_5h, reset_5h, frac_sem, reset_sem, "Argon"

    # 3. Standard Gemini Models (Flash, Pro)
    else:
        frac_sem = quota.get("gemini_weekly_fraction", 1.0)
        reset_sem = quota.get("gemini_weekly_reset")
        is_disabled = quota.get("gemini_disabled", False)
        if (frac_sem is not None and frac_sem <= 0.001) or is_disabled:
            reset_5h = reset_sem or quota.get("gemini_5h_reset")
            return 0.0, reset_5h, 0.0, reset_sem, "5H"
        frac_5h = quota.get("gemini_5h_fraction", 1.0)
        reset_5h = quota.get("gemini_5h_reset")
        return frac_5h, reset_5h, frac_sem, reset_sem, "5H"

def find_parent_agy_pid() -> int | None:
    """Climbs the process tree to find the parent agy CLI process (max 8 hops)."""
    try:
        pid = os.getppid()
        for _ in range(8):
            if pid <= 1:
                break
            cmd_file = f"/proc/{pid}/cmdline"
            if os.path.exists(cmd_file):
                try:
                    with open(cmd_file, "rb") as f:
                        cmd = f.read().decode("utf-8", errors="ignore")
                        if "agy" in cmd and "statusline" not in cmd:
                            return pid
                except Exception:
                    pass
            status_file = f"/proc/{pid}/status"
            if not os.path.exists(status_file):
                break
            ppid = None
            with open(status_file, "r") as sf:
                for line in sf:
                    if line.startswith("PPid:"):
                        ppid = int(line.split()[1])
                        break
            if not ppid or ppid == pid:
                break
            pid = ppid
    except Exception:
        pass
    return None

def get_session_conv_id() -> str | None:
    """Detects conversation ID specific to THIS terminal instance of agy."""
    # 1. From environment variable (if passed by agy / subagents)
    env_conv = os.environ.get("ANTIGRAVITY_CONVERSATION_ID")
    if env_conv:
        return env_conv

    # 2. From the calling agy process open file descriptors
    agy_pid = find_parent_agy_pid()
    if not agy_pid:
        return None
    
    fd_dir = f"/proc/{agy_pid}/fd"
    if not os.path.isdir(fd_dir):
        return None

    try:
        for fd in os.listdir(fd_dir):
            try:
                target = os.readlink(os.path.join(fd_dir, fd))
                m = re.search(r"conversations/([a-f0-9\-]{36})\.db", target)
                if m:
                    return m.group(1)
            except Exception:
                pass
    except Exception:
        pass
    return None

def find_active_transcript(conv_id: str | None = None) -> str | None:
    """Finds the conversation transcript file for THIS specific terminal session."""
    if not conv_id:
        conv_id = get_session_conv_id()

    # If this specific terminal session has no active conversation yet, it is a brand new session!
    if not conv_id:
        return None

    candidate_bases = [
        os.environ.get("ANTIGRAVITY_APP_DATA_DIR"),
        os.path.expanduser("~/.gemini/antigravity-cli"),
        f"{REAL_HOME}/.gemini/antigravity-cli",
        f"{REAL_HOME}/.agyc_homes/agy01/.gemini/antigravity-cli",
        f"{REAL_HOME}/.agyc_homes/agy02/.gemini/antigravity-cli",
        f"{REAL_HOME}/.agyc_homes/agy03/.gemini/antigravity-cli",
    ]
    
    for base in candidate_bases:
        if not base or not os.path.isdir(base):
            continue
        log_dir = os.path.join(base, "brain", conv_id, ".system_generated", "logs")
        for fname in ("transcript.jsonl", "transcript_full.jsonl"):
            cand = os.path.join(log_dir, fname)
            if os.path.isfile(cand):
                return cand

    return None

def get_context_usage(stdin_data: dict | None, model_name: str = "") -> tuple[float, int, int]:
    """Returns (fraction, estimated_tokens, max_tokens).
    
    Adapts max_tokens based on active model:
    - Claude / GPT models: 200,000 tokens
    - Gemini models: 1,000,000 tokens
    """
    m = (model_name or "").lower()
    if any(k in m for k in ("claude", "gpt", "sonnet", "opus", "haiku")):
        max_tokens = 200_000
    else:
        max_tokens = 1_000_000
    
    # 1. Parse structured context_window from stdin_data
    if stdin_data:
        try:
            ctx = stdin_data.get("context_window", {}) or stdin_data.get("context", {})
            if ctx:
                max_t = ctx.get("context_window_size") or ctx.get("max_tokens") or max_tokens
                used_pct = ctx.get("used_percentage")
                used = (
                    ctx.get("total_input_tokens") or 
                    ctx.get("used_tokens") or 
                    ctx.get("total_tokens")
                )
                if used is not None and max_t:
                    frac = min(1.0, float(used) / float(max_t))
                    return (frac, int(used), int(max_t))
                elif used_pct is not None and max_t:
                    frac = min(1.0, float(used_pct) / 100.0)
                    used_t = int(round(frac * max_t))
                    return (frac, used_t, int(max_t))
        except Exception:
            pass

    # 2. Fallback: Parse active transcript file
    conv_id = None
    if stdin_data:
        conv_id = stdin_data.get("conversation_id") or stdin_data.get("session_id")
    if not conv_id:
        conv_id = os.environ.get("ANTIGRAVITY_CONVERSATION_ID")

    transcript_path = None
    if stdin_data and stdin_data.get("transcript_path"):
        tp = stdin_data.get("transcript_path")
        if os.path.exists(tp):
            transcript_path = tp

    if not transcript_path:
        transcript_path = find_active_transcript(conv_id)

    if transcript_path and os.path.exists(transcript_path):
        size_bytes = os.path.getsize(transcript_path)
        # Approximate ~4 bytes per token for typical JSON transcript content
        estimated_tokens = int(size_bytes / 4.0)
        fraction = min(1.0, estimated_tokens / float(max_tokens))
        return (fraction, estimated_tokens, max_tokens)

    return (0.0, 0, max_tokens)

def main():
    # Read stdin non-blocking with select timeout up to 40ms without waiting for EOF
    stdin_data = None
    try:
        if not sys.stdin.isatty():
            r, _, _ = select.select([sys.stdin], [], [], 0.04)
            if r:
                os.set_blocking(sys.stdin.fileno(), False)
                raw = sys.stdin.read()
                if raw and raw.strip().startswith("{"):
                    stdin_data = json.loads(raw)
    except Exception:
        pass

    # 1. Active Account
    account = detect_active_account(stdin_data)
    acc_badge = f"{C_BOLD}{C_CYAN}⚡ {account}{C_RESET}"

    # 2. Git Branch
    branch = get_git_branch()
    branch_badge = f"{C_BOLD}{C_GREEN}🌿 {branch}{C_RESET}" if branch else None

    # 3. Model & Effort (placed before 5h quota)
    model_badge, model_name, effort = get_model_and_effort(stdin_data, account)

    # 4. Quota (live from stdin_data if present, else cached / online API)
    stdin_quota = stdin_data.get("quota") if stdin_data else None
    if stdin_quota:
        quota = extract_quota_from_stdin(stdin_quota, account)
    else:
        quota = fetch_online_quota(account)
    f5, r5, fs, rs, q_label = get_quota_for_model(quota, model_name)

    # 5. Context Usage (adjusted for model max context window)
    ctx_frac, ctx_tokens, ctx_max = get_context_usage(stdin_data, model_name)
    ctx_percent = int(round(ctx_frac * 100))
    ctx_bar = make_context_linebar(ctx_frac, length=8)
    tokens_k = f"{ctx_tokens // 1000}k" if ctx_tokens >= 1000 else str(ctx_tokens)
    max_k = f"{ctx_max // 1_000_000}M" if ctx_max >= 1_000_000 else f"{ctx_max // 1000}k"
    ctx_badge = f"{C_BLUE}Ctx:{C_RESET} {ctx_bar} {C_BOLD}{ctx_percent}%{C_RESET} {C_DIM}({tokens_k}/{max_k}){C_RESET}"

    # Separator
    sep = f" {C_GRAY}│{C_RESET} "
    
    # Build complete statusline
    parts = [acc_badge]
    if branch_badge:
        parts.append(branch_badge)
    parts.append(model_badge)

    if q_label.startswith("Argon: No cuenta"):
        parts.append(f"{C_YELLOW}Argon:{C_RESET} {C_DIM}[────────] No cuenta{C_RESET}")
    else:
        p5 = int(round(f5 * 100))
        c5 = C_GREEN if p5 >= 50 else (C_YELLOW if p5 >= 20 else C_RED)
        bar_5 = make_linebar(f5, length=8)
        if p5 >= 100:
            str_5h = f"{C_YELLOW}5H:{C_RESET} {bar_5} {c5}{C_BOLD}100%{C_RESET}"
        else:
            str_5h = f"{C_YELLOW}5H:{C_RESET} {bar_5} {c5}{C_BOLD}{p5}%{C_RESET} {C_DIM}(⏳ {format_countdown(r5)}){C_RESET}"
        parts.append(str_5h)

        if fs is not None:
            ps = int(round(fs * 100))
            bar_s = make_linebar(fs, length=8)
            cd_s = format_countdown(rs)
            cs = C_GREEN if ps >= 50 else (C_YELLOW if ps >= 20 else C_RED)
            if ps >= 100:
                str_sem = f"{C_YELLOW}Sem:{C_RESET} {bar_s} {cs}{C_BOLD}{ps}%{C_RESET}"
            else:
                str_sem = f"{C_YELLOW}Sem:{C_RESET} {bar_s} {cs}{C_BOLD}{ps}%{C_RESET} {C_DIM}({cd_s}){C_RESET}"
            parts.append(str_sem)

    parts.append(ctx_badge)

    line = sep.join(parts)
    print(line)

if __name__ == "__main__":
    if len(sys.argv) > 2 and sys.argv[1] == "--refresh-quota-bg":
        alias = sys.argv[2]
        # When running in background, ensure HOME points to real home for token lookup
        os.environ["HOME"] = REAL_HOME
        do_fetch_and_save_quota(alias)
        sys.exit(0)
    main()
