#!/usr/bin/env python3
"""
agyc-statusline: Custom Status Line Generator for Antigravity CLI (agy).
Renders:
  - Active agyc profile (agy01, agy02, agy03)
  - Current git branch (with clean/dirty indicator)
  - 5-Hour Gemini Quota (Online live remaining fraction, linebar, countdown to reset)
  - Session Context Consumption (% used, linebar, token estimate)
"""

